---
// src/views/Products/Detail/index.astro
import { t } from '../../../i18n/i18n';
import type { Locale } from '../../../i18n/i18n';
import { getLocale } from '../../../i18n/i18n';
import './styles.css';
import Breadcrumb from '../../../components/common/Breadcrumb/Breadcrumb.astro';
import LazyImage from '../../../components/common/LazyImage.astro';
import DeliveryAppsCarousel from '../../../components/common/DeliveryAppsCarousel.astro';
import { getAllBrands } from '../../../services/api/brands';
import { getAllProducts, getProductBySlug } from '../../../services/api/products';
import type { Product as CMSProduct } from '../../../services/api/types';

const { productId, product } = Astro.props;
const currentLang = getLocale();

// Obtener producto del CMS
let currentProduct: CMSProduct | null = null;

if (product && typeof product === 'object') {
  currentProduct = product as CMSProduct;
}

if (!currentProduct && productId) {
  currentProduct = await getProductBySlug(productId, currentLang);
}

const allProducts = await getAllProducts(currentLang);
const allBrands = await getAllBrands(currentLang);
const brandMap = new Map(allBrands.map((b) => [b.id, b]));

if (!currentProduct && productId) {
  currentProduct = allProducts.find(p => p.id === productId || p.slug === productId) || null;
}

if (!currentProduct) {
  throw new Error(`Producto no encontrado: ${productId}`);
}

// Normalización de títulos y textos
function normalizeTitle(input: string): string {
  if (!input) return '';
  let text = input.normalize('NFC');
  text = text
    .replace(/Ã¡/g, 'á')
    .replace(/Ã©/g, 'é')
    .replace(/Ã­/g, 'í')
    .replace(/Ã³/g, 'ó')
    .replace(/Ãº/g, 'ú')
    .replace(/Ã/g, 'Á')
    .replace(/Ã‰/g, 'É')
    .replace(/Ã/g, 'Í')
    .replace(/Ã"/g, 'Ó')
    .replace(/Ãš/g, 'Ú')
    .replace(/Ã±/g, 'ñ')
    .replace(/Ã'/g, 'Ñ')
    .replace(/Â/g, '')
    .replace(/manÃ/g, 'maní')
    .replace(/japonÃ©s/g, 'japonés')
    .replace(/PlÃ¡tano/g, 'Plátano')
    .replace(/MaÃ­z/g, 'Maíz')
    .replace(/PÃ¡caros/g, 'Pícaros')
    .replace(/PÃ­caros/g, 'Pícaros')
    .replace(/JalapeÃ±o/g, 'Jalapeño')
    .replace(/ChicharrÃ³n/g, 'Chicharrón')
    .replace(/FusiÃ³n/g, 'Fusión')
    .replace(/ClÃ¡sicas/g, 'Clásicas')
    .replace(/Ã³n/g, 'ón');
  return text.replace(/[\u00A0\u200B\u200C\u200D]/g, ' ').trim().normalize('NFC');
}

function tr(es: string, en: string): string {
  return normalizeTitle(currentLang === 'es' ? es : en);
}

const productTitle = normalizeTitle(currentProduct.title || currentProduct.name);
const productImage = currentProduct.image || 'https://snack.yummiespromociones.com/SnacksyummiesAssets/placeholder.webp';

// Marca asociada
const currentBrand = currentProduct.brandId ? brandMap.get(currentProduct.brandId) : null;
const brandName = currentBrand ? currentBrand.name : (currentProduct.brandName || '');

// Presentaciones obtenidas del CMS
const presentations: Array<{ label: string; image?: string }> = [];
if (currentProduct.sizes && currentProduct.sizes.length > 0) {
  currentProduct.sizes.forEach(s => {
    presentations.push({ label: `${s.value} g`, image: s.image });
  });
} else if (currentProduct.weight && currentProduct.weight.length > 0) {
  currentProduct.weight.forEach(w => {
    presentations.push({ label: w });
  });
} else {
  presentations.push({ label: '140 g' }, { label: '70 g' });
}

// Información Nutricional
const nutritionData = currentProduct.nutrition;
const hasCmsNutritionRows = nutritionData?.rows && Array.isArray(nutritionData.rows) && nutritionData.rows.length > 0;

const fallbackNutrition = {
  servingsPerContainer: currentLang === 'es' ? '8 Porciones Por Envase' : '8 Servings Per Container',
  servingSizeLabel: currentLang === 'es' ? 'Tamaño de la Porción' : 'Serving Size',
  servingSizeValue: currentLang === 'es' ? 'Aproximadamente 15 Chips (38g)' : 'About 15 Chips (38g)',
  amountPerServing: currentLang === 'es' ? 'Cantidad Por Porción' : 'Amount Per Serving',
  caloriesLabel: currentLang === 'es' ? 'Calorías' : 'Calories',
  caloriesValue: 160,
  dailyValueLabel: currentLang === 'es' ? 'Valor Diario' : 'Daily Value',
  totalFatLabel: currentLang === 'es' ? 'Grasa Total' : 'Total Fat',
  totalFatValue: '10 g',
  totalFatDaily: '13%',
  saturatedFatLabel: currentLang === 'es' ? 'Grasa Saturada' : 'Saturated Fat',
  saturatedFatValue: '1.5 g',
  saturatedFatDaily: '7%',
  transFatLabel: currentLang === 'es' ? 'Grasa Trans' : 'Trans Fat',
  transFatValue: '0 g',
  transFatDaily: '0%',
  cholesterolLabel: currentLang === 'es' ? 'Colesterol' : 'Cholesterol',
  cholesterolValue: '0 mg',
  cholesterolDaily: '0%'
};

// Textos estáticos
const texts = {
  description: tr('Descripción', 'Description'),
  ingredients: tr('Ingredientes', 'Ingredients'),
  nutritionalInfo: tr('Información Nutricional', 'Nutritional Information'),
  sizes: tr('Presentaciones', 'Sizes'),
  relatedProducts: tr('Productos Relacionados', 'Related Products'),
  availableIn: tr('Disponible en', 'Available in'),
  backToProducts: tr('Volver a Productos', 'Back to Products'),
  presentation: tr('Presentación:', 'Presentation:'),
  presentationNote: tr('Tamaño de presentación varía de acuerdo al país', 'Presentation size varies by country')
};

// Productos relacionados de la misma marca
let relatedProducts = allProducts
  .filter(p => p.id !== currentProduct?.id && (p.brandId === currentProduct?.brandId || (brandName && p.brandName === brandName)))
  .slice(0, 6);

if (relatedProducts.length === 0) {
  relatedProducts = allProducts.filter(p => p.id !== currentProduct?.id).slice(0, 6);
}


---
<div class="w-full">
  <!-- Hero Banner con fondo primary -->
  <div class="bg-white py-2">
    <!-- Breadcrumbs -->
    <div class="container mx-auto px-4">
      <Breadcrumb 
        items={[
          { label: 'Home', href: `/${currentLang}` },
          { label: currentLang === 'es' ? 'Productos' : 'Products', href: `/${currentLang}/${currentLang === 'es' ? 'productos' : 'products'}` },
          { label: productTitle, href: '#' },
        ]}
        textColor="text-primary"
      />
    </div>
  </div>

  <!-- Detalle del producto con fondo blanco -->
  <div class="bg-white py-8 md:py-12">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 max-w-7xl mx-auto">
        <!-- Columna izquierda: Imagen y presentaciones -->
        <div class="w-full">
          <!-- Imagen del producto -->
          <div class="product-image-container mb-8 flex justify-center">
            <LazyImage
              src={productImage}
              alt={productTitle}
              class="w-[300px] max-w-md h-auto object-contain"
              transition:name={`product-image-${currentProduct.id}`}
              priority={true}
            />
          </div>
          
          <!-- Presentaciones -->
          <div class="mt-8">
            <h2 class="text-xl md:text-2xl font-bold text-primary mb-4">{texts.presentation}</h2>
            <div class="flex gap-6 items-end justify-center flex-wrap">
              {presentations.map((item) => (
                <div class="text-center">
                  <div class="w-20 h-24 border-2 border-gray-300 rounded-lg mb-2 flex items-center justify-center overflow-hidden bg-white p-1">
                    <img
                      src={item.image || 'https://snack.yummiespromociones.com/SnacksyummiesAssets/gramajes.png'}
                      alt={item.label}
                      class="w-full h-full object-contain"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <p class="text-sm font-semibold text-gray-700">{item.label}</p>
                </div>
              ))}
            </div>
            <p class="text-xs text-gray-500 text-center mt-4 italic">*{texts.presentationNote}</p>
          </div>
        </div>
        
        <!-- Columna derecha: Información del producto -->
        <div class="w-full">
          <!-- Título del producto -->
          <h1 class="text-2xl md:text-3xl lg:text-4xl font-bold text-primary mb-6">{productTitle}</h1>
          
          <!-- Descripción -->
          <div class="mb-8">
            <h2 class="text-xl md:text-2xl font-bold text-primary mb-4">{texts.description}</h2>
            <div class="space-y-3">
              <div class="flex items-start gap-3">
                <svg class="w-6 h-6 text-primary flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                <p class="text-gray-700 leading-relaxed">
                  {currentProduct.description || (currentLang === 'es' ? 'Disfruta del auténtico sabor y la mejor calidad de nuestros productos.' : 'Enjoy authentic flavor and top quality snacks.')}
                </p>
              </div>
            </div>
          </div>
          
          <!-- Información Nutricional -->
          <div class="mb-8">
            <h2 class="text-xl md:text-2xl font-bold text-primary mb-4">{texts.nutritionalInfo}</h2>
            {hasCmsNutritionRows ? (
              <div class="border border-gray-300 rounded-lg overflow-hidden">
                {nutritionData?.title && (
                  <div class="bg-primary text-white px-4 py-2 font-bold text-sm">
                    {nutritionData.title}
                  </div>
                )}
                {nutritionData?.serving && (
                  <div class="bg-gray-50 px-4 py-2 border-b border-gray-300">
                    <p class="text-sm font-semibold text-gray-700">{nutritionData.serving}</p>
                  </div>
                )}
                <div class="px-4 py-2">
                  {nutritionData?.rows?.map((row) => (
                    <div class="border-b border-gray-200 py-2 flex justify-between">
                      <span class="text-sm text-gray-700">{row.label}</span>
                      <span class="text-sm font-bold text-gray-900">{row.value}</span>
                    </div>
                  ))}
                  {nutritionData?.disclaimer && (
                    <p class="text-xs text-gray-500 mt-2 italic">{nutritionData.disclaimer}</p>
                  )}
                </div>
              </div>
            ) : (
              <div class="border border-gray-300 rounded-lg overflow-hidden">
                <div class="bg-gray-50 px-4 py-2 border-b border-gray-300">
                  <p class="text-sm font-semibold text-gray-700">{fallbackNutrition.servingsPerContainer}</p>
                  <p class="text-sm text-gray-600">{fallbackNutrition.servingSizeLabel} <span class="float-right">{fallbackNutrition.servingSizeValue}</span></p>
                </div>
                <div class="px-4 py-2">
                  <div class="border-b border-gray-200 py-2">
                    <p class="text-sm font-semibold text-gray-700">{fallbackNutrition.amountPerServing}</p>
                  </div>
                  <div class="border-b border-gray-200 py-2 flex justify-between">
                    <span class="text-sm text-gray-700">{fallbackNutrition.caloriesLabel}</span>
                    <span class="text-sm font-bold text-gray-900">{fallbackNutrition.caloriesValue}</span>
                  </div>
                  <div class="py-1">
                    <p class="text-xs text-right text-gray-600">% {fallbackNutrition.dailyValueLabel} *</p>
                  </div>
                  <div class="border-b border-gray-200 py-2 flex justify-between">
                    <span class="text-sm text-gray-700">{fallbackNutrition.totalFatLabel} {fallbackNutrition.totalFatValue}</span>
                    <span class="text-sm font-bold text-gray-900">{fallbackNutrition.totalFatDaily}</span>
                  </div>
                  <div class="border-b border-gray-200 py-2 flex justify-between pl-4">
                    <span class="text-sm text-gray-700">{fallbackNutrition.saturatedFatLabel} {fallbackNutrition.saturatedFatValue}</span>
                    <span class="text-sm font-bold text-gray-900">{fallbackNutrition.saturatedFatDaily}</span>
                  </div>
                  <div class="border-b border-gray-200 py-2 flex justify-between pl-4">
                    <span class="text-sm text-gray-700">{fallbackNutrition.transFatLabel} {fallbackNutrition.transFatValue}</span>
                    <span class="text-sm font-bold text-gray-900">{fallbackNutrition.transFatDaily}</span>
                  </div>
                  <div class="border-b border-gray-200 py-2 flex justify-between">
                    <span class="text-sm text-gray-700">{fallbackNutrition.cholesterolLabel} {fallbackNutrition.cholesterolValue}</span>
                    <span class="text-sm font-bold text-gray-900">{fallbackNutrition.cholesterolDaily}</span>
                  </div>
                </div>
              </div>
            )}
          </div>
        </div>
      </div>

      {currentLang === 'es' && (
        <DeliveryAppsCarousel />
      )}

      <!-- Productos relacionados -->
      {relatedProducts.length > 0 && (
        <div class="mt-16">
          <h2 class="text-2xl font-bold text-primary mb-8 text-center">{texts.relatedProducts}</h2>
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 md:gap-6 place-items-center">
            {relatedProducts.map(relProd => (
              <div class="product-item w-full">
                <a href={`/${currentLang}/${currentLang === 'es' ? 'productos' : 'products'}/${relProd.slug || relProd.id}`} class="w-full flex flex-col items-center">
                  <div class="w-full overflow-hidden mb-3 hover:scale-105 transition-transform duration-300">
                    <LazyImage
                      src={relProd.image || 'https://snack.yummiespromociones.com/SnacksyummiesAssets/placeholder.webp'}
                      alt={relProd.title || relProd.name}
                      class="w-full h-auto object-contain"
                    />
                  </div>
                  
                  <h3 class="text-center font-title text-lg leading-tight text-primary">
                    {relProd.title || relProd.name}
                  </h3>
                </a>
              </div>
            ))}
          </div>
        </div>
      )}
      
      <!-- Botón para volver a productos -->
      <div class="flex justify-center mt-12">
        <a href={`/${currentLang}/${currentLang === 'es' ? 'productos' : 'products'}`} class="bg-primary text-white py-3 px-8 rounded-full hover:bg-opacity-90 transition-all font-semibold">
          {texts.backToProducts}
        </a>
      </div>
    </div>
  </div>
</div>

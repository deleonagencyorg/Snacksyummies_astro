<script is:inline>
  (function() {
    function isYouTube(url) {
      return !!url && /youtu\.be|youtube\.com/.test(url);
    }

    function getYouTubeId(url) {
      if (!url) return '';
      var match = url.match(/(?:youtu\.be\/|v\/|embed\/|shorts\/|watch\?v=|&v=)([^#&?]{11})/);
      return match ? match[1] : '';
    }

    function isYouTubeShort(url) {
      return !!url && /youtube\.com\/shorts\//.test(url);
    }

    function buildEmbedUrl(videoId) {
      var params = new URLSearchParams({
        autoplay: '1',
        controls: '1',
        playsinline: '1',
        rel: '0',
        modestbranding: '1'
      });
      return 'https://www.youtube.com/embed/' + videoId + '?' + params.toString();
    }

    function getElements() {
      return {
        modal: document.getElementById('video-modal-overlay'),
        container: document.getElementById('video-modal-container'),
        iframe: document.getElementById('video-modal-iframe'),
        video: document.getElementById('video-modal-player'),
        fallback: document.getElementById('video-modal-fallback'),
        fallbackLink: document.getElementById('video-modal-fallback-link')
      };
    }

    function showEl(el) {
      if (!el) return;
      el.classList.remove('hidden');
      el.style.display = 'block';
    }

    function hideEl(el) {
      if (!el) return;
      el.classList.add('hidden');
      el.style.display = 'none';
    }

    function setMode(container, modal, mode) {
      if (container) container.dataset.mode = mode;
      if (modal) modal.dataset.mode = mode;
    }

    function sizeContainer(container, w, h) {
      if (!container || !w || !h) return;
      var maxW = window.innerWidth * 0.92;
      var maxH = window.innerHeight * 0.85;
      var ratio = w / h;
      var width = maxW;
      var height = width / ratio;
      if (height > maxH) {
        height = maxH;
        width = height * ratio;
      }
      container.style.width = Math.round(width) + 'px';
      container.style.height = Math.round(height) + 'px';
    }

    function resetContainerSize(container) {
      if (!container) return;
      container.style.width = '';
      container.style.height = '';
    }

    function hideFallback(els) {
      hideEl(els.fallback);
    }

    function showFallback(els, url) {
      if (!els.fallback || !els.fallbackLink) return;
      els.fallbackLink.href = url;
      els.fallback.style.display = 'flex';
      els.fallback.classList.remove('hidden');
    }

    function stopVideo(video) {
      if (!video) return;
      video.pause();
      video.onloadedmetadata = null;
      video.oncanplay = null;
      video.onerror = null;
      video.removeAttribute('src');
      video.load();
      hideEl(video);
    }

    function stopIframe(iframe) {
      if (!iframe) return;
      iframe.src = '';
      hideEl(iframe);
    }

    function resetModal(els) {
      stopIframe(els.iframe);
      stopVideo(els.video);
      hideFallback(els);
      resetContainerSize(els.container);
      setMode(els.container, els.modal, 'default');
    }

    function playVideo(els, url) {
      var video = els.video;
      var container = els.container;
      if (!video || !container) return;

      stopIframe(els.iframe);
      hideFallback(els);
      setMode(container, els.modal, 'direct-video');
      sizeContainer(container, 16, 9);

      video.muted = true;
      video.setAttribute('controls', '');
      video.setAttribute('playsinline', '');
      video.setAttribute('webkit-playsinline', '');
      video.src = url;

      video.onloadedmetadata = function() {
        var vw = video.videoWidth;
        var vh = video.videoHeight;
        if (vw > 0 && vh > 0) {
          sizeContainer(container, vw, vh);
          setMode(container, els.modal, vh > vw ? 'direct-portrait' : 'direct-landscape');
        }
      };

      video.oncanplay = function() {
        var promise = video.play();
        if (promise && promise.catch) {
          promise.catch(function() {
            video.muted = false;
            video.controls = true;
          });
        }
      };

      video.onerror = function() {
        stopVideo(video);
        if (els.iframe) {
          setMode(container, els.modal, 'direct-iframe');
          sizeContainer(container, 16, 9);
          els.iframe.src = url;
          showEl(els.iframe);
          return;
        }
        showFallback(els, url);
      };

      showEl(video);
      video.load();
      var playPromise = video.play();
      if (playPromise && playPromise.catch) {
        playPromise.catch(function() {
          video.muted = false;
          video.controls = true;
        });
      }
    }

    function playYouTube(els, url) {
      var videoId = getYouTubeId(url);
      if (!videoId || !els.iframe) return false;

      stopVideo(els.video);
      hideFallback(els);

      var isShort = isYouTubeShort(url);
      setMode(els.container, els.modal, isShort ? 'youtube-shorts' : 'youtube');
      sizeContainer(els.container, isShort ? 9 : 16, isShort ? 16 : 9);

      els.iframe.src = buildEmbedUrl(videoId);
      showEl(els.iframe);
      return true;
    }

    window.openVideoModal = function(url) {
      if (!url) return;

      var els = getElements();
      if (!els.modal || !els.container) return;

      resetModal(els);

      if (isYouTube(url)) {
        if (!playYouTube(els, url)) return;
      } else {
        playVideo(els, url);
      }

      els.modal.classList.remove('hidden');
      els.modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    };

    window.closeVideoModal = function() {
      var els = getElements();
      if (!els.modal) return;
      resetModal(els);
      els.modal.classList.add('hidden');
      els.modal.classList.remove('flex');
      document.body.style.overflow = '';
    };

    document.addEventListener('click', function(e) {
      var modal = document.getElementById('video-modal-overlay');
      if (e.target === modal) window.closeVideoModal();
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') window.closeVideoModal();
    });
  })();
</script>

<div
  id="video-modal-overlay"
  data-mode="default"
  class="video-modal-overlay hidden fixed inset-0 z-[100] items-center justify-center bg-black/80 backdrop-blur-sm p-4"
  onclick="if(event.target===this)window.closeVideoModal()"
>
  <div
    id="video-modal-container"
    data-mode="default"
    class="video-modal-container relative bg-black rounded-xl overflow-hidden shadow-2xl"
    onclick="event.stopPropagation()"
  >
    <button
      type="button"
      onclick="window.closeVideoModal()"
      class="video-modal-close absolute top-2 right-2 z-30 flex h-9 w-9 items-center justify-center rounded-full bg-black/60 text-white transition-colors hover:bg-black/80"
      aria-label="Close video"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <iframe
      id="video-modal-iframe"
      class="video-modal-media hidden"
      frameborder="0"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen"
      allowfullscreen
    ></iframe>

    <video
      id="video-modal-player"
      class="video-modal-media hidden"
      controls
      playsinline
      webkit-playsinline
      preload="auto"
    ></video>

    <div
      id="video-modal-fallback"
      class="video-modal-fallback hidden absolute inset-0 z-20 flex flex-col items-center justify-center gap-4 p-6 text-center text-white"
    >
      <p class="text-sm opacity-90 md:text-base">No se pudo reproducir el video en este navegador.</p>
      <a
        id="video-modal-fallback-link"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-full bg-white px-5 py-2 text-sm font-semibold text-primary hover:opacity-90"
      >
        Abrir video
      </a>
    </div>
  </div>
</div>

<style is:global>
  .video-modal-container {
    flex-shrink: 0;
    width: min(92vw, 960px);
    aspect-ratio: 16 / 9;
    max-height: 85vh;
  }

  .video-modal-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
    display: none;
    background: #000;
  }

  #video-modal-player {
    object-fit: contain;
  }

  .video-modal-close {
    top: calc(env(safe-area-inset-top, 0px) + 0.5rem);
    right: calc(env(safe-area-inset-right, 0px) + 0.5rem);
  }

  .video-modal-fallback {
    background: rgba(0, 0, 0, 0.92);
  }
</style>

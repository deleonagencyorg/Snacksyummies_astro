            </h3>
          </div>

          <!-- Producto 3: Yummi Pops Queso -->
          <div class="flex flex-col items-center text-center animate-item">
            <div class="w-full aspect-[385/427] bg-[#f2f2f2] rounded-[11.7%/10.5%] flex items-center justify-center mb-4 md:mb-6">
              <LazyImage 
                src="https://snack.yummiespromociones.com/SnacksyummiesAssets/productosconcausagt/productos/palomitas_maiz.webp" 

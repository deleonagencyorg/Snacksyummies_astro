---
// src/components/common/Footer/index.astro
import { type Locale } from '../../../i18n/i18n';
import { logos, generalAssets } from '../../../config/assets';
import './styles.css';
import Skeleton from './Skeleton.astro';
import LazyImage from '../LazyImage.astro';
import Newsletter from '../Newsletter/index.astro';
import SocialMediaIcons from '../SocialMediaIcons/index.astro';
import contactEs from '../../../locales/es/contact.json';
import contactEn from '../../../locales/en/contact.json';
import { getFooterLabels } from '../../../services/api/footer';
import { getFooterLinks, getFooterPhones } from '../../../services/api/sections';
import { getContactConfig } from '../../../services/api/contact';

export interface Props {
  currentLang: Locale;
  loading?: boolean;
}

const { currentLang, loading = false } = Astro.props;

const currentYear = new Date().getFullYear();

const [footer, phones, footerLinks, cmsContact] = await Promise.all([
  getFooterLabels(currentLang),
  getFooterPhones(currentLang),
  getFooterLinks(currentLang),
  getContactConfig(currentLang),
]);
const privacyPolicyText = footer?.privacyPolicyText ?? '';
const privacyPolicyUrl = footer?.privacyPolicyUrl ?? '';
const copyrightText = (footer?.copyright ?? '').replace('{year}', currentYear.toString());
const address = footer?.address ?? '';
const phone = footer?.phone ?? '';
const hours = footer?.hours ?? '';
const newsletterTitle = footer?.newsletter ?? '';
const newsletterDescription = footer?.newsletterDescription ?? '';
const newsletterPlaceholder = footer?.emailPlaceholder ?? '';
const newsletterButton = footer?.newsletterButton ?? '';
const contactTitle = footer?.contactTitle ?? '';

// Datos de oficinas por país para detección geo
const contactData = currentLang === 'en' ? contactEn : contactEs;
const officesData: Record<string, any> = { ...contactData.offices.locations };
const countryDialingCodes: Record<string, string> = {
  HN: '+504',
  GT: '+502',
  SV: '+503',
  NI: '+505',
  CR: '+506',
  DO: '+1809',
};
for (const office of cmsContact?.offices.locations ?? []) {
  const countryCode = office.countryCode.toUpperCase();
  const key = countryCode === 'DO' || countryCode === '+1-809'
    ? '+1809'
    : office.countryCode.startsWith('+')
    ? office.countryCode
    : countryDialingCodes[countryCode] || office.countryCode;
  officesData[key] = {
    ...(officesData[key] || {}),
    address: office.address || '',
    phones: office.phones || [],
  };
}
if (cmsContact && !officesData['+504']) {
  const firstOffice = cmsContact.offices.locations[0];
  if (firstOffice) officesData['+504'] = { address: firstOffice.address, phones: firstOffice.phones };
}
---

{loading ? (
  <Skeleton />
) : (
  <footer class="bg-cuaternary text-white py-8 px-4 sm:px-6 lg:px-8 font-sans">
    <div class="container mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
        <!-- Orden de columnas en mobile controlado con order-* -->
        <!-- Columna 1: Información de contacto (segundo en mobile) -->
        <div class="flex flex-col items-center md:items-start space-y-3 order-2 md:order-1 w-full">
          <div class="flex items-start justify-center md:justify-start space-x-2 w-full">
            <LazyImage
              src={generalAssets.locationIcon}
              alt="Ubicación"
              class="h-4 w-4 flex-shrink-0 mt-0.5"
              color="white"
              width={16}
              height={16}
            />
            <span id="footer-address" class="text-xs md:text-sm leading-snug text-center md:text-left inline-block">{address}</span>
          </div>
          <div class="flex items-center justify-center md:justify-start space-x-2 w-full">
            <LazyImage
              src={generalAssets.phoneIcon}
              alt="Teléfono"
              class="h-4 w-4 flex-shrink-0"
              color="white"
              width={16}
              height={16}
            />
            <span id="footer-phone" class="text-xs md:text-sm whitespace-nowrap">{phone}</span>
          </div>
          <div class="flex items-center justify-center md:justify-start space-x-2 w-full">
            <svg class="h-4 w-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
            </svg>
            <span class="text-xs md:text-sm whitespace-nowrap">{hours}</span>
          </div>
        </div>

        <!-- Columna 2: Logo, política de privacidad y copyright (tercero en mobile) -->
        <div class="flex flex-col items-center text-center space-y-4 order-3 md:order-2">
          <a href={`/${currentLang}/`} class="mb-2">
            <img src={logos.principal.url} alt={logos.principal.alt || 'Yummies Logo'} class="h-16 w-auto mx-auto" />
          </a>
          <div>
            <a href={privacyPolicyUrl} class="text-sm hover:underline">{privacyPolicyText}</a>
          </div>
          {footerLinks.length > 0 && (
            <nav aria-label={currentLang === 'es' ? 'Enlaces del pie de página' : 'Footer links'}>
              <ul class="flex flex-wrap justify-center gap-x-4 gap-y-2 text-xs">
                {footerLinks.map((link) => (
                  <li><a href={link.url} class="hover:underline">{link.label}</a></li>
                ))}
              </ul>
            </nav>
          )}
          <div class="text-xs opacity-80">
            {copyrightText}
          </div>
        </div>

        <!-- Columna 3: Newsletter y redes sociales (primero en mobile) -->
        <div class="flex flex-col items-center md:items-start w-full order-1 md:order-3 text-center md:text-left">
          <!-- Redes Sociales -->
          <div class="mb-4">
            <SocialMediaIcons 
              currentLang={currentLang} 
              iconColor="white"
              centered={true} 
            />
          </div>
          <!-- Newsletter -->
          <Newsletter 
            title={newsletterTitle}
            description={newsletterDescription}
            placeholder={newsletterPlaceholder} 
            buttonText={newsletterButton}
            centered={true}
          />
        </div>
      </div>
      
      <!-- Separador para la sección de contacto -->
      <div class="w-full border-t border-white border-opacity-20 mt-6 pt-6">
        <div class="container mx-auto">
          <div class="text-center mb-4">
            <h3 class="text-white font-sans text-xl font-medium">{contactTitle}</h3>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-3 justify-items-center">
            {phones.map((item) => (
              <a href={item.telHref} class="flex items-center space-x-1.5">
                {item.flagImageUrl ? (
                  <img src={item.flagImageUrl} alt={item.country} class="h-4 w-6 object-cover" loading="lazy" />
                ) : (
                  <span class="text-lg" role="img" aria-label={item.country}>{item.flag}</span>
                )}
                <span class="text-xs whitespace-nowrap">{item.number}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </footer>
)}

<script src="./scripts.js"></script>

<script define:vars={{ officesData }}>
  const COUNTRY_CODE_TO_OFFICE_KEY = {
    'HN': '+504',
    'GT': '+502',
    'SV': '+503',
    'NI': '+505',
    'CR': '+506',
    'DO': '+1809'
  };

  const DEFAULT_OFFICE_KEY = '+504';
  const GEO_COOKIE_NAME = 'yummies_geo_v2';
  const GEO_COOKIE_DAYS = 7;

  function getCookie(name) {
    const match = document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]*)'));
    return match ? decodeURIComponent(match[1]) : null;
  }

  function getGeoCookieValue() {
    return getCookie('yummies_geo_v2') || getCookie('yummies_country_code') || null;
  }

  function setCookie(name, value, days) {
    const expires = new Date(Date.now() + days * 864e5).toUTCString();
    document.cookie = name + '=' + encodeURIComponent(value) + '; expires=' + expires + '; path=/; SameSite=Lax';
  }

  function setLoadingState() {
    const addressEl = document.getElementById('footer-address');
    const phoneEl = document.getElementById('footer-phone');
    if (addressEl) {
      addressEl.innerHTML = '<span class="inline-block bg-white/20 rounded animate-pulse w-48 h-4">&nbsp;</span>';
    }
    if (phoneEl) {
      phoneEl.innerHTML = '<span class="inline-block bg-white/20 rounded animate-pulse w-28 h-4">&nbsp;</span>';
    }
  }

  function updateFooterContact(officeKey) {
    const office = officesData[officeKey] || officesData[DEFAULT_OFFICE_KEY];
    if (!office) return;

    const addressEl = document.getElementById('footer-address');
    const phoneEl = document.getElementById('footer-phone');

    if (addressEl && office.address) {
      addressEl.textContent = office.address;
    }
    if (phoneEl && office.phones && office.phones.length > 0) {
      phoneEl.textContent = office.phones[0];
    }
  }

  async function detectCountryCode() {
    // Método 1: API del servidor (Cloudflare headers)
    try {
      const response = await fetch('/api/geo-headers');
      if (response.ok) {
        const data = await response.json();
        if (data.country) return data.country;
      }
    } catch (_) {}

    // Método 2: ipapi.co
    try {
      const response = await fetch('https://ipapi.co/json/');
      if (response.ok) {
        const data = await response.json();
        if (data.country_code) return data.country_code;
      }
    } catch (_) {}

    // Método 3: api.country.is
    try {
      const response = await fetch('https://api.country.is/');
      if (response.ok) {
        const data = await response.json();
        if (data.country) return data.country;
      }
    } catch (_) {}

    return null;
  }

  async function initFooterGeo() {
    // Mostrar estado de carga inmediatamente
    setLoadingState();

    // Leer cookie primero
    const cached = getGeoCookieValue();
    if (cached) {
      const officeKey = COUNTRY_CODE_TO_OFFICE_KEY[cached] || DEFAULT_OFFICE_KEY;
      updateFooterContact(officeKey);
      return;
    }

    // Detectar país via APIs
    const countryCode = await detectCountryCode();

    // Guardar en cookie (incluso si es null guardamos 'HN' para no volver a detectar)
    setCookie(GEO_COOKIE_NAME, countryCode || 'HN', GEO_COOKIE_DAYS);

    const officeKey = countryCode ? (COUNTRY_CODE_TO_OFFICE_KEY[countryCode] || DEFAULT_OFFICE_KEY) : DEFAULT_OFFICE_KEY;
    updateFooterContact(officeKey);
  }

  // Astro View Transitions + fallback DOMContentLoaded
  document.addEventListener('astro:page-load', initFooterGeo);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFooterGeo);
  } else {
    initFooterGeo();
  }
</script>

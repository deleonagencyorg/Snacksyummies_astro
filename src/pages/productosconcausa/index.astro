<script>
  import { initTitleLetters } from '../../scripts/titleLetters';

  // Intersection Observer para animar elementos al hacer scroll
  document.addEventListener('astro:page-load', () => {
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    // Observar todas las secciones con animación
    const animatedSections = document.querySelectorAll('.animate-slide-up');
    animatedSections.forEach(section => {
      section.classList.add('animate-on-scroll');
      observer.observe(section);
    });

    // Observar items individuales
    const animatedItems = document.querySelectorAll('.animate-item, .reveal');
    // Header: las capas del CDN miden hasta 16383px de ancho. Pintarlas por primera vez congela ~800ms
    // (justo cuando entra el 10 años). Antes de animar se reemplaza cada imagen por un canvas del tamaño
    // con que se ve (x densidad de pantalla), así la animación solo mueve bitmaps livianos.
    // El CDN no manda CORS: el canvas queda "tainted", pero se puede mostrar sin problema.
    const hero = document.querySelector<HTMLElement>('.hn-hero');
    if (hero) {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);

      const shrink = async (img: HTMLImageElement) => {
        try {
          if (!img.complete || !img.naturalWidth) {
            await new Promise((resolve, reject) => {
              img.addEventListener('load', resolve, { once: true });
              img.addEventListener('error', reject, { once: true });
            });
          }
          // 1.25x de margen por si la ventana crece después
          const width = Math.ceil(img.offsetWidth * dpr * 1.25);
          if (!width || img.naturalWidth <= width * 1.2) {
            await img.decode();
            return;
          }
          const height = Math.round((width * img.naturalHeight) / img.naturalWidth);
          const bitmap = await createImageBitmap(img, { resizeWidth: width, resizeHeight: height, resizeQuality: 'high' });
          const canvas = document.createElement('canvas');
          canvas.width = width;
          canvas.height = height;
          canvas.getContext('2d')?.drawImage(bitmap, 0, 0, width, height);
          bitmap.close();
          // Copia class y los data-astro-cid-* (los estilos de la página están "scoped" a ese atributo)
          const skip = new Set(['src', 'srcset', 'sizes', 'alt', 'width', 'height', 'loading', 'decoding', 'fetchpriority']);
          for (const { name, value } of Array.from(img.attributes)) {
            if (!skip.has(name)) canvas.setAttribute(name, value);
          }
          if (img.alt) {
            canvas.setAttribute('role', 'img');
            canvas.setAttribute('aria-label', img.alt);
          } else {
            canvas.setAttribute('aria-hidden', 'true');
          }
          img.replaceWith(canvas);
        } catch {
          // Si algo falla se queda la imagen original
        }
      };

      const ready = Promise.all(Array.from(hero.querySelectorAll('img')).map(shrink));
      const timeout = new Promise(resolve => setTimeout(resolve, 4000));
      Promise.race([ready, timeout]).then(() => {
        // Dos frames para que los canvas ya estén pintados antes del primer cuadro de la animación
        requestAnimationFrame(() => requestAnimationFrame(() => hero.classList.add('visible')));
      });
    }

    animatedItems.forEach(item => {
      observer.observe(item);
    });

    const testimonialOverlays = document.querySelectorAll('.testimonial-video-overlay');
    testimonialOverlays.forEach((overlay) => {
      overlay.addEventListener('click', () => {
        const container = overlay.closest('.relative');
        if (!container) return;
        const video = container.querySelector('video');
        if (!video) return;
        video.play();
        video.setAttribute('controls', 'controls');
        overlay.classList.add('hidden');
      });
    });

    // Títulos letra por letra (.title-letters)
    initTitleLetters();

    // Contador animado para las cifras de Indicadores y Donativos
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const counters = document.querySelectorAll<HTMLElement>('.count-up');

    const digitalCounters = document.querySelectorAll<HTMLElement>('.digital-counter');

    const runCount = (target: number, duration: number, render: (value: number) => void) => {
      const start = performance.now();

      const tick = (now: number) => {
        const progress = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3); // easeOutCubic
        render(target * eased);
        if (progress < 1) requestAnimationFrame(tick);
      };

      requestAnimationFrame(tick);
    };

    const animateCounter = (el: HTMLElement) => {
      const target = parseFloat(el.dataset.target || '0');
      const decimals = parseInt(el.dataset.decimals || '0', 10);
      const format = new Intl.NumberFormat('en-US', {
        minimumFractionDigits: decimals,
        maximumFractionDigits: decimals
      });

      runCount(target, 2000, (value) => {
        el.textContent = format.format(value);
      });
    };

    // Contador digital de la campaña: actualiza cada dígito por separado
    const animateDigitalCounter = (el: HTMLElement) => {
      const target = parseInt(el.dataset.target || '0', 10);
      const cells = Array.from(el.querySelectorAll<HTMLElement>('.counter-digit, .counter-separator'));
      const digitCount = cells.filter(cell => cell.classList.contains('counter-digit')).length;

      runCount(target, 2500, (value) => {
        const current = String(Math.floor(value));
        const padded = current.padStart(digitCount, '0');
        const firstUsed = digitCount - current.length;
        let digitIndex = 0;

        cells.forEach(cell => {
          if (cell.classList.contains('counter-digit')) {
            cell.textContent = padded[digitIndex];
            cell.classList.toggle('is-off', digitIndex < firstUsed);
            digitIndex++;
          } else {
            // El separador se apaga si todavía no hay dígitos a su izquierda
            cell.classList.toggle('is-off', digitIndex <= firstUsed);
          }
        });
      });
    };

    if (!prefersReducedMotion) {
      // Arrancan en 0 para que no se vea la cifra final antes de animar
      counters.forEach(counter => {
        const decimals = parseInt(counter.dataset.decimals || '0', 10);
        counter.textContent = (0).toFixed(decimals);
      });
      digitalCounters.forEach(counter => {
        counter.querySelectorAll<HTMLElement>('.counter-digit, .counter-separator').forEach((cell, i, all) => {
          const isLast = i === all.length - 1;
          if (isLast) cell.textContent = '0';
          cell.classList.toggle('is-off', !isLast);
        });
      });

      const counterObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const target = entry.target as HTMLElement;
            if (target.classList.contains('digital-counter')) {
              animateDigitalCounter(target);
            } else {
              animateCounter(target);
            }
            counterObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.5 });

      counters.forEach(counter => counterObserver.observe(counter));
      digitalCounters.forEach(counter => counterObserver.observe(counter));
    }
  });
</script>

---
import Layout from '../../../layouts/ProductosConCausaLayout.astro';
import LazyImage from '../../../components/common/LazyImage.astro';
import { ViewTransitions } from 'astro:transitions';
import '../../../styles/title-letters.css';
import '../../../styles/pcc-gt-fonts.css';
---

<Layout 
  title="Productos con Causa Yummi Pops | Operación Sonrisa Honduras" 
  description="Descubre la alianza de Yummi Pops y Operación Sonrisa Honduras: productos con causa que financian cirugías, clínicas y miles de sonrisas transformadas.">
  <ViewTransitions slot="head" />
  <main class="container mx-auto ">
    <article class="w-full">
       <!-- Header GT: fondo + logo animado (gif) + título por líneas -->
       <header id="inicio" class="pcc-hero">
         <img src="https://snack.yummiespromociones.com/SnacksyummiesAssets/productosconcausagt/header/fondo.webp" alt="" aria-hidden="true" class="pcc-hero__bg" width="7681" height="4667" loading="eager" fetchpriority="high" decoding="async" />
         <div class="pcc-hero__content">
           <img src="https://snack.yummiespromociones.com/SnacksyummiesAssets/productosconcausagt/header/logo_yummies.gif" alt="Yummies" class="pcc-hero__logo" width="1000" height="1000" loading="eager" decoding="async" />
           <div class="pcc-hero__title" role="img" aria-label="Sonrisas que transforman vidas">
             <span class="pcc-hero__line pcc-hero__line--1" aria-hidden="true"></span>
             <span class="pcc-hero__line pcc-hero__line--2" aria-hidden="true"></span>
             <span class="pcc-hero__line pcc-hero__line--3" aria-hidden="true"></span>
           </div>
         </div>
         <div class="pcc-hero__products">
           <img src="https://snack.yummiespromociones.com/SnacksyummiesAssets/productosconcausagt/productos/jalapeno.webp" alt="Yummi Pops Nacho Jalapeño Cream" class="pcc-hero__product pcc-hero__product--1" width="1052" height="1501" loading="eager" decoding="async" />
           <img src="https://snack.yummiespromociones.com/SnacksyummiesAssets/productosconcausagt/productos/queso_blanco.webp" alt="Yummi Pops Nacho Queso Blanco" class="pcc-hero__product pcc-hero__product--2" width="1052" height="1501" loading="eager" decoding="async" />
           <img src="https://snack.yummiespromociones.com/SnacksyummiesAssets/productosconcausagt/productos/palomitas_maiz.webp" alt="Yummi Pops Palomitas de Maíz Queso" class="pcc-hero__product pcc-hero__product--3" width="1052" height="1501" loading="eager" decoding="async" />
           <img src="https://snack.yummiespromociones.com/SnacksyummiesAssets/productosconcausagt/productos/sal_marina.webp" alt="Yummi Pops Palomitas de Maíz Sal Marina" class="pcc-hero__product pcc-hero__product--4" width="1052" height="1501" loading="eager" decoding="async" />
         </div>
       </header>
      
        <section id="sobre-la-causa" class="container flex flex-col md:flex-row items-center justify-center text-center px-6 pt-6 pb-0 mt-6 mb-0 gap-y-2 md:gap-x-12 md:p-8 md:my-8 lg:p-0 overflow-x-clip">
          <div class="sm:w-full md:w-1/2 ">
            <!-- Tipografía y tamaños del diseño GT (base 1920px: título 54/60px, texto 40/50px) -->
            <h2 class="reveal reveal-left font-gt-title text-[#e3032e] text-left text-[clamp(1.75rem,2.8vw,3.375rem)] leading-[1.11]">
              ¡Yummi Pops se suma <br class="hidden md:inline" />a transformar sonrisas <br class="hidden md:inline" />en Guatemala!
            </h2>
            <div class="reveal reveal-up reveal-delay-1 font-gt-text text-[#004e9d] text-left text-[clamp(1.125rem,1.85vw,2.5rem)] leading-[1.25] mt-[0.4em] break-words">
              <p class="font-gt-text">
                En Yummies creemos en el poder de <b>compartir alegría y generar un impacto positivo en las comunidades</b> donde estamos presentes.
              </p>
              <p class="font-gt-text mt-[0.5em]">
                Por eso, este año nos unimos a Fundación Operación Sonrisa Guatemala a través de Yummi Pops, en una campaña de producto con causa que busca <b>apoyar la atención integral de pacientes</b> con labio fisurado y paladar hendido en Guatemala.
              </p>
            </div>
          </div>
          <div class="reveal reveal-right reveal-delay-2 sm:w-full md:w-1/2 text-center md:mt-8">
            <!-- Niño y niña lado a lado; object-cover recorta el espacio lateral de cada PNG -->
            <div class="md:w-[80%] w-[78%] mx-auto flex justify-center">
              <LazyImage src="https://snack.yummiespromociones.com/SnacksyummiesAssets/productosconcausagt/boy_gt.webp" alt="Operación Sonrisa Guatemala - niño" class="w-1/2 aspect-[1/1.9] object-cover" />
              <LazyImage src="https://snack.yummiespromociones.com/SnacksyummiesAssets/productosconcausagt/girl_gt.webp" alt="Operación Sonrisa Guatemala - niña" class="w-1/2 aspect-[1/1.9] object-cover" />
            </div>
          </div>
      </section>

      <!-- Sección del Contador -->
      <section id="counter" class="container mx-auto px-4 pt-4 pb-2 md:py-12 overflow-x-clip">
        <div class="flex flex-col md:flex-row items-center justify-center gap-6 md:gap-12 lg:gap-16">
          <!-- Texto Izquierdo -->
          <div class="reveal reveal-left text-center md:text-center">
            <p class="text-[#1652a7] font-title font-bold text-lg md:text-2xl lg:text-5xl">
              Llevamos <br/>en esta campaña
            </p>
          </div>

          <!-- Contador Digital -->
          <div class="reveal reveal-up reveal-delay-1 counter-display">
            <div class="counter-wrapper digital-counter" data-target="1000" aria-label="1000">
              <!-- Cero extra a la izquierda: queda apagado (is-off) porque la cifra solo usa 4 dígitos -->
              <span class="counter-digit is-off">0</span>
              <span class="counter-digit">1</span>
              <span class="counter-digit">0</span>
              <span class="counter-digit">0</span>
              <span class="counter-digit">0</span>
            </div>
          </div>

          <!-- Texto Derecho -->
          <div class="reveal reveal-right reveal-delay-2 text-center md:text-left">
            <LazyImage src="https://snack.yummiespromociones.com/SnacksyummiesAssets/sonrisasgeneradas.webp" alt="Operación Sonrisas Honduras" class="md:w-[80%] w-[86%] mx-auto" />
          </div>
        </div>
      </section>

        <section class="bg-[#1652a7] container pt-6 pb-8 mt-4 mb-8 md:py-8 md:my-8 sm:flex sm:flex-col rounded-t-2xl md:rounded-t-[5%] overflow-x-clip">
          <div class="reveal reveal-up w-full py-2 md:py-8 flex justify-center">
            <LazyImage src="https://snack.yummiespromociones.com/SnacksyummiesAssets/productosconcausagt/header/logo_dark.webp" alt="Operación Sonrisa Guatemala" class="w-[240px] md:w-[500px] md:mt-8" />
          </div>
          <div class="reveal reveal-left w-full pt-6 pb-3 md:py-8 flex justify-center px-4">
            <h1 class="text-white font-title text-2xl md:text-4xl lg:text-6xl">Conoce más sobre la causa</h1>
          </div>
          <div class="reveal reveal-up reveal-delay-1 w-full px-6 md:px-8 pb-6 md:pb-8 flex items-center justify-center text-center ">
            <p class="text-white text-left lg:text-justify text-lg md:text-2xl leading-relaxed break-words">
              Desde su llegada al país, Operación Sonrisa Guatemala <span class="font-bold font-title text-white">ha brindado más de 80,000 consultas médicas</span> en sus dos Centros de atención integral, ubicados en la Ciudad de Guatemala y Petén, y ha realizado <span class="font-bold font-title text-white">más de 2,100 cirugías gratuitas y seguras</span>, transformando la vida de miles de pacientes y sus familias.<br/><br/>
              Este año, Yummies se suma a la celebración de los 15 años de Fundación Operación Sonrisa Guatemala, reconociendo una trayectoria de compromiso y acceso a atención médica especializada para quienes más lo necesitan.
            </p>
            </div>
            <div class="px-8 flex flex-col sm:flex-row sm:justify-center sm:gap-x-4 sm:gap-y-4">
              <div class="reveal reveal-left w-full sm:w-1/3">
                <!-- Marco blanco con esquinas internas redondeadas, igual al de foto1mini-foto3mini (28px de borde, radio ~176px sobre 2127px); el marco usa radio 176+28px para que sea concéntrico -->
                <div class="bg-white p-[1.32%] rounded-[9.6%_/_14.1%]"><LazyImage src="https://snack.yummiespromociones.com/SnacksyummiesAssets/productosconcausagt/fotos/galeria_1.webp" alt="Operación Sonrisa Guatemala" width={2560} height={1828} class="w-full aspect-[2071/1394] object-cover rounded-[8.5%_/_12.6%]" /></div>
              </div>
              <div class="reveal reveal-up reveal-delay-1 w-full sm:w-1/3">
                <div class="bg-white p-[1.32%] rounded-[9.6%_/_14.1%]"><LazyImage src="https://snack.yummiespromociones.com/SnacksyummiesAssets/productosconcausagt/fotos/galeria_2.webp" alt="Operación Sonrisa Guatemala" width={667} height={667} class="w-full aspect-[2071/1394] object-cover rounded-[8.5%_/_12.6%]" /></div>
              </div>
              <div class="reveal reveal-right reveal-delay-2 w-full sm:w-1/3">
                <div class="bg-white p-[1.32%] rounded-[9.6%_/_14.1%]"><LazyImage src="https://snack.yummiespromociones.com/SnacksyummiesAssets/productosconcausagt/fotos/galeria_3.webp" alt="Operación Sonrisa Guatemala" width={1024} height={683} class="w-full aspect-[2071/1394] object-cover rounded-[8.5%_/_12.6%]" /></div>
              </div>
            </div>
          </div>
          
      </section>

      <!-- Sección de Impacto -->
      <section id="impacto" class="container mx-auto px-4 py-12 md:py-16 animate-slide-up">
        <!-- Indicadores -->
        <div class="mb-8 md:mb-12">
          <div class="w-full flex justify-center items-center mb-6 md:mb-8">
            <div class="flex flex-col items-center">
              <!-- Cifras de impacto: "CIFRAS" en el azul de "Llevamos en esta campaña", "de impacto" con el estilo del título -->
              <h3 class="text-center font-title font-bold text-3xl md:text-4xl lg:text-8xl leading-tight">
                <span class="title-letters block font-title uppercase text-[#1652a7]">Cifras</span>
                <span class="title-letters block font-title lowercase text-sky-400">de impacto</span>
              </h3>
              <LazyImage src="https://snack.yummiespromociones.com/SnacksyummiesAssets/sonrisa.webp" alt="Operación Sonrisas Honduras" class="p-4 md:p-0 max-w-32 lg:max-w-64" />
            </div>
          </div>
          
          <!-- Cifras de impacto GT: 3 columnas en desktop (anchos del diseño), filas en mobile -->
          <div class="gt-stats bg-[#f1f1f1] rounded-[2rem] md:rounded-[clamp(2rem,5vw,5.5rem)] px-6 py-8 md:px-[4%] md:py-[clamp(2.5rem,5vw,5.5rem)]">
            <div class="grid grid-cols-1 md:grid-cols-[23.7fr_32.8fr_43.5fr] divide-y-2 md:divide-y-0 md:divide-x-[3px] divide-[#d0d0d0]">
              <div class="text-center py-5 md:py-0 md:px-4 animate-item">
                <p class="gt-stats__number">
                  <span class="count-up" data-target="2145" data-decimals="0">2,145</span>
                </p>
                <p class="gt-stats__label">cirugías<br/>en Guatemala.</p>
              </div>

              <div class="text-center py-5 md:py-0 md:px-4 animate-item">
                <p class="gt-stats__number">
                  <span class="count-up" data-target="80000" data-decimals="0">80,000</span>
                </p>
                <p class="gt-stats__label">consultas en 8<br/>especialidades médicas<br/>en dos centros de atención.</p>
              </div>

              <div class="text-center py-5 md:py-0 md:px-4 animate-item">
                <p class="gt-stats__number gt-stats__number--condensed">4 departamentos</p>
                <p class="gt-stats__label">Desarrollamos programas<br/>quirúrgicos en Guatemala,<br/>Escuintla, Petén y Totonicapán.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Sección de Productos Participantes -->
      <section id="productos-participantes" class="container mx-auto px-4 py-12 md:py-16 animate-slide-up relative bg-cover bg-center bg-no-repeat" style="background-image: url('https://snack.yummiespromociones.com/SnacksyummiesAssets/bgmini.webp');">
      

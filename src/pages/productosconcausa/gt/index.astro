---
import Layout from '../../../layouts/ProductosConCausaLayout.astro';
import { ViewTransitions } from 'astro:transitions';
import patternConoce from '../../../assets/productosconcausagt/pattern-conoce.svg?url';
import patternCifras from '../../../assets/productosconcausagt/pattern-cifras.svg?url';
import '../../../styles/title-letters.css';
import '../../../styles/pcc-gt-fonts.css';

const CDN = 'https://snack.yummiespromociones.com/SnacksyummiesAssets';
const GT = `${CDN}/productosconcausagt`;

// Sonrisa roja del diseño (YPOPS-CAUSA_WEB-LAYOUT.ai), exportada del vector original
const smiles = {
  counter: { w: 254.5, h: 75.3, d: 'M0 0.6C46.7 32.8 104.8 42.1 160.1 35.5C182 33 203.5 27.5 223.5 18.1C233.8 13.2 243.9 7.2 252.8 0L254.5 1.1C247.4 18.8 233 32.5 217.5 42.9C171.3 73.1 102.8 75.3 53.7 50.9C31.8 39.8 10.8 22.9 0 0.6Z' },
  cifras: { w: 379.5, h: 92.9, d: 'M0 0.6C53.1 43.8 122.2 63.1 189.9 62.7C248.8 62.6 308.7 50.6 357.7 16.5C364.7 11.5 371.6 6.1 377.8 0L379.5 1.1C371.5 17.7 358.8 31.3 344.8 43.1C301.9 78.7 244.7 92.9 189.9 92.7C134.9 92.8 78.5 76.3 35.7 41.1C21.8 29.5 8.9 16.3 0 0.6Z' },
  productos: { w: 360.4, h: 106.4, d: 'M0 0.6C50.6 41.2 116 59.5 180.3 59.2C236.2 59.1 292.9 47.7 339.5 15.5C346.2 10.8 352.8 5.7 358.7 0L360.4 1.1C353 17 340.9 30 327.7 41.4C250.3 106.4 110.5 104.8 33.6 39.5C20.5 28.3 8.3 15.7 0 0.6Z' },
};

const products = [
  { file: 'jalapeno', alt: 'Yummi Pops Nacho Jalapeño Cream', name: ['Yummi Pops Nacho', 'Jalapeño Cream'], color: '#00bf0c' },
  { file: 'queso_blanco', alt: 'Yummi Pops Nacho Queso Blanco', name: ['Yummi Pops Nacho', 'Queso Blanco'], color: '#00b2f1' },
  { file: 'palomitas_maiz', alt: 'Yummi Pops Queso', name: ['Yummi Pops', 'Queso'], color: '#ff6500' },
  { file: 'sal_marina', alt: 'Yummi Pops Sal Marina', name: ['Yummi Pops', 'Sal Marina'], color: '#005ab2' },
];

// Fotos de la galería: posición y escala de cada foto dentro de su marco, tomadas del diseño
const gallery = [
  { file: 'galeria_1', w: 2560, h: 1828, left: '-1.76%', top: '-8.76%', width: '121.3%' },
  { file: 'galeria_2', w: 667, h: 667, left: '-1.28%', top: '-39.86%', width: '117.6%' },
  { file: 'galeria_3', w: 1024, h: 683, left: '-4.19%', top: '-7.79%', width: '109.6%' },
];
---

<Layout
  title="Productos con Causa Yummi Pops | Operación Sonrisa Honduras"
  description="Descubre la alianza de Yummi Pops y Operación Sonrisa Honduras: productos con causa que financian cirugías, clínicas y miles de sonrisas transformadas.">
  <ViewTransitions slot="head" />
  <!--
    Medidas del diseño YPOPS-CAUSA_WEB-LAYOUT.ai (mesa de trabajo de 1920px).
    En desktop todo se escala con --u (1px del diseño = 100cqw / 1920), así a 1920 coincide 1:1.
  -->
  <main class="gt-page">
    <article class="w-full">
       <!-- Header GT: fondo + logo animado (gif) + título por líneas + productos -->
       <header id="inicio" class="pcc-hero">
         <img src={`${GT}/header/fondo.webp`} alt="" aria-hidden="true" class="pcc-hero__bg" width="7681" height="4667" loading="eager" fetchpriority="high" decoding="async" />
         <img src={`${GT}/header/logo_yummies.gif`} alt="Yummies" class="pcc-hero__logo" width="1000" height="1000" loading="eager" decoding="async" />
         <div class="pcc-hero__title" role="img" aria-label="Sonrisas que transforman vidas">
           <span class="pcc-hero__line pcc-hero__line--1" aria-hidden="true"></span>
           <span class="pcc-hero__line pcc-hero__line--2" aria-hidden="true"></span>
           <span class="pcc-hero__line pcc-hero__line--3" aria-hidden="true"></span>
         </div>
         <img src={`${GT}/productos/jalapeno.webp`} alt="Yummi Pops Nacho Jalapeño Cream" class="pcc-hero__product pcc-hero__product--1" width="1052" height="1501" loading="eager" decoding="async" />
         <img src={`${GT}/productos/queso_blanco.webp`} alt="Yummi Pops Nacho Queso Blanco" class="pcc-hero__product pcc-hero__product--2" width="1052" height="1501" loading="eager" decoding="async" />
         <img src={`${GT}/productos/palomitas_maiz.webp`} alt="Yummi Pops Palomitas de Maíz Queso" class="pcc-hero__product pcc-hero__product--3" width="1052" height="1501" loading="eager" decoding="async" />
         <img src={`${GT}/productos/sal_marina.webp`} alt="Yummi Pops Palomitas de Maíz Sal Marina" class="pcc-hero__product pcc-hero__product--4" width="1052" height="1501" loading="eager" decoding="async" />
       </header>

      <section id="sobre-la-causa" class="gt-intro">
        <div class="gt-intro__text">
          <h2 class="reveal reveal-left font-gt-title gt-intro__title">
            ¡Yummi Pops se suma <br class="hidden md:inline" />a transformar sonrisas <br class="hidden md:inline" />en Guatemala!
          </h2>
          <div class="reveal reveal-up reveal-delay-1 gt-intro__body">
            <p class="font-gt-text">
              En Yummies creemos en el poder de <b>compartir alegría y generar <br class="hidden md:inline" />un impacto positivo en las comunidades</b> donde estamos presentes.
            </p>
            <p class="font-gt-text">
              Por eso, este año nos unimos a Fundación Operación Sonrisa Guatemala a <br class="hidden md:inline" />través de Yummi Pops, en una campaña de producto con causa que busca <br class="hidden md:inline" /><b>apoyar la atención integral de pacientes</b> con labio fisurado y paladar <br class="hidden md:inline" />hendido en Guatemala.
            </p>
          </div>
        </div>
        <!-- Niño y niña: los png traen margen transparente; se posicionan para que los personajes caigan donde el diseño -->
        <div class="reveal reveal-right reveal-delay-2 gt-kids">
          <img src={`${GT}/boy_gt.webp`} alt="Operación Sonrisa Guatemala - niño" class="gt-kids__boy" width="2243" height="2248" loading="lazy" decoding="async" />
          <img src={`${GT}/girl_gt.webp`} alt="Operación Sonrisa Guatemala - niña" class="gt-kids__girl" width="2243" height="2248" loading="lazy" decoding="async" />
        </div>
      </section>

      <!-- Sección del Contador -->
      <section id="counter" class="gt-counter">
        <p class="reveal reveal-left gt-counter__lead">
          <span class="font-gt-bold18">Llevamos</span><br/><span class="font-gt-bold15">en esta campaña</span>
        </p>

        <!-- Contador Digital -->
        <div class="reveal reveal-up reveal-delay-1 counter-display">
          <div class="counter-wrapper digital-counter" data-target="1000" aria-label="1000">
            <!-- Cero extra a la izquierda: queda apagado (is-off) porque la cifra solo usa 4 dígitos -->
            <span class="counter-digit is-off">0</span>
            <span class="counter-digit">1</span>
            <span class="counter-digit">0</span>
            <span class="counter-digit">0</span>
            <span class="counter-digit">0</span>
          </div>
        </div>

        <div class="reveal reveal-right reveal-delay-2 gt-counter__generated">
          <p class="font-gt-title gt-counter__sonrisas">Sonrisas</p>
          <p class="font-gt-bold18 gt-counter__generadas">generadas</p>
          <svg class="gt-smile gt-counter__smile" viewBox={`0 0 ${smiles.counter.w} ${smiles.counter.h}`} aria-hidden="true"><path d={smiles.counter.d} /></svg>
        </div>
      </section>

      <section id="conoce" class="gt-conoce">
        <img src={patternConoce} alt="" aria-hidden="true" class="gt-conoce__pattern" width="1920" height="316" loading="lazy" decoding="async" />
        <div class="reveal reveal-up gt-conoce__logo-wrap">
          <img src={`${GT}/header/logo_dark.webp`} alt="Operación Sonrisa Guatemala" class="gt-conoce__logo" width="2761" height="476" loading="lazy" decoding="async" />
        </div>
        <h1 class="reveal reveal-left font-gt-bold18 gt-conoce__title">Conoce más sobre la causa</h1>
        <div class="reveal reveal-up reveal-delay-1 gt-conoce__text">
          <p class="font-gt-text">
            Desde su llegada al país, Operación Sonrisa Guatemala <b>ha brindado más de 80,000 <br class="hidden md:inline" />consultas médicas</b> en sus dos Centros de atención integral, ubicados en la Ciudad <br class="hidden md:inline" />de Guatemala y Petén, y ha realizado <b>más de 2,100 cirugías gratuitas y seguras</b>, <br class="hidden md:inline" />transformando la vida de miles de pacientes y sus familias.
          </p>
          <p class="font-gt-text">
            Este año, Yummies se suma a la celebración de los 15 años de Fundación Operación <br class="hidden md:inline" />Sonrisa Guatemala, reconociendo una trayectoria de compromiso y acceso a atención <br class="hidden md:inline" />médica especializada para quienes más lo necesitan.
          </p>
        </div>
        <div class="gt-gallery">
          {gallery.map((g, i) => (
            <div class:list={['reveal gt-gallery__frame', i === 0 ? 'reveal-left' : i === 1 ? 'reveal-up reveal-delay-1' : 'reveal-right reveal-delay-2']}>
              <img src={`${GT}/fotos/${g.file}.webp`} alt="Operación Sonrisa Guatemala" width={g.w} height={g.h} loading="lazy" decoding="async" style={`left:${g.left};top:${g.top};width:${g.width}`} />
            </div>
          ))}
        </div>
      </section>

      <!-- Sección de Impacto -->
      <section id="impacto" class="gt-cifras animate-slide-up">
        <img src={patternCifras} alt="" aria-hidden="true" class="gt-cifras__pattern" width="1920" height="520" loading="lazy" decoding="async" />
        <div class="gt-cifras__head">
          <h3 class="gt-cifras__title">
            <span class="title-letters block font-gt-bold18 uppercase gt-cifras__title-a">Cifras</span>
            <span class="title-letters block font-gt-bold18 lowercase gt-cifras__title-b">de impacto</span>
          </h3>
          <svg class="gt-smile gt-cifras__smile" viewBox={`0 0 ${smiles.cifras.w} ${smiles.cifras.h}`} aria-hidden="true"><path d={smiles.cifras.d} /></svg>
        </div>

        <!-- Cifras de impacto GT: 3 columnas en desktop (anchos del diseño), filas en mobile -->
        <div class="gt-stats">
          <div class="gt-stats__col animate-item">
            <p class="gt-stats__number font-gt-bold18">
              <span class="count-up" data-target="2145" data-decimals="0">2,145</span>
            </p>
            <p class="gt-stats__label font-gt-medium15">cirugías<br/>en Guatemala.</p>
          </div>

          <div class="gt-stats__col animate-item">
            <p class="gt-stats__number font-gt-bold18">
              <span class="count-up" data-target="80000" data-decimals="0">80,000</span>
            </p>
            <p class="gt-stats__label font-gt-medium15">consultas en 8<br/>especialidades médicas<br/>en dos centros de atención.</p>
          </div>

          <div class="gt-stats__col animate-item">
            <p class="gt-stats__number font-gt-bold18">4 <span class="font-gt-bold15">DEPARTAMENTOS</span></p>
            <p class="gt-stats__label font-gt-medium15">Desarrollamos programas<br/>quirúrgicos en Guatemala,<br/>Escuintla, Petén y Totonicapán.</p>
          </div>
        </div>
      </section>

      <!-- Sección de Productos Participantes -->
      <section id="productos-participantes" class="gt-productos animate-slide-up">
        <!-- Desktop: título a la izquierda y caja de texto a la derecha que sale hasta el borde -->
        <div class="gt-productos__head">
          <div class="gt-productos__titlewrap">
            <h2 class="title-letters font-gt-bold18 gt-productos__title">
              Productos<br/>participantes
            </h2>
            <svg class="gt-smile gt-productos__smile" viewBox={`0 0 ${smiles.productos.w} ${smiles.productos.h}`} aria-hidden="true"><path d={smiles.productos.d} /></svg>
          </div>
          <!-- Colores y tamaños del primer bloque (sobre-la-causa), a pedido -->
          <div class="reveal reveal-right gt-productos__box">
            <p class="font-gt-title gt-productos__box-title">
              ¡Estos son los Yummi Pops<br class="hidden md:inline" /> que transforman vidas!
            </p>
            <p class="font-gt-text gt-productos__box-text">
              <b>Con cada compra apoyas a Operación Sonrisa Guatemala,</b><br class="hidden md:inline" /> brindando atención integral a pacientes con labio fisurado y paladar hendido.
            </p>
          </div>
        </div>

        <!-- Cada bolsa sobre tarjeta gris #f2f2f2 (diseño: 385x467, radio 68px, bolsa 263x375 centrada) -->
        <div class="gt-productos__grid">
          {products.map((p) => (
            <div class="gt-product animate-item">
              <div class="gt-product__card">
                <img src={`${GT}/productos/${p.file}.webp`} alt={p.alt} width="1052" height="1501" loading="lazy" decoding="async" />
              </div>
              <h3 class="font-gt-bold15 gt-product__name" style={`color:${p.color}`}>
                {p.name[0]}<br/>{p.name[1]}
              </h3>
            </div>
          ))}
        </div>
      </section>

      <!-- Sección Súmate a esta causa -->
      <section class="gt-sumate">
        <div class="gt-sumate__card">
          <!-- Mismo tamaño que ninomini (192x285); el png GT trae margen, se escala para que el niño ocupe el alto -->
          <div class="gt-sumate__kid gt-sumate__kid--boy">
            <img src={`${GT}/boy_gt.gif`} alt="Operación Sonrisa Guatemala - niño" width="2243" height="2248" loading="lazy" decoding="async" />
          </div>

          <div class="gt-sumate__center">
            <h2 class="font-gt-bold18 gt-sumate__title">
              Súmate a esta causa y ayúdanos<br class="hidden xl:inline" />
              a transformar más vidas con
            </h2>
            <div class="gt-sumate__logos">
              <img src={`${CDN}/Yummi-pops-3.webp`} alt="Yummi Pops" class="gt-sumate__ypops" width="300" height="300" loading="lazy" decoding="async" />
              <span class="gt-sumate__divider" aria-hidden="true"></span>
              <img src={`${GT}/header/logo.webp`} alt="Operación Sonrisa Guatemala" class="gt-sumate__os" width="1075" height="186" loading="lazy" decoding="async" />
            </div>
          </div>

          <!-- Mismo tamaño que ninamini (144x285); el png GT trae margen, se escala para que la niña ocupe el alto -->
          <div class="gt-sumate__kid gt-sumate__kid--girl">
            <img src={`${GT}/girl_gt.gif`} alt="Operación Sonrisa Guatemala - niña" width="2243" height="2248" loading="lazy" decoding="async" />
          </div>
        </div>
      </section>
    </article>
  </main>
</Layout>

<style>
  /* ---------- Base de medidas ---------- */
  .gt-page {
    container-type: inline-size;
    max-width: 1920px;
    margin-inline: auto;
    overflow-x: clip;
    --u: calc(100cqw / 1920);
    --gt-blue: #004e9d;
    --gt-blue-title: #0051a4;
    --gt-sky: #00b2f1;
    --gt-red: #e30a2e;
    /* El diseño no aplica kerning: las letras usan el ancho propio de la fuente */
    font-kerning: none;
  }

  /* Tracking +20 de Illustrator (0.02em) en los bloques de texto que lo llevan en el diseño */
  .gt-intro__title,
  .gt-intro__body,
  .gt-conoce__text,
  .gt-product__name,
  .gt-productos__box-title,
  .gt-productos__box-text {
    letter-spacing: 0.02em;
  }

  .gt-smile {
    display: block;
    fill: var(--gt-red);
    height: auto;
  }

  /* ---------- Header ---------- */
  .pcc-hero {
    --hero-title: url('https://snack.yummiespromociones.com/SnacksyummiesAssets/productosconcausagt/header/titulo.webp');
    position: relative;
    width: 100%;
    aspect-ratio: 100 / 76;
    overflow: hidden;
    container-type: inline-size;
  }

  .pcc-hero__bg {
    position: absolute;
    top: 0;
    left: -12%;
    width: 124%;
    max-width: none;
    height: auto;
  }

  /* El gif trae margen transparente; el personaje ocupa x 158–778 / y 147–835 de 1000 */
  .pcc-hero__logo {
    position: absolute;
    left: 1.5cqw;
    top: 7cqw;
    width: 40cqw;
    max-width: none;
    height: auto;
    opacity: 0;
    transform: scale(0.4) rotate(-12deg);
  }

  /* titulo.webp mide 3322x1772; cada línea muestra su franja de la imagen */
  .pcc-hero__title {
    position: absolute;
    left: 37.5cqw;
    top: 12.35cqw;
    width: 55cqw;
    aspect-ratio: 3322 / 1772;
    margin: 0;
  }

  .pcc-hero__line {
    position: absolute;
    inset: 0;
    background: var(--hero-title) no-repeat center / 100% 100%;
    opacity: 0;
    filter: blur(8px);
    transform: translateY(0.6cqw);
    -webkit-mask-image: linear-gradient(90deg, #000 40%, transparent 60%);
    mask-image: linear-gradient(90deg, #000 40%, transparent 60%);
    -webkit-mask-size: 250% 100%;
    mask-size: 250% 100%;
    -webkit-mask-position: 100% 0;
    mask-position: 100% 0;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  /* Cortes medidos sobre el alfa de titulo.webp */
  .pcc-hero__line--1 { clip-path: inset(0 0 64.3% 0); }
  .pcc-hero__line--2 { clip-path: inset(35.7% 0 42.1% 0); }
  .pcc-hero__line--3 { clip-path: inset(57.9% 0 0 0); }

  .pcc-hero__product {
    position: absolute;
    max-width: none;
    height: auto;
    opacity: 0;
    transform: translateY(12cqw) scale(0.85);
    filter: drop-shadow(0 1.2cqw 0.9cqw rgba(0, 0, 0, 0.3));
  }

  /* Mobile: fila de productos más ancha para que se lean en pantallas chicas */
  .pcc-hero__product--1 { left: 10.1%; width: 20.2%; bottom: 3.5%; z-index: 1; }
  .pcc-hero__product--2 { left: 28.4%; width: 21.1%; bottom: 2.8%; z-index: 2; }
  .pcc-hero__product--3 { left: 47.5%; width: 24.6%; bottom: 2%; z-index: 4; }
  .pcc-hero__product--4 { left: 70.2%; width: 19.8%; bottom: 3.5%; z-index: 3; }

  /* Desktop: posiciones del diseño. El fondo arranca en y=0 de la página (detrás del nav de 127px) */
  @media (min-width: 640px) {
    .pcc-hero {
      aspect-ratio: auto;
      height: calc(1123 * var(--u));
    }

    .pcc-hero__bg {
      top: calc(-127 * var(--u));
      left: 0;
      width: 100%;
    }

    .pcc-hero__logo {
      left: calc(310 * var(--u));
      top: calc(-31 * var(--u));
      width: calc(633 * var(--u));
    }

    .pcc-hero__title {
      left: calc(833.5 * var(--u));
      top: calc(89.7 * var(--u));
      width: calc(833 * var(--u));
    }

    .pcc-hero__product { bottom: auto; }
    .pcc-hero__product--1 { left: calc(383.1 * var(--u)); top: calc(621.5 * var(--u)); width: calc(310.6 * var(--u)); }
    .pcc-hero__product--2 { left: calc(652.5 * var(--u)); top: calc(593.3 * var(--u)); width: calc(335.6 * var(--u)); }
    .pcc-hero__product--3 { left: calc(937.5 * var(--u)); top: calc(567.9 * var(--u)); width: calc(359.1 * var(--u)); }
    .pcc-hero__product--4 { left: calc(1249.4 * var(--u)); top: calc(621.5 * var(--u)); width: calc(310.6 * var(--u)); }
  }

  .pcc-hero.visible .pcc-hero__product {
    animation: pccHeroProductIn 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) forwards,
      pccHeroProductFloat 5s ease-in-out infinite;
  }

  .pcc-hero.visible .pcc-hero__product--1 { animation-delay: 1.1s, 2s; }
  .pcc-hero.visible .pcc-hero__product--2 { animation-delay: 1.25s, 2.6s; }
  .pcc-hero.visible .pcc-hero__product--3 { animation-delay: 1.4s, 2.3s; }
  .pcc-hero.visible .pcc-hero__product--4 { animation-delay: 1.55s, 2.9s; }

  @keyframes pccHeroProductIn {
    0% { opacity: 0; transform: translateY(12cqw) scale(0.85); }
    50% { opacity: 1; }
    100% { opacity: 1; transform: none; }
  }

  @keyframes pccHeroProductFloat {
    0%, 100% { opacity: 1; transform: translateY(0); }
    50% { opacity: 1; transform: translateY(-0.6cqw); }
  }

  .pcc-hero.visible .pcc-hero__logo {
    animation: pccHeroLogoIn 1s cubic-bezier(0.34, 1.56, 0.64, 1) forwards,
      pccHeroFloat 4s ease-in-out 1.2s infinite;
  }

  .pcc-hero.visible .pcc-hero__line {
    animation: pccHeroLineIn 1.1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .pcc-hero.visible .pcc-hero__line--1 { animation-delay: 0.35s; }
  .pcc-hero.visible .pcc-hero__line--2 { animation-delay: 0.65s; }
  .pcc-hero.visible .pcc-hero__line--3 { animation-delay: 0.95s; }

  @keyframes pccHeroLogoIn {
    0% { opacity: 0; transform: scale(0.4) rotate(-12deg); }
    60% { opacity: 1; }
    100% { opacity: 1; transform: scale(1) rotate(0); }
  }

  @keyframes pccHeroFloat {
    0%, 100% { opacity: 1; transform: translateY(0); }
    50% { opacity: 1; transform: translateY(-0.8cqw); }
  }

  /* Barrido de izquierda a derecha, como el efecto letra por letra de los otros títulos */
  @keyframes pccHeroLineIn {
    0% {
      opacity: 0;
      filter: blur(8px);
      transform: translateY(0.6cqw);
      -webkit-mask-position: 100% 0;
      mask-position: 100% 0;
    }
    30% { opacity: 1; }
    100% {
      opacity: 1;
      filter: blur(0);
      transform: none;
      -webkit-mask-position: 0 0;
      mask-position: 0 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pcc-hero__logo,
    .pcc-hero__line,
    .pcc-hero__product,
    .pcc-hero.visible .pcc-hero__logo,
    .pcc-hero.visible .pcc-hero__line,
    .pcc-hero.visible .pcc-hero__product {
      animation: none;
      opacity: 1;
      transform: none;
      filter: none;
      -webkit-mask-image: none;
      mask-image: none;
    }


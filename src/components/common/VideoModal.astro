<script is:inline>
  function isYouTube(url) {
    if (!url) return false;
    return /youtu\.be|youtube\.com/.test(url);
  }

  function getYouTubeId(url) {
    if (!url) return '';
    const regExp = /^.*(youtu\.be\/|v\/|u\/\w\/|embed\/|watch\?v=|shorts\/|&v=)([^#&?]*).*/;
    const match = url.match(regExp);
    return (match && match[2].length === 11) ? match[2] : '';
  }

  function isYouTubeShort(url) {
    if (!url) return false;
    return /youtube\.com\/shorts\//.test(url) || /youtu\.be\/shorts\//.test(url);
  }

  function buildEmbedUrl(videoId) {
    const params = new URLSearchParams({
      autoplay: '1',
      controls: '1',
      playsinline: '1',
      rel: '0',
      modestbranding: '1'
    });
    return 'https://www.youtube.com/embed/' + videoId + '?' + params.toString();
  }

  function setDisplayMode(container, modal, mode) {
    modal.dataset.mode = mode;
    container.dataset.mode = mode;
    container.style.removeProperty('aspect-ratio');
  }

  function classifyDirectVideoRatio(width, height) {
    if (!width || !height) return 'direct-landscape';
    const ratio = width / height;
    if (ratio < 0.85) return 'direct-portrait';
    if (ratio > 1.2) return 'direct-landscape';
    return 'direct-square';
  }

  function applyDirectVideoSizing(videoEl, container, modal) {
    function updateSizing() {
      const w = videoEl.videoWidth;
      const h = videoEl.videoHeight;
      const mode = classifyDirectVideoRatio(w, h);
      setDisplayMode(container, modal, mode);
      if (mode === 'direct-square' && w && h) {
        container.style.aspectRatio = w + ' / ' + h;
      }
    }

    if (videoEl.readyState >= 1) {
      updateSizing();
    } else {
      videoEl.addEventListener('loadedmetadata', updateSizing, { once: true });
    }
  }

  window.openVideoModal = function(url) {
    if (!url) return;
    const modal = document.getElementById('video-modal-overlay');
    const container = document.getElementById('video-modal-container');
    const iframe = document.getElementById('video-modal-iframe');
    const videoPlayer = document.getElementById('video-modal-player');
    if (!modal || !container) return;

    if (isYouTube(url)) {
      const videoId = getYouTubeId(url);
      if (!videoId) return;

      if (videoPlayer) {
        videoPlayer.pause();
        videoPlayer.src = '';
        videoPlayer.removeAttribute('src');
        videoPlayer.load();
        videoPlayer.classList.add('hidden');
      }

      if (iframe) {
        const mode = isYouTubeShort(url) ? 'youtube-shorts' : 'youtube-landscape';
        setDisplayMode(container, modal, mode);
        iframe.src = buildEmbedUrl(videoId);
        iframe.classList.remove('hidden');
      }
    } else {
      if (iframe) {
        iframe.src = '';
        iframe.classList.add('hidden');
      }

      setDisplayMode(container, modal, 'direct-landscape');

      if (videoPlayer) {
        videoPlayer.src = url;
        videoPlayer.classList.remove('hidden');
        applyDirectVideoSizing(videoPlayer, container, modal);
        videoPlayer.play().catch(function(err) {
          console.warn('Autoplay prevented by browser:', err);
        });
      }
    }

    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  };

  window.closeVideoModal = function() {
    const modal = document.getElementById('video-modal-overlay');
    const container = document.getElementById('video-modal-container');
    const iframe = document.getElementById('video-modal-iframe');
    const videoPlayer = document.getElementById('video-modal-player');
    if (!modal || !container) return;

    if (iframe) {
      iframe.src = '';
      iframe.classList.add('hidden');
    }

    if (videoPlayer) {
      videoPlayer.pause();
      videoPlayer.src = '';
      videoPlayer.removeAttribute('src');
      videoPlayer.load();
      videoPlayer.classList.add('hidden');
    }

    setDisplayMode(container, modal, 'default');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
  };

  document.addEventListener('click', function(e) {
    const modal = document.getElementById('video-modal-overlay');
    if (e.target === modal) {
      window.closeVideoModal();
    }
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      window.closeVideoModal();
    }
  });
</script>

<div
  id="video-modal-overlay"
  data-mode="default"
  class="video-modal-overlay hidden fixed inset-0 z-[100] items-center justify-center bg-black/80 backdrop-blur-sm p-4"
  onclick="if(event.target===this)window.closeVideoModal()"
>
  <div
    id="video-modal-container"
    data-mode="default"
    class="video-modal-container relative bg-black rounded-xl shadow-2xl"
  >
    <button
      type="button"
      onclick="window.closeVideoModal()"
      class="video-modal-close absolute z-20 flex items-center justify-center text-white bg-black/60 hover:bg-black/80 rounded-full transition-colors"
      aria-label="Close video"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <iframe
      id="video-modal-iframe"
      class="video-modal-iframe hidden w-full h-full"
      frameborder="0"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen"
      allowfullscreen
    ></iframe>
    <video
      id="video-modal-player"
      class="video-modal-player hidden w-full h-full object-contain"
      controls
      playsinline
      preload="metadata"
    ></video>
  </div>
</div>

<style>
  .video-modal-container {
    overflow: hidden;
  }

  .video-modal-iframe,
  .video-modal-player {
    display: block;
    border: none;
  }

  .video-modal-close {
    top: 0.5rem;
    right: 0.5rem;
    width: 2.25rem;
    height: 2.25rem;
  }

  /* YouTube landscape 16:9 */
  #video-modal-container[data-mode='youtube-landscape'],
  #video-modal-container[data-mode='direct-landscape'] {
    aspect-ratio: 16 / 9;
    width: min(90vw, calc(85vh * 16 / 9));
    max-height: 85vh;
  }

  /* YouTube Shorts & portrait videos 9:16 */
  #video-modal-container[data-mode='youtube-shorts'],
  #video-modal-container[data-mode='direct-portrait'] {
    aspect-ratio: 9 / 16;
    height: min(85vh, calc(90vw * 16 / 9));
    width: auto;
    max-width: 90vw;
  }

  /* Square or near-square direct videos */
  #video-modal-container[data-mode='direct-square'] {
    width: min(90vw, 85vh);
    max-height: 85vh;
  }

  @media (max-width: 767px) {
    #video-modal-container[data-mode='youtube-shorts'],
    #video-modal-container[data-mode='direct-portrait'] {
      height: min(92dvh, calc(100vw * 16 / 9));
      max-width: 100vw;
      border-radius: 0.75rem;
    }

    #video-modal-container[data-mode='youtube-landscape'],
    #video-modal-container[data-mode='direct-landscape'] {
      width: min(100vw, calc(85dvh * 16 / 9));
      max-height: 85dvh;
    }

    .video-modal-close {
      top: calc(0.5rem + env(safe-area-inset-top, 0px));
      right: calc(0.5rem + env(safe-area-inset-right, 0px));
    }
  }
</style>

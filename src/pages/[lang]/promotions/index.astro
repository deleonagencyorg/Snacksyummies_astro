---
import { resolveStaticPath } from '../../../utils/staticPaths';
// src/pages/[lang]/promotions/index.astro
import { setLocale, t, type Locale } from '../../../i18n/i18n';
import MainLayout from '../../../layouts/MainLayout.astro';
import { getPageBySlug } from '../../../services/api/pages';
import PromotionsView from '../../../views/Promotions/index.astro';

export async function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } }
  ];
}

const staticPath = await resolveStaticPath(getStaticPaths, Astro.params);
if (!staticPath) {
  return Astro.rewrite('/404');
}

const { lang } = Astro.params as { lang: Locale };

setLocale(lang);

// Obtener metadatos
const seoPage = await getPageBySlug(lang === 'es' ? 'promociones' : 'promotions', lang);
const seoTitle = seoPage?.metaTitle || seoPage?.title || '';
const seoDescription = seoPage?.metaDescription || seoPage?.excerpt || '';
const metaTitle = seoTitle;
const metaDescription = seoDescription;
---

<MainLayout title={metaTitle} description={metaDescription}>
  <PromotionsView currentLang={lang} />
</MainLayout>

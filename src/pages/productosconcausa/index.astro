---
import Layout from '../../layouts/ProductosConCausaLayout.astro';
import LazyImage from '../../components/common/LazyImage.astro';
import { ViewTransitions } from 'astro:transitions';
import patternConoce from '../../assets/productosconcausahn/pattern-conoce.svg?url';
import '../../styles/title-letters.css';
import '../../styles/pcc-gt-fonts.css';

const CDN = 'https://snack.yummiespromociones.com/SnacksyummiesAssets';
const HN = `${CDN}/productosconcausahn`;

// Sonrisas rojas del diseño (YPOPS-CAUSA_WEB-LAYOUT-HN.ai), exportadas del vector original
const smiles = {
  counter: { w: 254.5, h: 75.3, d: 'M0 0.6C46.7 32.8 104.8 42.1 160.1 35.5C182 33 203.5 27.5 223.5 18.1C233.8 13.2 243.9 7.2 252.8 0L254.5 1.1C247.4 18.8 233 32.5 217.5 42.9C171.3 73.1 102.8 75.3 53.7 50.9C31.8 39.8 10.8 22.9 0 0.6Z' },
  productos: { w: 360.4, h: 106.4, d: 'M0 0.6C50.6 41.2 116 59.5 180.3 59.2C236.2 59.1 292.9 47.7 339.5 15.5C346.2 10.8 352.8 5.7 358.7 0L360.4 1.1C353 17 340.9 30 327.7 41.4C250.3 106.4 110.5 104.8 33.6 39.5C20.5 28.3 8.3 15.7 0 0.6Z' },
};

const products = [
  { file: 'ypops-nacho-jalapeno_osh-hn', h: 3877, alt: 'Yummi Pops Nacho Jalapeño Cream', name: ['Yummi Pops Nacho', 'Jalapeño Cream'], color: '#00bf00' },
  { file: 'ypops-nacho-queso_osh-hn', h: 3872, alt: 'Yummi Pops Nacho Queso Blanco', name: ['Yummi Pops Nacho', 'Queso Blanco'], color: '#00b2f1' },
  { file: 'ypops-queso_osh-hn', h: 3876, alt: 'Yummi Pops Queso', name: ['Yummi Pops', 'Queso'], color: '#ff6500' },
  { file: 'ypops-sal_osh', h: 3877, alt: 'Yummi Pops Sal Marina', name: ['Yummi Pops', 'Sal Marina'], color: '#005ab2' },
];

// Fotos de "Conoce más": posición y escala de cada foto dentro de su marco, medidas sobre el diseño
const gallery = [
  { file: '77e31eed-3bb2-4292-910f-bd4ff5ae9bd8', w: 1464, h: 1135, left: '-1.74%', top: '-12.1%', width: '107.72%', alt: 'Entrega de donativo a Operación Sonrisa Honduras' },
  { file: '94d5c629-2380-4e5a-986c-990fe437c64c', w: 1123, h: 709, left: '-5.21%', top: '-0.86%', width: '111.2%', alt: 'Equipo de Operación Sonrisa Honduras' },
  { file: '1fef6d9d-7657-46f1-bd8a-9332d61e653d', w: 1600, h: 1120, left: '-6.95%', top: '-1.73%', width: '107.72%', alt: 'Familias apoyadas por Operación Sonrisa Honduras' },
];
---

<Layout
  title="Productos con Causa Yummi Pops | Operación Sonrisa Honduras" 
  description="Descubre la alianza de Yummi Pops y Operación Sonrisa Honduras: productos con causa que financian cirugías, clínicas y miles de sonrisas transformadas.">
  <ViewTransitions slot="head" />
  <!--
    Medidas del diseño YPOPS-CAUSA_WEB-LAYOUT-HN.ai (mesa de trabajo de 1920px).
    En desktop las secciones del diseño se escalan con --u (1px del diseño = 100cqw / 1920), así a 1920 coincide 1:1.
  -->
  <main class="hn-page">
    <article class="w-full">
       <!-- Header HN (YPOPS-CAUSA_WEB-LAYOUT-HN.ai): fondo fijo + listón que se llena de izq. a der. + productos + 10 años flotando al final -->
       <header id="inicio" class="hn-hero">
         <img src={`${HN}/header/header_bg.webp`} alt="" aria-hidden="true" class="hn-hero__bg" width="16383" height="10102" loading="eager" fetchpriority="high" decoding="async" />
         <img src={`${HN}/header/sonrisas.webp`} alt="Sumando sonrisas" class="hn-hero__ribbon" width="16383" height="6566" loading="eager" decoding="async" />
         <img src={`${HN}/products/ypops-nacho-jalapeno_osh-hn.webp`} alt="Yummi Pops Nacho Jalapeño Cream" class="hn-hero__product hn-hero__product--1" width="2626" height="3877" loading="eager" decoding="async" />
         <img src={`${HN}/products/ypops-nacho-queso_osh-hn.webp`} alt="Yummi Pops Nacho Queso Blanco" class="hn-hero__product hn-hero__product--2" width="2626" height="3872" loading="eager" decoding="async" />
         <img src={`${HN}/products/ypops-queso_osh-hn.webp`} alt="Yummi Pops Palomitas de Maíz Queso" class="hn-hero__product hn-hero__product--3" width="2626" height="3876" loading="eager" decoding="async" />
         <img src={`${HN}/products/ypops-sal_osh.webp`} alt="Yummi Pops Palomitas de Maíz Sal Marina" class="hn-hero__product hn-hero__product--4" width="2626" height="3877" loading="eager" decoding="async" />
         <!-- Flotado en el contenedor y entrada en la imagen: cada transform en su propio elemento, sin saltos al pasar de una animación a otra -->
         <div class="hn-hero__years">
           <img src={`${HN}/header/10_years.webp`} alt="10 años Yummi Pops y Operación Sonrisa Honduras" class="hn-hero__years-img" width="16383" height="10022" loading="eager" decoding="async" />
         </div>
       </header>

      <!-- ¡Celebramos 10 años…! (medidas de YPOPS-CAUSA_WEB-LAYOUT-HN.ai) -->
      <section id="sobre-la-causa" class="hn-intro">
        <div class="hn-intro__text">
          <h2 class="reveal reveal-left font-gt-title hn-intro__title">
            ¡Celebramos 10 años unidos <br class="hidden md:inline" />por la sonrisa de miles de niños!
          </h2>
          <div class="reveal reveal-up reveal-delay-1 hn-intro__body">
            <p class="font-gt-text">
              Gracias a ti, <b>Yummi Pops y Operación Sonrisa Honduras</b> <br class="hidden md:inline" />continúan transformando el futuro de miles de niños y niñas <br class="hidden md:inline" />con labio y paladar hendido mediante <b>cirugías <br class="hidden md:inline" />y tratamientos gratuitos.</b>
            </p>
            <p class="font-gt-text"><b>¡Súmate hoy, cada Yummi Pops cuenta!</b></p>
          </div>
        </div>
        <!-- Niño y niña (gif 750x750 con margen transparente): se ubican para que los personajes caigan donde el diseño -->
        <div class="reveal reveal-right reveal-delay-2 hn-kids">
          <img src={`${HN}/nino-osh.gif`} alt="Operación Sonrisa Honduras - niño" class="hn-kids__boy" width="750" height="750" loading="lazy" decoding="async" />
          <img src={`${HN}/nina-osh.gif`} alt="Operación Sonrisa Honduras - niña" class="hn-kids__girl" width="750" height="750" loading="lazy" decoding="async" />
        </div>
      </section>

      <!-- Sección del Contador -->
      <section id="counter" class="hn-counter">
        <p class="reveal reveal-left hn-counter__lead">
          <span class="font-gt-bold18">Llevamos</span><br/><span class="font-gt-bold15">en esta campaña</span>
        </p>

        <div class="reveal reveal-up reveal-delay-1 counter-display">
          <div class="counter-wrapper digital-counter" data-target="12334" aria-label="12,334">
            <span class="counter-digit">1</span>
            <span class="counter-digit">2</span>
            <span class="counter-separator">,</span>
            <span class="counter-digit">3</span>
            <span class="counter-digit">3</span>
            <span class="counter-digit">4</span>
          </div>
        </div>

        <div class="reveal reveal-right reveal-delay-2 hn-counter__generated">
          <p class="font-gt-title hn-counter__sonrisas">Sonrisas</p>
          <p class="font-gt-bold18 hn-counter__generadas">generadas</p>
          <svg class="hn-smile hn-counter__smile" viewBox={`0 0 ${smiles.counter.w} ${smiles.counter.h}`} aria-hidden="true"><path d={smiles.counter.d} /></svg>
        </div>
      </section>

      <!-- Conoce más sobre la causa -->
      <section id="conoce" class="hn-conoce">
        <img src={patternConoce} alt="" aria-hidden="true" class="hn-conoce__pattern" width="1920" height="517" loading="lazy" decoding="async" />
        <div class="reveal reveal-up hn-conoce__logo-wrap">
          <img src={`${HN}/logo-sonrisa-light.webp`} alt="Operación Sonrisa Honduras" class="hn-conoce__logo" width="2200" height="385" loading="lazy" decoding="async" />
        </div>
        <h1 class="reveal reveal-left font-gt-bold18 hn-conoce__title">Conoce más sobre la causa</h1>
        <div class="reveal reveal-up reveal-delay-1 hn-conoce__text">
          <p class="font-gt-text">
            <b class="hn-hl">1 de cada 500 niños</b> nace con labio y/o paladar hendido, una condición que impacta <br class="hidden md:inline" />no solo su sonrisa, sino también su capacidad para alimentarse, hablar y oír con <br class="hidden md:inline" />normalidad.
          </p>
          <p class="font-gt-text">
            Aun así, con una cirugía a tiempo y el acompañamiento adecuado, pueden recuperar <br class="hidden md:inline" />su salud, su desarrollo y su confianza.
          </p>
          <p class="font-gt-text hn-conoce__closing">
            <b class="hn-hl">Snacks Yummies y tú</b> <b>pueden crear sonrisas que transforman vidas.</b>
          </p>
        </div>
        <!-- Marco blanco de 7px con radio 41.5px; cada foto recortada como en el diseño -->
        <div class="hn-gallery">
          {gallery.map((g, i) => (
            <div class:list={['reveal', 'reveal-up', i === 1 && 'reveal-delay-1', i === 2 && 'reveal-delay-2', 'hn-gallery__frame']}>
              <img src={`${HN}/${g.file}.webp`} alt={g.alt} width={g.w} height={g.h} loading="lazy" decoding="async" style={`left:${g.left};top:${g.top};width:${g.width}`} />
            </div>
          ))}
        </div>
        <div class="reveal reveal-up hn-conoce__cta">
          <a href="/productosconcausa/historia" class="font-gt-title hn-conoce__btn">Conoce nuestra historia</a>
        </div>
      </section>

      <!-- Sección de Impacto -->
      <section id="impacto" class="container mx-auto px-4 py-12 md:py-16 animate-slide-up">
        <!-- Título Principal -->
        <div class="text-center mb-8 md:mb-12">
          <h2 class="text-primary font-title font-bold text-3xl md:text-5xl lg:text-6xl mb-2 md:mb-4">
            Nuestro impacto<br/>trabajando juntos
          </h2>
          <p class="text-red font-bold text-base md:text-xl lg:text-2xl">
            sonrisas que transforman vidas
          </p>
        </div>

        <!-- Indicadores -->
        <div class="mb-8 md:mb-12">
          <div class="w-full flex justify-center items-center mb-6 md:mb-8">
            <div class="flex flex-col items-center">
              <h4 class="title-letters font-title font-bold text-sky-400 text-3xl md:text-4xl lg:text-8xl">Indicadores</h4>
              <LazyImage src="https://snack.yummiespromociones.com/SnacksyummiesAssets/sonrisa.webp" alt="Operación Sonrisas Honduras" class="p-4 md:p-0 max-w-32 lg:max-w-64" />
            </div>
          </div>
          
          <!-- Grid de Indicadores - 3 columnas en desktop, filas en mobile -->
          <div class="bg-gray-100 rounded-3xl p-6 md:p-8 lg:p-10">
            <div class="flex flex-col md:flex-row md:divide-x md:divide-gray-300 gap-6 md:gap-0">
              <!-- Indicador 1 -->
              <div class="flex-1 text-center px-4 animate-item">
                <p class="text-primary font-title font-bold text-4xl md:text-5xl lg:text-6xl mb-2">
                  <span class="count-up" data-target="17" data-decimals="0">17</span> eventos
                </p>
                <p class="text-sky-400 font-semibold text-sm md:text-base lg:text-lg">
                  de recaudación de<br/>fondos en conjunto.
                </p>
              </div>

              <!-- Indicador 2 -->
              <div class="flex-1 text-center px-4 animate-item">
                <p class="text-primary font-title font-bold text-4xl md:text-5xl lg:text-6xl mb-2">
                  <span class="count-up" data-target="10" data-decimals="0">10</span> años
                </p>
                <p class="text-sky-400 font-semibold text-sm md:text-base lg:text-lg">
                  trabajando en conjunto<br/>en el área de la salud,<br/>transformando sonrisas
                </p>
              </div>

              <!-- Indicador 3 -->
              <div class="flex-1 text-center px-4 animate-item">
                <p class="text-primary font-title font-bold text-4xl md:text-5xl lg:text-6xl mb-2">
                  <span class="count-up" data-target="14" data-decimals="0">14</span> misiones
                </p>
                <p class="text-sky-400 font-semibold text-sm md:text-base lg:text-lg">
                  apoyadas desde el 2016
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Donativos (Opción 1: montos en horizontal como Indicadores → Clínica Dental → 183) -->
        <div class="w-full flex justify-center items-center mb-6 md:mb-8">
          <div class="flex flex-col items-center">
            <h3 class="title-letters font-title font-bold text-sky-400 text-3xl md:text-4xl lg:text-8xl text-center">
              Donativos
            </h3>
            <p class="text-red font-bold text-base md:text-lg lg:text-xl mb-2 text-center">
              2018 - actualidad
            </p>
            <LazyImage src="https://snack.yummiespromociones.com/SnacksyummiesAssets/sonrisa.webp" alt="Operación Sonrisas Honduras" class="p-4 md:p-0 max-w-32 lg:max-w-64 mx-auto" />
          </div>
        </div>

        <!-- Montos en Lempiras - 3 columnas en desktop, filas en mobile -->
        <div class="bg-gray-100 rounded-3xl p-6 md:p-8 lg:p-10">
          <div class="flex flex-col md:flex-row md:divide-x md:divide-gray-300 gap-6 md:gap-0">
            <!-- Monto 1 -->
            <div class="flex-1 text-center px-4 animate-item">
              <p class="text-primary font-title font-bold text-4xl md:text-3xl lg:text-4xl xl:text-5xl mb-2 whitespace-nowrap">
                <span class="text-[0.6em] mr-1">L</span><span class="count-up" data-target="331252.41" data-decimals="2">331,252.41</span>
              </p>
              <p class="text-sky-400 font-semibold text-sm md:text-base lg:text-lg">
                en especie
              </p>
            </div>

            <!-- Monto 2 -->
            <div class="flex-1 text-center px-4 animate-item">
              <p class="text-primary font-title font-bold text-4xl md:text-3xl lg:text-4xl xl:text-5xl mb-2 whitespace-nowrap">
                <span class="text-[0.6em] mr-1">L</span><span class="count-up" data-target="3807150" data-decimals="0">3,807,150</span>
              </p>
              <p class="text-sky-400 font-semibold text-sm md:text-base lg:text-lg">
                en efectivo
              </p>
            </div>

            <!-- Monto 3 -->
            <div class="flex-1 text-center px-4 animate-item">
              <p class="text-primary font-title font-bold text-4xl md:text-3xl lg:text-4xl xl:text-5xl mb-2 whitespace-nowrap">
                <span class="text-[0.6em] mr-1">L</span><span class="count-up" data-target="253174.64" data-decimals="2">253,174.64</span>
              </p>
              <p class="text-sky-400 font-semibold text-sm md:text-base lg:text-lg">
                en infraestructura
              </p>
            </div>
          </div>
        </div>

        <!-- Destino del monto: Clínica Dental → Mayo 2022 → 5,707 consultas -->
        <div class="bg-gray-100 rounded-3xl p-6 md:p-8 lg:p-10 mt-6 md:mt-8">
            <div class="flex flex-col md:flex-row  gap-6 md:gap-0">
              <!-- Indicador 1 -->
              <div class="flex-1 text-center px-4 animate-item">
                 <p class="text-sky-400 font-semibold text-xl md:text-base lg:text-2xl">
                  Este monto se invirtió en
                </p>
                <p class="text-primary font-title font-bold text-4xl md:text-5xl lg:text-6xl mb-2">
                  Clínica Dental
                </p>
               
              </div>
              <!-- Flecha 1 (solo desktop) -->
              <div class="hidden md:flex items-center justify-center px-2">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-8 h-8 text-gray-400">
                  <path fill="currentColor" d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z" />
                </svg>
              </div>

              <!-- Indicador 2 -->
              <div class="flex-1 text-center px-4 animate-item">
                 <p class="text-sky-400 font-semibold text-xl md:text-base lg:text-2xl">
                  La cual se aperturó
                </p>
                <p class="text-primary font-title font-bold text-4xl md:text-5xl lg:text-6xl mb-2">
                  Mayo<br/>2022
                </p>
               
              </div>
              <!-- Flecha 2 (solo desktop) -->
              <div class="hidden md:flex items-center justify-center px-2">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-8 h-8 text-gray-400">
                  <path fill="currentColor" d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z" />
                </svg>
              </div>

              <!-- Indicador 3 -->
              <div class="flex-1 text-center px-4 animate-item">
                 <p class="text-sky-400 font-semibold text-xl md:text-base lg:text-2xl">
                  y ha brindado un total de
                </p>
                <p class="text-primary font-title font-bold text-4xl md:text-5xl lg:text-6xl mb-2">
                 <span class="count-up" data-target="5707" data-decimals="0">5,707</span> <br/>consultas
                </p>
               
              </div>
            </div>
          </div>

        <!-- Impacto: 183 niños y niñas -->
        <div class="text-center mt-10 md:mt-14 animate-item">
          <p class="text-sky-400 font-semibold text-base md:text-lg lg:text-2xl mb-2 md:mb-4">
            Este apoyo ha transformado<br/>la sonrisa y la vida de
          </p>
          <p class="text-primary font-title font-bold text-6xl md:text-7xl lg:text-8xl mb-2 md:mb-4">
            <span class="count-up" data-target="183" data-decimals="0">183</span>
          </p>
          <p class="text-sky-400 font-semibold text-base md:text-lg lg:text-2xl">
            niños y niñas
          </p>
        </div>
      </section>

      <!-- Sección de Productos Participantes -->
      <section id="productos-participantes" class="hn-productos animate-slide-up">
        <!-- Desktop: título a la izquierda y caja de texto a la derecha que sale hasta el borde -->
        <div class="hn-productos__head">
          <div class="hn-productos__titlewrap">
            <h2 class="title-letters font-gt-bold18 hn-productos__title">
              Productos<br/>participantes
            </h2>
            <svg class="hn-smile hn-productos__smile" viewBox={`0 0 ${smiles.productos.w} ${smiles.productos.h}`} aria-hidden="true"><path d={smiles.productos.d} /></svg>
          </div>
          <div class="reveal reveal-right hn-productos__box">
            <p class="font-gt-title hn-productos__box-title">
              ¡Estos son los Yummi Pops<br class="hidden md:inline" /> que transforman vidas!
            </p>
            <p class="font-gt-text hn-productos__box-text">
              <b>Con cada compra apoyas a Operación Sonrisa Honduras,</b><br class="hidden md:inline" /> brindando cirugías y tratamiento integral a niños y niñas con<br class="hidden md:inline" /> labio y paladar hendido.
            </p>
          </div>
        </div>

        <!-- Cada bolsa sobre tarjeta gris #f2f2f2 (diseño: 385x467, radio 68px, bolsa de 375px de alto centrada) -->
        <div class="hn-productos__grid">
          {products.map((p) => (
            <div class="hn-product animate-item">
              <div class="hn-product__card">
                <img src={`${HN}/products/${p.file}.webp`} alt={p.alt} width="2626" height={p.h} loading="lazy" decoding="async" />
              </div>
              <h3 class="font-gt-bold15 hn-product__name" style={`color:${p.color}`}>
                {p.name[0]}<br/>{p.name[1]}
              </h3>
            </div>
          ))}
        </div>
      </section>

      <!-- Sección Súmate a esta causa -->
      <section class="hn-sumate">
        <div class="hn-sumate__card">
          <div class="hn-sumate__kid hn-sumate__kid--boy">
            <img src={`${HN}/nino-osh.gif`} alt="Operación Sonrisa Honduras - niño" width="750" height="750" loading="lazy" decoding="async" />
          </div>

          <div class="hn-sumate__center">
            <h2 class="font-gt-bold18 hn-sumate__title">
              Súmate a esta causa y ayúdanos<br class="hidden xl:inline" />
              a transformar más vidas con
            </h2>
            <div class="hn-sumate__logos">
              <img src={`${CDN}/Yummi-pops-3.webp`} alt="Yummi Pops" class="hn-sumate__ypops" width="300" height="300" loading="lazy" decoding="async" />
              <span class="hn-sumate__divider" aria-hidden="true"></span>
              <img src={`${CDN}/logooperacionsonrisas.webp`} alt="Operación Sonrisa Honduras" class="hn-sumate__os" width="2200" height="385" loading="lazy" decoding="async" />
            </div>
          </div>

          <div class="hn-sumate__kid hn-sumate__kid--girl">
            <img src={`${HN}/nina-osh.gif`} alt="Operación Sonrisa Honduras - niña" width="750" height="750" loading="lazy" decoding="async" />
          </div>
        </div>
      </section>

      <!-- Sección Testimonios (Blanca) -->
      <section id="testimonios" class="bg-gray-50 py-12 md:py-16 lg:py-20 animate-slide-up">
        <div class="container mx-auto px-4">
          <!-- Título -->
          <h2 class="title-letters text-primary font-title font-bold text-4xl md:text-5xl lg:text-6xl mb-10 md:mb-14 lg:mb-16">
            Testimonios
          </h2>

          <!-- Grid de Videos -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 lg:gap-10">
            <!-- Testimonio 1 -->
            <div class="bg-white rounded-2xl p-4 md:p-5 shadow-lg animate-item">
              <!-- Avatar y Nombre -->
              <div class="flex items-center gap-3 mb-4">
                <div class="w-12 h-12 md:w-14 md:h-14 rounded-full bg-gray-300 flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 md:w-7 md:h-7 text-gray-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
                  </svg>
                </div>
                <div class="overflow-hidden">
                  <p
                    title="¡9 años de la mano!"
                    class="font-bold text-ellipsis overflow-hidden whitespace-nowrap text-sm md:text-base">
                    ¡9 años de la mano!
                  </p>
                  <p class="text-xs md:text-sm text-gray-600">Ana María Kafie<br />– Presidente de la Junta Directiva Operación Sonrisa</p>
                </div>
              </div>

              <!-- Video Placeholder -->

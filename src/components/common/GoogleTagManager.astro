---
const gtmId = import.meta.env.PUBLIC_GTM_ID || '';
const gtmEnabled = /^GTM-[A-Z0-9]+$/i.test(gtmId) && gtmId.toUpperCase() !== 'GTM-XXXXXX';

if (!gtmEnabled) {
  console.warn('GTM ID no está configurado correctamente. Verifica PUBLIC_GTM_ID.');
}
---

{gtmEnabled && (
  <>
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
    <!-- Inline y con insertBefore, igual que el snippet de Tag Manager.
         Si es un módulo de Astro o se agrega con appendChild, la vista previa no se conecta. -->
    <script is:inline define:vars={{ gtmId }}>
      (function (w, d, s, l, i) {
        if (!i) return;
        w[l] = w[l] || [];

        if (!w.__gtmInjected) {
          w.__gtmInjected = true;
          w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          var f = d.getElementsByTagName(s)[0];
          var j = d.createElement(s);
          var dl = l != 'dataLayer' ? '&l=' + l : '';
          var params = '';
          var search = w.location.search || '';
          ['gtm_auth', 'gtm_preview', 'gtm_cookies_win', 'gtm_debug', '_dbg'].forEach(function (key) {
            var match = new RegExp('[?&]' + key + '=([^&]*)').exec(search);
            if (match) params += '&' + key + '=' + match[1];
          });
          j.async = true;
          j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl + params;
          j.setAttribute('data-gtm', i);
          if (f && f.parentNode) f.parentNode.insertBefore(j, f);
          else d.head.appendChild(j);
          d.documentElement.appendChild(j);
        }

        if (w.__gtmNavBound) return;
        w.__gtmNavBound = true;
        var lastPath = w.location.pathname + w.location.search;
        d.addEventListener('astro:page-load', function () {
          var path = w.location.pathname + w.location.search;
          if (path === lastPath) return;
          lastPath = path;
          w[l].push({
            event: 'virtual_page_view',
            page_location: w.location.href,
            page_path: path,
            page_title: d.title
          });
        });
      })(window, document, 'script', 'dataLayer', gtmId);
    </script>
  </>
)}

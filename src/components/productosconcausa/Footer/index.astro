  { name: 'Instagram', url: 'https://www.instagram.com/snacksyummies/', w: 32.4, h: 34.8, svg: '<g transform="translate(-91.5 0.0)"><path d="M107.7 0.2C103.3 0.2 102.7 0.3 101 0.3C99.3 0.4 98.1 0.7 97.1 1.1C96 1.6 95.1 2.2 94.2 3.1C93.3 4.1 92.7 5 92.3 6.2C91.9 7.3 91.7 8.5 91.6 10.3C91.5 12.2 91.5 12.8 91.5 17.4C91.5 22.1 91.5 22.7 91.6 24.5C91.7 26.3 91.9 27.6 92.3 28.7C92.7 29.8 93.3 30.8 94.2 31.7C95.1 32.7 96 33.3 97.1 33.7C98.1 34.1 99.3 34.4 101 34.5C102.7 34.6 103.3 34.6 107.7 34.6C112 34.6 112.6 34.6 114.3 34.5C116 34.4 117.2 34.1 118.2 33.7C119.3 33.3 120.2 32.7 121.1 31.7C122 30.8 122.6 29.8 123 28.7C123.4 27.6 123.7 26.3 123.7 24.5C123.8 22.7 123.8 22.1 123.8 17.4C123.8 12.8 123.8 12.2 123.7 10.3C123.7 8.5 123.4 7.3 123 6.2C122.6 5 122 4.1 121.1 3.1C120.2 2.2 119.3 1.6 118.2 1.1C117.2 0.7 116 0.4 114.3 0.3C112.6 0.3 112 0.2 107.7 0.2M107.7 3.3C112 3.3 112.5 3.4 114.2 3.4C115.8 3.5 116.6 3.8 117.2 4C117.9 4.3 118.5 4.7 119.1 5.3C119.6 5.9 120 6.5 120.3 7.3C120.5 7.9 120.7 8.8 120.8 10.5C120.9 12.3 120.9 12.8 120.9 17.4C120.9 22 120.9 22.6 120.8 24.4C120.7 26.1 120.5 27 120.3 27.6C120 28.4 119.6 28.9 119.1 29.5C118.5 30.1 117.9 30.5 117.2 30.8C116.6 31.1 115.8 31.3 114.2 31.4C112.5 31.5 112 31.5 107.7 31.5C103.3 31.5 102.8 31.5 101.1 31.4C99.5 31.3 98.7 31.1 98.1 30.8C97.4 30.5 96.8 30.1 96.3 29.5C95.7 28.9 95.3 28.4 95 27.6C94.8 27 94.6 26.1 94.5 24.4C94.4 22.6 94.4 22 94.4 17.4C94.4 12.8 94.4 12.3 94.5 10.5C94.6 8.8 94.8 7.9 95 7.3C95.3 6.5 95.7 5.9 96.3 5.3C96.8 4.7 97.4 4.3 98.1 4C98.7 3.8 99.5 3.5 101.1 3.4C102.8 3.4 103.3 3.3 107.7 3.3Z"/><path d="M107.7 23.2C104.7 23.2 102.3 20.6 102.3 17.4C102.3 14.3 104.7 11.7 107.7 11.7C110.6 11.7 113 14.3 113 17.4C113 20.6 110.6 23.2 107.7 23.2M107.7 8.6C103.1 8.6 99.3 12.6 99.3 17.4C99.3 22.3 103.1 26.3 107.7 26.3C112.2 26.3 116 22.3 116 17.4C116 12.6 112.2 8.6 107.7 8.6Z"/><path d="M118.2 8.3C118.2 9.4 117.4 10.3 116.3 10.3C115.2 10.3 114.3 9.4 114.3 8.3C114.3 7.1 115.2 6.2 116.3 6.2C117.4 6.2 118.2 7.1 118.2 8.3Z"/></g>' },
  { name: 'TikTok', url: 'https://www.tiktok.com/@snacksyummies', w: 34.3, h: 34.8, svg: '<g transform="translate(-137.3 0.0)"><path d="M164.2 15.4C164 15.4 163.8 15.4 163.7 15.4C161.6 15.4 159.7 14.4 158.5 12.7L158.5 22.1C158.5 26 155.4 29.1 151.6 29.1C147.7 29.1 144.6 26 144.6 22.1C144.6 18.3 147.7 15.1 151.6 15.1C151.7 15.1 151.8 15.1 152 15.2L152 18.6C151.8 18.6 151.7 18.6 151.6 18.6C149.6 18.6 148 20.1 148 22.1C148 24.1 149.6 25.7 151.6 25.7C153.5 25.7 155.3 24.1 155.3 22.2L155.3 6.1L158.6 6.1C158.9 9.1 161.3 11.4 164.2 11.6L164.2 15.4M167.5 0.4L141.3 0.4C139 0.4 137.2 2.3 137.2 4.5L137.2 30.7C137.2 33 139 34.8 141.3 34.8L167.5 34.8C169.8 34.8 171.6 33 171.6 30.7L171.6 4.5C171.6 2.3 169.8 0.4 167.5 0.4Z"/></g>' },

</Layout>

<style>
  /* Estilos del Contador (diseño GT: caja gris clara, cifras azules, ceros a la izquierda en gris) */
  /*
   * Medidas del diseño en em (font-size = tamaño de las cifras):
   * - Las cifras miden ~0.59em de alto (cap height de TroisMille Bold 15).
   * - Márgenes: ~0.22em arriba/abajo y ~0.285em a los lados.
   * - Borde: línea gris fina + degradado gris interno (sin sombra externa).
   */
  .counter-display {
    display: inline-flex;
    justify-content: center;
    font-size: clamp(6rem, 12vw, 11rem);
    padding: 0.22em 0.285em;
    border-radius: 0.14em;
    background: #f6f4f2;
    border: 1px solid #b7b6b4;
    box-shadow:
      inset 0 0 6px 1px rgba(0, 0, 0, 0.12),
      inset 0 -4px 8px -2px rgba(0, 0, 0, 0.1);
  }

  /*
   * line-height = altura de las cifras para que la caja abrace solo los dígitos.
   * Con las métricas de la fuente (ascent 0.827, descent 0.407) las cifras quedan
   * 0.085em por encima de la caja de línea; el top lo compensa para centrarlas.
   */
  .counter-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 0.59em;
    position: relative;
    top: 0.085em;
  }

  .counter-digit {
    font-family: 'TroisMille Bold 15', var(--font-title);
    font-weight: 700;
    color: #004e9d;
    font-variant-numeric: tabular-nums;
    transition: color 0.2s ease;
  }

  /* Ceros a la izquierda sin usar */
  .counter-digit.is-off {
    color: #e9e7e5;
  }

  /* Animaciones de entrada */
  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fadeIn 0.8s ease-out;
  }

  .animate-slide-up {
    opacity: 0;
    animation: slideUp 0.8s ease-out forwards;
  }

  /* Animación escalonada para elementos */
  .animate-slide-up:nth-of-type(1) {
    animation-delay: 0.1s;
  }

  .animate-slide-up:nth-of-type(2) {
    animation-delay: 0.2s;
  }

  .animate-slide-up:nth-of-type(3) {
    animation-delay: 0.3s;
  }

  .animate-slide-up:nth-of-type(4) {
    animation-delay: 0.4s;
  }

  /* Scroll suave para toda la página */
  html {
    scroll-behavior: smooth;
  }

  /* Intersection Observer para animaciones al hacer scroll */
  .animate-on-scroll {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }

  .animate-on-scroll.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Animaciones para items individuales */
  .animate-item {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }

  .animate-item.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Delays escalonados para items */
  .animate-item:nth-child(1) { transition-delay: 0.1s; }
  .animate-item:nth-child(2) { transition-delay: 0.2s; }
  .animate-item:nth-child(3) { transition-delay: 0.3s; }
  .animate-item:nth-child(4) { transition-delay: 0.4s; }
  .animate-item:nth-child(5) { transition-delay: 0.5s; }
  .animate-item:nth-child(6) { transition-delay: 0.6s; }

  /* Animaciones de entrada para textos e imágenes (reveal) */
  .reveal {
    opacity: 0;
    transition: opacity 0.8s ease-out, transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform;
  }

  .reveal-left { transform: translateX(-40px); }
  .reveal-up { transform: translateY(30px); }
  .reveal-right { transform: translateX(40px) scale(0.95); }

  .reveal.visible {
    opacity: 1;
    transform: none;
  }

  .reveal-delay-1 { transition-delay: 0.2s; }
  .reveal-delay-2 { transition-delay: 0.4s; }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* Cifras de impacto GT: cifras en TroisMille Black 20 (azul), textos en Bold 15 (celeste) */
  .gt-stats__number {
    font-family: 'TroisMille Black 20', var(--font-title);
    font-weight: 900;
    color: #0050a0;
    font-size: clamp(2.5rem, 4.4vw, 5.25rem);
    line-height: 1;
    white-space: nowrap;
  }

  /* "4 DEPARTAMENTOS" va en la variante condensada, en mayúsculas */
  .gt-stats__number--condensed {
    font-family: 'TroisMille Bold 15', var(--font-title);
    font-weight: 700;
    text-transform: uppercase;
  }

  .gt-stats__number .count-up {
    font-family: inherit;
  }

  .gt-stats__label {
    font-family: 'TroisMille Bold 15', var(--font-text);
    font-weight: 700;
    color: #00a3e4;
    font-size: clamp(1.125rem, 2vw, 2.4rem);
    line-height: 1.15;
    margin-top: 0.2em;
  }

  /* Header GT: fondo + logo gif + título (imagen dividida en 3 líneas) */
  .pcc-hero {
    --hero-title: url('https://snack.yummiespromociones.com/SnacksyummiesAssets/productosconcausagt/header/titulo.webp');
    position: relative;
    width: 100%;
    /* Misma proporción que la portada de /productosconcausa (fondo + productos) */
    aspect-ratio: 7681 / 4970;
    overflow: hidden;
    container-type: inline-size;
  }

  .pcc-hero__bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    max-width: none;
    height: auto;
  }

  .pcc-hero__content {
    position: absolute;
    top: 6cqw;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5cqw;
  }

  /* El gif trae mucho margen transparente: se agranda y se compensa con margen negativo */
  .pcc-hero__logo {
    width: 34cqw;
    margin: 0 -5cqw;
    height: auto;
    flex-shrink: 0;
    opacity: 0;
    transform: scale(0.4) rotate(-12deg);
  }

  /* titulo.webp mide 3322x1772; cada línea muestra su franja de la imagen */
  .pcc-hero__title {
    position: relative;
    width: 44cqw;
    aspect-ratio: 3322 / 1772;
    margin: 0;
  }

  .pcc-hero__line {
    position: absolute;
    inset: 0;
    background: var(--hero-title) no-repeat center / 100% 100%;
    opacity: 0;
    filter: blur(8px);
    transform: translateY(0.6cqw);
    -webkit-mask-image: linear-gradient(90deg, #000 40%, transparent 60%);
    mask-image: linear-gradient(90deg, #000 40%, transparent 60%);
    -webkit-mask-size: 250% 100%;
    mask-size: 250% 100%;
    -webkit-mask-position: 100% 0;
    mask-position: 100% 0;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  /* Cortes medidos sobre el alfa de titulo.webp */
  .pcc-hero__line--1 { clip-path: inset(0 0 64.3% 0); }
  .pcc-hero__line--2 { clip-path: inset(35.7% 0 42.1% 0); }
  .pcc-hero__line--3 { clip-path: inset(57.9% 0 0 0); }

  /* Productos: misma posición, tamaño y orden de capas que la portada de /productosconcausa */
  .pcc-hero__product {
    position: absolute;
    height: auto;
    opacity: 0;
    transform: translateY(12cqw) scale(0.85);
    filter: drop-shadow(0 1.2cqw 0.9cqw rgba(0, 0, 0, 0.3));
  }

  .pcc-hero__product--1 { left: 19.8%; width: 15.3%; bottom: 5%; z-index: 1; }
  .pcc-hero__product--2 { left: 33.6%; width: 16%; bottom: 4.2%; z-index: 2; }
  .pcc-hero__product--3 { left: 48.1%; width: 18.6%; bottom: 3%; z-index: 4; }
  .pcc-hero__product--4 { left: 65.3%; width: 15%; bottom: 5%; z-index: 3; }

  .pcc-hero.visible .pcc-hero__product {
    animation: pccHeroProductIn 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) forwards,
      pccHeroProductFloat 5s ease-in-out infinite;
  }

  .pcc-hero.visible .pcc-hero__product--1 { animation-delay: 1.1s, 2s; }
  .pcc-hero.visible .pcc-hero__product--2 { animation-delay: 1.25s, 2.6s; }
  .pcc-hero.visible .pcc-hero__product--3 { animation-delay: 1.4s, 2.3s; }
  .pcc-hero.visible .pcc-hero__product--4 { animation-delay: 1.55s, 2.9s; }

  @keyframes pccHeroProductIn {
    0% { opacity: 0; transform: translateY(12cqw) scale(0.85); }
    50% { opacity: 1; }
    100% { opacity: 1; transform: none; }
  }

  @keyframes pccHeroProductFloat {
    0%, 100% { opacity: 1; transform: translateY(0); }
    50% { opacity: 1; transform: translateY(-0.6cqw); }
  }

  .pcc-hero.visible .pcc-hero__logo {
    animation: pccHeroLogoIn 1s cubic-bezier(0.34, 1.56, 0.64, 1) forwards,
      pccHeroFloat 4s ease-in-out 1.2s infinite;
  }

  .pcc-hero.visible .pcc-hero__line {
    animation: pccHeroLineIn 1.1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .pcc-hero.visible .pcc-hero__line--1 { animation-delay: 0.35s; }
  .pcc-hero.visible .pcc-hero__line--2 { animation-delay: 0.65s; }
  .pcc-hero.visible .pcc-hero__line--3 { animation-delay: 0.95s; }

  @keyframes pccHeroLogoIn {
    0% { opacity: 0; transform: scale(0.4) rotate(-12deg); }
    60% { opacity: 1; }
    100% { opacity: 1; transform: scale(1) rotate(0); }
  }

  @keyframes pccHeroFloat {
    0%, 100% { opacity: 1; transform: translateY(0); }
    50% { opacity: 1; transform: translateY(-0.8cqw); }
  }

  /* Barrido de izquierda a derecha, como el efecto letra por letra de los otros títulos */
  @keyframes pccHeroLineIn {
    0% {
      opacity: 0;
      filter: blur(8px);
      transform: translateY(0.6cqw);
      -webkit-mask-position: 100% 0;
      mask-position: 100% 0;
    }
    30% { opacity: 1; }
    100% {
      opacity: 1;
      filter: blur(0);
      transform: none;
      -webkit-mask-position: 0 0;
      mask-position: 0 0;
    }
  }

  /* Mobile: un poco más alto para que logo y título ganen tamaño */
  @media (max-width: 639px) {
    .pcc-hero {
      aspect-ratio: 100 / 76;
    }

    .pcc-hero__bg {
      width: 124%;
      max-width: none;
      left: -12%;
    }

    .pcc-hero__content {
      top: 7cqw;
      gap: 2cqw;
    }

    .pcc-hero__logo { width: 40cqw; margin: 0 -6cqw; }
    .pcc-hero__title { width: 55cqw; }

    /* Fila de productos más ancha para que se lean en pantallas chicas */
    .pcc-hero__product--1 { left: 10.1%; width: 20.2%; bottom: 3.5%; }
    .pcc-hero__product--2 { left: 28.4%; width: 21.1%; bottom: 2.8%; }
    .pcc-hero__product--3 { left: 47.5%; width: 24.6%; bottom: 2%; }
    .pcc-hero__product--4 { left: 70.2%; width: 19.8%; bottom: 3.5%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pcc-hero__logo,
    .pcc-hero__line,
    .pcc-hero__product,
    .pcc-hero.visible .pcc-hero__logo,
    .pcc-hero.visible .pcc-hero__line,
    .pcc-hero.visible .pcc-hero__product {
      animation: none;
      opacity: 1;
      transform: none;
      filter: none;
      -webkit-mask-image: none;
      mask-image: none;
    }

    .pcc-hero.visible .pcc-hero__product,
    .pcc-hero .pcc-hero__product {
      filter: drop-shadow(0 1.2cqw 0.9cqw rgba(0, 0, 0, 0.3));
    }
  }

  /* Evita que la regla global de span (fonts.css) cambie la tipografía de las cifras */
  .count-up {
    font-family: inherit;
  }
</style>

<script>
  import { initTitleLetters } from '../../../scripts/titleLetters';

  // Intersection Observer para animar elementos al hacer scroll
  document.addEventListener('astro:page-load', () => {
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    // Observar todas las secciones con animación
    const animatedSections = document.querySelectorAll('.animate-slide-up');
    animatedSections.forEach(section => {
      section.classList.add('animate-on-scroll');
      observer.observe(section);
    });

    // Observar items individuales
    const animatedItems = document.querySelectorAll('.animate-item, .reveal, .pcc-hero');
    animatedItems.forEach(item => {
      observer.observe(item);
    });

    const testimonialOverlays = document.querySelectorAll('.testimonial-video-overlay');
    testimonialOverlays.forEach((overlay) => {
      overlay.addEventListener('click', () => {
        const container = overlay.closest('.relative');
        if (!container) return;
        const video = container.querySelector('video');
        if (!video) return;
        video.play();
        video.setAttribute('controls', 'controls');
        overlay.classList.add('hidden');
      });
    });

    // Títulos letra por letra (.title-letters)
    initTitleLetters();

    // Contador animado para las cifras de Indicadores y Donativos
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const counters = document.querySelectorAll<HTMLElement>('.count-up');

    const digitalCounters = document.querySelectorAll<HTMLElement>('.digital-counter');

    const runCount = (target: number, duration: number, render: (value: number) => void) => {
      const start = performance.now();

      const tick = (now: number) => {
        const progress = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3); // easeOutCubic
        render(target * eased);
        if (progress < 1) requestAnimationFrame(tick);
      };

      requestAnimationFrame(tick);
    };

    const animateCounter = (el: HTMLElement) => {
      const target = parseFloat(el.dataset.target || '0');
      const decimals = parseInt(el.dataset.decimals || '0', 10);
      const format = new Intl.NumberFormat('en-US', {
        minimumFractionDigits: decimals,
        maximumFractionDigits: decimals
      });

      runCount(target, 2000, (value) => {
        el.textContent = format.format(value);
      });
    };

    // Contador de la campaña: actualiza cada dígito; los ceros a la izquierda quedan en gris
    const renderDigits = (cells: HTMLElement[], value: number) => {
      const current = String(Math.floor(value));
      const padded = current.padStart(cells.length, '0');
      const firstUsed = cells.length - current.length;
      cells.forEach((cell, i) => {
        cell.textContent = padded[i];
        cell.classList.toggle('is-off', i < firstUsed);
      });
    };

    const animateDigitalCounter = (el: HTMLElement) => {
      const target = parseInt(el.dataset.target || '0', 10);
      const cells = Array.from(el.querySelectorAll<HTMLElement>('.counter-digit'));
      runCount(target, 2500, (value) => renderDigits(cells, value));
    };

    if (!prefersReducedMotion) {
      // Arrancan en 0 para que no se vea la cifra final antes de animar
      counters.forEach(counter => {
        const decimals = parseInt(counter.dataset.decimals || '0', 10);
        counter.textContent = (0).toFixed(decimals);
      });
      digitalCounters.forEach(counter => {
        renderDigits(Array.from(counter.querySelectorAll<HTMLElement>('.counter-digit')), 0);
      });

      const counterObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const target = entry.target as HTMLElement;
            if (target.classList.contains('digital-counter')) {
              animateDigitalCounter(target);
            } else {
              animateCounter(target);
            }
            counterObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.5 });

      counters.forEach(counter => counterObserver.observe(counter));
      digitalCounters.forEach(counter => counterObserver.observe(counter));
    }
  });
</script>

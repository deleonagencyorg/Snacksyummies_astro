<script is:inline>
  function isYouTube(url) {
    if (!url) return false;
    return /youtu\.be|youtube\.com/.test(url);
  }

  function getYouTubeId(url) {
    if (!url) return '';
    const regExp = /^.*(youtu\.be\/|v\/|u\/\w\/|embed\/|watch\?v=|shorts\/|\&v=)([^#\&\?]*).*/;
    const match = url.match(regExp);
    return (match && match[2].length === 11) ? match[2] : '';
  }

  function isYouTubeShort(url) {
    if (!url) return false;
    return /youtube\.com\/shorts\//.test(url);
  }

  function buildEmbedUrl(videoId) {
    const params = new URLSearchParams({
      autoplay: '1',
      controls: '1',
      playsinline: '1',
      rel: '0',
      modestbranding: '1',
      enablejsapi: '1'
    });
    return 'https://www.youtube.com/embed/' + videoId + '?' + params.toString();
  }

  function applyWrapperSize(wrapper, w, h) {
    if (!wrapper || !w || !h) return;
    const maxW = window.innerWidth * 0.9;
    const maxH = window.innerHeight * 0.85;
    const ratio = w / h;
    let width = maxW;
    let height = width / ratio;

    if (height > maxH) {
      height = maxH;
      width = height * ratio;
    }

    wrapper.style.width = Math.round(width) + 'px';
    wrapper.style.height = Math.round(height) + 'px';
  }

  function showMedia(el) {
    if (!el) return;
    el.classList.remove('hidden');
    el.style.display = 'block';
  }

  function hideMedia(el) {
    if (!el) return;
    el.classList.add('hidden');
    el.style.display = 'none';
  }

  function hideFallback() {
    const fallback = document.getElementById('video-modal-fallback');
    if (fallback) {
      fallback.classList.add('hidden');
      fallback.style.display = 'none';
    }
  }

  function showFallback(url) {
    const fallback = document.getElementById('video-modal-fallback');
    const link = document.getElementById('video-modal-fallback-link');
    if (!fallback || !link) return;
    link.href = url;
    fallback.classList.remove('hidden');
    fallback.style.display = 'flex';
  }

  function resetMedia(wrapper, iframe, videoPlayer) {
    hideFallback();

    if (iframe) {
      iframe.src = '';
      hideMedia(iframe);
    }

    if (videoPlayer) {
      videoPlayer.pause();
      videoPlayer.onloadedmetadata = null;
      videoPlayer.onerror = null;
      videoPlayer.oncanplay = null;
      videoPlayer.removeAttribute('src');
      hideMedia(videoPlayer);
    }

    if (wrapper) {
      wrapper.dataset.mode = 'default';
      wrapper.style.width = '';
      wrapper.style.height = '';
    }
  }

  function playDirectVideo(url, wrapper, iframe, videoPlayer) {
    if (!videoPlayer || !wrapper) return;

    wrapper.dataset.mode = 'direct-video';
    applyWrapperSize(wrapper, 16, 9);
    hideMedia(iframe);
    hideFallback();

    videoPlayer.src = url;
    videoPlayer.setAttribute('controls', '');
    videoPlayer.setAttribute('playsinline', '');
    videoPlayer.setAttribute('webkit-playsinline', '');
    videoPlayer.muted = true;

    const resizeFromMetadata = function() {
      const w = videoPlayer.videoWidth;
      const h = videoPlayer.videoHeight;
      if (w > 0 && h > 0) {
        applyWrapperSize(wrapper, w, h);
      }
    };

    const tryPlay = function() {
      const playPromise = videoPlayer.play();
      if (playPromise && typeof playPromise.catch === 'function') {
        playPromise.catch(function() {
          videoPlayer.muted = false;
          videoPlayer.controls = true;
        });
      }
    };

    const tryIframeFallback = function() {
      if (!iframe) {
        showFallback(url);
        return;
      }

      hideMedia(videoPlayer);
      wrapper.dataset.mode = 'direct-video-iframe';
      applyWrapperSize(wrapper, 16, 9);
      iframe.src = url;
      showMedia(iframe);
    };

    videoPlayer.onloadedmetadata = resizeFromMetadata;
    videoPlayer.oncanplay = function() {
      tryPlay();
    };
    videoPlayer.onerror = tryIframeFallback;

    showMedia(videoPlayer);
    videoPlayer.load();
    tryPlay();
  }

  window.openVideoModal = function(url) {
    if (!url) return;

    const modal = document.getElementById('video-modal-overlay');
    const wrapper = document.getElementById('video-modal-wrapper');
    const iframe = document.getElementById('video-modal-iframe');
    const videoPlayer = document.getElementById('video-modal-player');
    if (!modal || !wrapper) return;

    resetMedia(wrapper, iframe, videoPlayer);

    if (isYouTube(url)) {
      const videoId = getYouTubeId(url);
      if (!videoId || !iframe) return;

      const isShort = isYouTubeShort(url);
      wrapper.dataset.mode = isShort ? 'youtube-shorts' : 'youtube';
      applyWrapperSize(wrapper, isShort ? 9 : 16, isShort ? 16 : 9);

      hideMedia(videoPlayer);
      iframe.src = buildEmbedUrl(videoId);
      showMedia(iframe);
    } else {
      playDirectVideo(url, wrapper, iframe, videoPlayer);
    }

    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  };

  window.closeVideoModal = function() {
    const modal = document.getElementById('video-modal-overlay');
    const wrapper = document.getElementById('video-modal-wrapper');
    const iframe = document.getElementById('video-modal-iframe');
    const videoPlayer = document.getElementById('video-modal-player');
    if (!modal) return;

    resetMedia(wrapper, iframe, videoPlayer);

    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
  };

  document.addEventListener('click', function(e) {
    const modal = document.getElementById('video-modal-overlay');
    if (e.target === modal) {
      window.closeVideoModal();
    }
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      const modal = document.getElementById('video-modal-overlay');
      if (modal && !modal.classList.contains('hidden')) {
        window.closeVideoModal();
      }
    }
  });
</script>

<div
  id="video-modal-overlay"
  class="video-modal-overlay hidden fixed inset-0 z-[100] items-center justify-center bg-black/80 backdrop-blur-sm p-4"
  onclick="if(event.target===this)window.closeVideoModal()"
>
  <div
    id="video-modal-wrapper"
    data-mode="default"
    class="video-modal-wrapper relative bg-black rounded-xl overflow-hidden shadow-2xl"
    onclick="event.stopPropagation()"
  >
    <button
      type="button"
      onclick="window.closeVideoModal()"
      class="video-modal-close absolute top-2 right-2 z-30 flex items-center justify-center w-9 h-9 text-white bg-black/60 hover:bg-black/80 rounded-full transition-colors"
      aria-label="Close video"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <iframe
      id="video-modal-iframe"
      class="video-modal-media hidden"
      frameborder="0"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen"
      allowfullscreen
    ></iframe>

    <video
      id="video-modal-player"
      class="video-modal-media hidden"
      controls
      playsinline
      webkit-playsinline
      preload="auto"
    ></video>

    <div
      id="video-modal-fallback"
      class="video-modal-fallback hidden absolute inset-0 z-20 flex flex-col items-center justify-center gap-4 p-6 text-center text-white"
    >
      <p class="text-sm md:text-base opacity-90">No se pudo reproducir el video en este navegador.</p>
      <a
        id="video-modal-fallback-link"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-full bg-white px-5 py-2 text-sm font-semibold text-primary hover:opacity-90"
      >
        Abrir video
      </a>
    </div>
  </div>
</div>

<style is:global>
  .video-modal-wrapper {
    flex-shrink: 0;
  }

  .video-modal-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
    display: none;
    background: #000;
  }

  #video-modal-player {
    object-fit: contain;
  }

  .video-modal-close {
    top: calc(env(safe-area-inset-top, 0px) + 0.5rem);
    right: calc(env(safe-area-inset-right, 0px) + 0.5rem);
  }

  .video-modal-fallback {
    background: rgba(0, 0, 0, 0.92);
  }
</style>

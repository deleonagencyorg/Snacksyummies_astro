---
import { resolveStaticPath } from '../../../utils/staticPaths';
// src/pages/[lang]/recipes/[recipeId].astro
import { setLocale, type Locale } from '../../../i18n/i18n';
import MainLayout from '../../../layouts/MainLayout.astro';
import RecipeDetail from '../../../views/Recipes/Detail/index.astro';
import { getAllRecipes } from '../../../services/api/recipes';
import { cmsMediaSrc } from '../../../services/api/multimedia';

// Usamos generación estática para Vercel

export async function getStaticPaths() {
  const languages = ['en'];
  const paths = [];

  for (const lang of languages) {
    const recipes = await getAllRecipes(lang);
    for (const recipe of recipes) {
      if (!recipe.slug) continue;

      paths.push({
        params: { lang, recipeId: recipe.slug },
        props: { recipe }
      });
    }
  }

  return paths;
}

const staticPath = await resolveStaticPath(getStaticPaths, Astro.params);
if (!staticPath) {
  return Astro.rewrite('/404');
}

// Obtener parámetros y props de getStaticPaths
const { lang, recipeId } = Astro.params;
const { recipe } = staticPath.props;
setLocale(lang as Locale);

// Ya no necesitamos buscar la receta porque la recibimos como prop desde getStaticPaths
---

<MainLayout
  title={recipe?.metaTitle || recipe?.title || ''}
  description={recipe?.metaDescription || recipe?.description || ''}
  keywords={recipe?.metaKeywords}
  ogTitle={recipe?.ogTitle}
  ogDescription={recipe?.ogDescription}
  image={cmsMediaSrc(recipe?.ogImage) || recipe?.image}
  type="recipe"
>
  <RecipeDetail currentLang={lang} recipeId={recipeId} recipe={recipe} />
</MainLayout>

<style>
  /* Estilos del Contador Digital */
  .counter-display {
    position: relative;
    display: inline-block;
    padding: 0.4rem;
    border-radius: 1.25rem;
    background: #f7f9fc;
    box-shadow:
      0 4px 10px rgba(0, 0, 0, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.8);
    border: 1px solid #d9e2ee;
    overflow: hidden;
    width: 100%;
    max-width: 400px;
  }

  .counter-display::before {
    content: '';
    position: absolute;
    inset: 3px;
    border-radius: 1rem;
    background: linear-gradient(180deg, #d4e0ee 0%, #7791aa 45%, #536c85 100%);
    box-shadow:
      inset 0 1px 2px rgba(255, 255, 255, 0.7),
      inset 0 -2px 4px rgba(0, 0, 0, 0.25);
  }

  .counter-display::after {
    content: '';
    position: absolute;
    left: 5%;
    right: 5%;
    top: 5%;
    height: 40%;
    border-radius: 50% / 100%;
    background: radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.7), rgba(255, 255, 255, 0));
    opacity: 0.85;
  }

  .counter-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    padding: 0.4rem 1.4rem;
    z-index: 1;
  }

  .counter-ghost {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Orbitron', monospace;
    font-weight: 700;
    font-size: 2.5rem;
    color: rgba(255, 255, 255, 0.22);
    letter-spacing: 0.08em;
  }

  .counter-digit {
    font-family: 'Orbitron', monospace;
    font-weight: 700;
    font-size: 2.5rem;
    color: #ffffff;
    text-align: center;
    line-height: 1;
    text-shadow:
      0 0 3px rgba(255, 255, 255, 0.9),
      0 0 6px rgba(255, 255, 255, 0.7);
  }

  .counter-separator {
    font-family: 'Orbitron', monospace;
    font-weight: 700;
    font-size: 2.5rem;
    color: #ffffff;
    margin: 0 0.1rem;
    line-height: 1;
    text-shadow:
      0 0 3px rgba(255, 255, 255, 0.9),
      0 0 6px rgba(255, 255, 255, 0.7);
  }

  /* Responsive - Mobile */
  @media (max-width: 768px) {
    .counter-display {
      padding: 0.3rem;
      border-radius: 0.9rem;
      width: 90vw;
      max-width: 90vw;
    }

    .counter-wrapper {
      padding: 0.3rem 1rem;
      gap: 0.08rem;
    }

    .counter-ghost {
      font-size: 1.9rem;
    }

    .counter-digit,
    .counter-separator {
      font-size: 1.9rem;
    }
  }

  /* Responsive - Tablet */
  @media (min-width: 769px) and (max-width: 1024px) {
    .counter-ghost {
      font-size: 2.2rem;
    }

    .counter-digit,
    .counter-separator {
      font-size: 2.2rem;
    }
  }

  /* Animaciones de entrada */
  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fadeIn 0.8s ease-out;
  }

  .animate-slide-up {
    opacity: 0;
    animation: slideUp 0.8s ease-out forwards;
  }

  /* Animación escalonada para elementos */
  .animate-slide-up:nth-of-type(1) {
    animation-delay: 0.1s;
  }

  .animate-slide-up:nth-of-type(2) {
    animation-delay: 0.2s;
  }

  .animate-slide-up:nth-of-type(3) {
    animation-delay: 0.3s;
  }

  .animate-slide-up:nth-of-type(4) {
    animation-delay: 0.4s;
  }

  /* Scroll suave para toda la página */
  html {
    scroll-behavior: smooth;
  }

  /* Intersection Observer para animaciones al hacer scroll */
  .animate-on-scroll {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }

  .animate-on-scroll.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Animaciones para items individuales */
  .animate-item {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }

  .animate-item.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Delays escalonados para items */
  .animate-item:nth-child(1) { transition-delay: 0.1s; }
  .animate-item:nth-child(2) { transition-delay: 0.2s; }
  .animate-item:nth-child(3) { transition-delay: 0.3s; }
  .animate-item:nth-child(4) { transition-delay: 0.4s; }
  .animate-item:nth-child(5) { transition-delay: 0.5s; }
  .animate-item:nth-child(6) { transition-delay: 0.6s; }

  /* Animaciones de entrada para textos e imágenes (reveal) */
  .reveal {
    opacity: 0;
    transition: opacity 0.8s ease-out, transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform;
  }

  .reveal-left { transform: translateX(-40px); }
  .reveal-up { transform: translateY(30px); }
  .reveal-right { transform: translateX(40px) scale(0.95); }

  .reveal.visible {
    opacity: 1;
    transform: none;
  }

  .reveal-delay-1 { transition-delay: 0.2s; }
  .reveal-delay-2 { transition-delay: 0.4s; }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* Posiciones sin usar del contador digital: se apagan y se ve el fondo "88.888" */
  .counter-digit.is-off,
  .counter-separator.is-off {
    visibility: hidden;
  }

  /* Evita que la regla global de span (fonts.css) cambie la tipografía de las cifras */
  .count-up {
    font-family: inherit;
  }
</style>

<script>
  import { initTitleLetters } from '../../scripts/titleLetters';

  // Intersection Observer para animar elementos al hacer scroll
  document.addEventListener('astro:page-load', () => {
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    // Observar todas las secciones con animación
    const animatedSections = document.querySelectorAll('.animate-slide-up');
    animatedSections.forEach(section => {
      section.classList.add('animate-on-scroll');
      observer.observe(section);
    });

    // Observar items individuales
    const animatedItems = document.querySelectorAll('.animate-item, .reveal');
    animatedItems.forEach(item => {
      observer.observe(item);
    });

    const testimonialOverlays = document.querySelectorAll('.testimonial-video-overlay');
    testimonialOverlays.forEach((overlay) => {
      overlay.addEventListener('click', () => {
        const container = overlay.closest('.relative');
        if (!container) return;
        const video = container.querySelector('video');
        if (!video) return;
        video.play();
        video.setAttribute('controls', 'controls');
        overlay.classList.add('hidden');
      });
    });

    // Títulos letra por letra (.title-letters)
    initTitleLetters();

    // Contador animado para las cifras de Indicadores y Donativos
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const counters = document.querySelectorAll<HTMLElement>('.count-up');

    const digitalCounters = document.querySelectorAll<HTMLElement>('.digital-counter');

    const runCount = (target: number, duration: number, render: (value: number) => void) => {
      const start = performance.now();

      const tick = (now: number) => {
        const progress = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3); // easeOutCubic
        render(target * eased);
        if (progress < 1) requestAnimationFrame(tick);
      };

      requestAnimationFrame(tick);
    };

    const animateCounter = (el: HTMLElement) => {
      const target = parseFloat(el.dataset.target || '0');
      const decimals = parseInt(el.dataset.decimals || '0', 10);
      const format = new Intl.NumberFormat('en-US', {
        minimumFractionDigits: decimals,
        maximumFractionDigits: decimals
      });

      runCount(target, 2000, (value) => {
        el.textContent = format.format(value);
      });
    };

    // Contador digital de la campaña: actualiza cada dígito por separado
    const animateDigitalCounter = (el: HTMLElement) => {
      const target = parseInt(el.dataset.target || '0', 10);
      const cells = Array.from(el.querySelectorAll<HTMLElement>('.counter-digit, .counter-separator'));
      const digitCount = cells.filter(cell => cell.classList.contains('counter-digit')).length;

      runCount(target, 2500, (value) => {
        const current = String(Math.floor(value));
        const padded = current.padStart(digitCount, '0');
        const firstUsed = digitCount - current.length;
        let digitIndex = 0;

        cells.forEach(cell => {
          if (cell.classList.contains('counter-digit')) {
            cell.textContent = padded[digitIndex];
            cell.classList.toggle('is-off', digitIndex < firstUsed);
            digitIndex++;
          } else {
            // El separador se apaga si todavía no hay dígitos a su izquierda
            cell.classList.toggle('is-off', digitIndex <= firstUsed);
          }
        });
      });
    };

    if (!prefersReducedMotion) {
      // Arrancan en 0 para que no se vea la cifra final antes de animar
      counters.forEach(counter => {
        const decimals = parseInt(counter.dataset.decimals || '0', 10);
        counter.textContent = (0).toFixed(decimals);
      });
      digitalCounters.forEach(counter => {
        counter.querySelectorAll<HTMLElement>('.counter-digit, .counter-separator').forEach((cell, i, all) => {
          const isLast = i === all.length - 1;
          if (isLast) cell.textContent = '0';
          cell.classList.toggle('is-off', !isLast);
        });
      });

      const counterObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const target = entry.target as HTMLElement;
            if (target.classList.contains('digital-counter')) {
              animateDigitalCounter(target);
            } else {
              animateCounter(target);
            }
            counterObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.5 });

      counters.forEach(counter => counterObserver.observe(counter));
      digitalCounters.forEach(counter => counterObserver.observe(counter));
    }
  });
</script>

---
// CrownTitle.astro - Component for titles with crown decoration
import { generalAssets } from '../../../config/assets';
import LazyImage from '../LazyImage.astro';
import './styles.css';

interface Props {
  title: string;
  subtitle: string;
  titleColor?: string;
  subtitleColor?: string;
  level?: 1 | 2;
  id?: string;
}

const { 
  title, 
  subtitle, 
  titleColor = 'text-primary', 
  subtitleColor = 'text-gray-600',
  level = 1,
  id
} = Astro.props;
const Heading = level === 2 ? 'h2' : 'h1';
---

<div class="crown-title-container">
  <LazyImage
    src={generalAssets.coronaIcon} 
    alt="" 
    class="crown-icon"
    width="32"
    height="29"
    decorative={true}
  />
  <Heading id={id} class={`text-6xl md:text-8xl font-bold mb-2 font-title ${titleColor}`}>
    {title}
  </Heading>
  <p class={`text-lg md:text-xl font-medium ${subtitleColor}`}>{subtitle}</p>
</div>

<script src="./script.js"></script>

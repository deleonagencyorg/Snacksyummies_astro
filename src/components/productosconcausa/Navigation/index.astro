---
import './styles.css';
import { logos } from '../../../config/assets';
import LazyImage from '../../common/LazyImage.astro';

// Base path: /productosconcausa (HN) o /gt/productosconcausa (GT)
const isGT = Astro.url.pathname.startsWith('/gt/productosconcausa');
const basePath = isGT ? '/gt/productosconcausa' : '/productosconcausa';

// Enlaces de navegación
const navLinks = [
  { href: basePath + '#inicio', label: 'Inicio', key: 'inicio' },
  { href: basePath + '#sobre-la-causa', label: 'Sobre la causa', key: 'sobre-la-causa' },
  // GT no tiene página de historia
  ...(isGT ? [] : [{ href: basePath + '/historia', label: 'Historia', key: 'historia' }]),
  { href: basePath + '#impacto', label: 'Impacto', key: 'impacto' },
  { href: basePath + '#productos-participantes', label: 'Productos participantes', key: 'productos-participantes' },
  // GT no tiene sección de testimonios
  ...(isGT ? [] : [{ href: basePath + '#testimonios', label: 'Testimonios', key: 'testimonios' }]),
];

// Obtener la ruta actual para marcar el enlace activo
const currentPath = Astro.url.pathname;

// GT sigue el diseño YPOPS-CAUSA_WEB-LAYOUT (barra de 127px a 1920, escalada con el ancho de pantalla)
const gtClass = {
  bar: 'h-[clamp(64px,6.615vw,127px)]',
  container: 'max-w-[1920px] px-[clamp(16px,6.667vw,128px)]',
  logos: 'gap-[clamp(16px,2.344vw,45px)]',
  ypops: 'h-[clamp(40px,5.313vw,102px)] w-auto',
  osWrap: 'gap-[clamp(8px,2.135vw,41px)]',
  divider: 'h-[clamp(32px,2.448vw,47px)]',
  os: 'h-[clamp(32px,2.448vw,47px)] w-auto',
  links: 'gap-[clamp(24px,2.344vw,45px)]',
};
---

<nav class:list={['pcc-navigation bg-white border-b border-gray-200 sticky top-0 z-[1000]', { 'pcc-navigation--gt': isGT }]} data-spy={isGT ? '' : undefined}>
  <div class:list={['mx-auto', isGT ? gtClass.container : 'container px-4']}>
    <div class:list={['flex items-center justify-between', isGT ? gtClass.bar : 'h-16']}>
      <!-- Logos -->
      <div class:list={['flex items-center', isGT ? gtClass.logos : 'gap-4']}>
        <a href={basePath} class="flex items-center" aria-label="YummiPops">
          <LazyImage 
            src={logos.yummiPops.url} 
            alt={logos.yummiPops.alt} 
            class={isGT ? gtClass.ypops : 'h-10 w-auto'}
          />
        </a>
        <div class:list={['flex items-center', isGT ? gtClass.osWrap : 'gap-2']}>
          <div class:list={['w-[1px] bg-gray-300', isGT ? gtClass.divider : 'h-8']}></div>
          <LazyImage 
            src={isGT
              ? 'https://snack.yummiespromociones.com/SnacksyummiesAssets/productosconcausagt/header/logo.webp'
              : 'https://snack.yummiespromociones.com/SnacksyummiesAssets/logooperacionsonrisas.webp'}
            alt={isGT ? 'Operación Sonrisa Guatemala' : 'Operación Sonrisas'}
            class={isGT ? gtClass.os : 'h-8 w-auto'}
          />
        </div>
      </div>

      <!-- Navigation Links - Desktop -->
      <div class:list={['hidden lg:flex items-center', isGT ? gtClass.links : 'gap-6']}>
        {navLinks.map((link, i) => (
          <a 
            href={link.href}
            class:list={[
              'pcc-nav-link transition-colors',
              isGT
                ? ['pcc-nav-link--gt font-gt-bold18', { 'is-active': i === 0 }]
                : ['text-sm font-medium hover:text-red', currentPath === link.href ? 'text-red' : 'text-secondary']
            ]}
            data-key={link.key}
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- Mobile Menu Button -->
      <button 
        class="lg:hidden pcc-mobile-menu-btn p-2 rounded-md hover:bg-gray-100 transition-colors"
        aria-label="Abrir menú"
        aria-expanded="false"
      >
        <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path class="menu-icon-open" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          <path class="menu-icon-close hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div class="pcc-mobile-menu hidden lg:hidden border-t border-gray-200">
    <div class="container mx-auto px-4 py-4">
      <!-- Operación Sonrisa Logo - Mobile -->
   
      
      <!-- Navigation Links - Mobile -->
      <nav class="flex flex-col gap-3">
        {navLinks.map((link) => (
          <a 
            href={link.href}
            class:list={[
              'pcc-nav-link-mobile text-base font-medium py-2 transition-colors hover:text-primary',
              currentPath === link.href ? 'text-primary' : 'text-gray-700'
            ]}
            data-key={link.key}
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>
  </div>
</nav>

<script>
  // Script para manejar el menú móvil de la navegación de Productos con Causa
  document.addEventListener('astro:page-load', () => {
    const mobileMenuBtn = document.querySelector('.pcc-mobile-menu-btn');
    const mobileMenu = document.querySelector('.pcc-mobile-menu');
    
    if (!mobileMenuBtn || !mobileMenu) return;

    // Toggle del menú móvil
    mobileMenuBtn.addEventListener('click', () => {
      const isExpanded = mobileMenuBtn.getAttribute('aria-expanded') === 'true';
      
      mobileMenuBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu.classList.toggle('active');
      mobileMenu.classList.toggle('hidden');
      
      // Prevenir scroll cuando el menú está abierto
      if (!isExpanded) {
        document.body.style.overflow = 'hidden';
      } else {
        document.body.style.overflow = '';
      }
    });

    // Cerrar menú al hacer clic en un enlace
    const mobileLinks = mobileMenu.querySelectorAll('.pcc-nav-link-mobile');
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenuBtn.setAttribute('aria-expanded', 'false');
        mobileMenu.classList.remove('active');
        mobileMenu.classList.add('hidden');
        document.body.style.overflow = '';
      });
    });

    // Cerrar menú al cambiar el tamaño de la ventana a desktop
    let resizeTimer: number | undefined;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        if (window.innerWidth >= 1024) {
          mobileMenuBtn.setAttribute('aria-expanded', 'false');
          mobileMenu.classList.remove('active');
          mobileMenu.classList.add('hidden');
          document.body.style.overflow = '';
        }
      }, 250);
    });

    // GT: marca en rojo el enlace de la sección visible (en el diseño "Inicio" va en rojo)
    const spyNav = document.querySelector<HTMLElement>('.pcc-navigation[data-spy]');
    if (spyNav) {
      const spyLinks = Array.from(spyNav.querySelectorAll<HTMLAnchorElement>('.pcc-nav-link'));
      const byId = new Map<string, HTMLAnchorElement>();
      spyLinks.forEach(link => {
        const hash = link.getAttribute('href')?.split('#')[1];
        if (hash) byId.set(hash, link);
      });
      const setActive = (id: string) => {
        spyLinks.forEach(link => link.classList.toggle('is-active', byId.get(id) === link));
      };
      const spy = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) setActive(entry.target.id);
        });
      }, { rootMargin: '-45% 0px -50% 0px' });
      byId.forEach((_, id) => {
        const section = document.getElementById(id);
        if (section) spy.observe(section);
      });
    }

    // Smooth scroll para anclas
    const allLinks = document.querySelectorAll('.pcc-nav-link, .pcc-nav-link-mobile');
    allLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        const href = link.getAttribute('href');
        if (href && href.includes('#')) {
          const [path, hash] = href.split('#');
          const currentPath = window.location.pathname.replace(/\/$/, '');
          
          // Si estamos en la misma página, hacer smooth scroll
          if (path === currentPath) {
            e.preventDefault();
            const target = document.getElementById(hash);
            if (target) {
              const navHeight = document.querySelector('.pcc-navigation')?.clientHeight || 64;
              const targetPosition = target.getBoundingClientRect().top + window.pageYOffset - navHeight - 20;
              window.scrollTo({
                top: targetPosition,
                behavior: 'smooth'
              });
            }
          }
        }
      });
    });
  });
</script>

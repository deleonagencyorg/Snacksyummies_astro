---
import Layout from '../../layouts/ProductosConCausaLayout.astro';
import LazyImage from '../../components/common/LazyImage.astro';
import { ViewTransitions } from 'astro:transitions';
import '../../styles/title-letters.css';
---

<!-- Google Fonts - Digital Counter Font -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;900&display=swap" rel="stylesheet">
<Layout 
  title="Productos con Causa Yummi Pops | Operación Sonrisa Honduras" 
  description="Descubre la alianza de Yummi Pops y Operación Sonrisa Honduras: productos con causa que financian cirugías, clínicas y miles de sonrisas transformadas.">
  <ViewTransitions slot="head" />
  <main class="container mx-auto ">
    <article class="w-full">
       <LazyImage id="inicio" src="https://snack.yummiespromociones.com/SnacksyummiesAssets/portadahomemini.webp" alt="Operación Sonrisas Honduras" width={400} height={300} class="w-full" />
      
        <section id="sobre-la-causa" class="container sm:flex-col md:flex-row  items-center justify-center text-center p-8 lg:p-0 my-8 grid-rows-1 grid-cols-2 justify-items-center gap-x-12 sm:flex overflow-x-clip">
          <div class="sm:w-full md:w-1/2 ">
            <p class="reveal reveal-left text-red font-title text-2xl md:text-4xl text-left">Cada vez que disfrutas tus Yummi Pops favoritos, estás contribuyendo a cambiar vidas.</p>

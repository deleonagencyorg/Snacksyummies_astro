<style>
  /* ---------- Header HN ----------
     Medidas de YPOPS-CAUSA_WEB-LAYOUT-HN.ai (mesa de 1920px; el header arranca bajo el nav de 127px).
     X = (x_diseño - --x0) * --u. Desktop muestra todo el ancho; mobile recorta los lados para que los productos se lean. */
  /* ---------- Base de medidas ---------- */
  .hn-page {
    container-type: inline-size;
    max-width: 1024px;
    margin-inline: auto;
    overflow-x: clip;
    --u: calc(100cqw / 1920);
    --hn-blue: #004e9d;
    --hn-blue-title: #0051a4;
    --hn-sky: #00b2f1;
    --hn-red: #e3032e;
  }

  /* El diseño no aplica kerning; tracking +20 (0.02em) en los bloques de texto que lo llevan */
  .hn-intro,
  .hn-conoce,
  .hn-productos,
  .hn-sumate {
    font-kerning: none;
  }

  .hn-intro__title,
  .hn-intro__body,
  .hn-conoce__text,
  .hn-product__name,
  .hn-productos__box-title,
  .hn-productos__box-text {
    letter-spacing: 0.02em;
  }

  .hn-smile {
    display: block;
    fill: var(--hn-red);
    height: auto;
  }

  .hn-hero {
    --x0: 300;
    --u: calc(100cqw / 1320);
    position: relative;
    width: 100%;
    height: calc(1533 * var(--u));
    overflow: hidden;
    container-type: inline-size;
    background: #fff;
  }

  @media (min-width: 640px) {
    .hn-hero {
      --x0: 0;
      --u: calc(100cqw / 1920);
    }
  }

  /* img, o el canvas que lo reemplaza ya reducido (ver script) */
  .hn-hero > :is(img, canvas) {
    position: absolute;
    max-width: none;
    height: auto;
  }

  .hn-hero__bg {
    left: calc((0 - var(--x0)) * var(--u));
    top: 0;
    width: calc(1920 * var(--u));
  }

  /* Listón "Sumando sonrisas": capa más ancha que la mesa, se sale por la izquierda */
  .hn-hero__ribbon {
    left: calc((-200 - var(--x0)) * var(--u));
    top: calc(121 * var(--u));
    width: calc(2784 * var(--u));
    z-index: 1;
    clip-path: inset(0 100% 0 0);
  }

  .hn-hero__years {
    position: absolute;
    left: calc((424 - var(--x0)) * var(--u));
    top: calc(133 * var(--u));
    width: calc(1056 * var(--u));
    z-index: 2;
    will-change: transform;
  }

  /* Capa propia desde el inicio: la imagen ya está rasterizada cuando arranca la animación */
  .hn-hero__years-img {
    display: block;
    width: 100%;
    max-width: none;
    height: auto;
    opacity: 0;
    transform: scale(0.6) rotate(-6deg);
    transform-origin: 50% 45%;
    will-change: transform, opacity;
  }

  .hn-hero__product {
    opacity: 0;
    transform: translateY(calc(160 * var(--u))) scale(0.85);
    filter: drop-shadow(0 calc(18 * var(--u)) calc(14 * var(--u)) rgba(0, 0, 0, 0.3));
  }

  .hn-hero__product--1 { left: calc((376 - var(--x0)) * var(--u)); top: calc(1041 * var(--u)); width: calc(292 * var(--u)); z-index: 3; }
  .hn-hero__product--2 { left: calc((648 - var(--x0)) * var(--u)); top: calc(1009 * var(--u)); width: calc(320 * var(--u)); z-index: 4; }
  .hn-hero__product--3 { left: calc((936 - var(--x0)) * var(--u)); top: calc(989 * var(--u)); width: calc(340 * var(--u)); z-index: 6; }
  .hn-hero__product--4 { left: calc((1252 - var(--x0)) * var(--u)); top: calc(1041 * var(--u)); width: calc(292 * var(--u)); z-index: 5; }

  /* 1) el listón se llena de izquierda a derecha */
  .hn-hero.visible .hn-hero__ribbon {
    animation: hnRibbonFill 1.6s 0.2s forwards;
  }

  /* El listón sobresale ~7% a la izquierda y ~24% a la derecha de la mesa:
     el tramo visible ocupa la mayor parte del tiempo y el final fuera de pantalla es rápido */
  @keyframes hnRibbonFill {
    0% { clip-path: inset(0 93% 0 0); animation-timing-function: cubic-bezier(0.45, 0, 0.35, 1); }
    85% { clip-path: inset(0 23% 0 0); animation-timing-function: linear; }
    100% { clip-path: inset(0 0 0 0); }
  }

  /* 2) los productos suben con rebote y quedan flotando */
  .hn-hero.visible .hn-hero__product {
    animation: hnProductIn 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) forwards,
      hnFloat 5s ease-in-out infinite;
  }

  .hn-hero.visible .hn-hero__product--1 { animation-delay: 1s, 1.9s; }
  .hn-hero.visible .hn-hero__product--2 { animation-delay: 1.15s, 2.5s; }
  .hn-hero.visible .hn-hero__product--3 { animation-delay: 1.3s, 2.2s; }
  .hn-hero.visible .hn-hero__product--4 { animation-delay: 1.45s, 2.8s; }

  @keyframes hnProductIn {
    0% { opacity: 0; transform: translateY(calc(160 * var(--u))) scale(0.85); }
    50% { opacity: 1; }
    100% { opacity: 1; transform: none; }
  }

  @keyframes hnFloat {
    0%, 100% { opacity: 1; transform: translateY(0); }
    50% { opacity: 1; transform: translateY(calc(-12 * var(--u))); }
  }

  /* 3) al final aparece el 10 años y queda flotando */
  /* Entrada con rebote suave (escala + giro) y, ya casi asentado, el flotado del contenedor se suma sin cortes */
  .hn-hero.visible .hn-hero__years-img {
    animation: hnYearsIn 1.4s linear 1.9s both;
  }

  .hn-hero.visible .hn-hero__years {
    animation: hnYearsFloat 4s ease-in-out 2.8s infinite;
  }

  /*
   * La curva se define por tramo (CSS la aplica a cada intervalo entre keyframes):
   * sale rápido y frena en el rebote; los vaivenes van con ease-in-out para no "reiniciar" la velocidad.
   */
  @keyframes hnYearsIn {
    0% { opacity: 0; transform: scale(0.6) rotate(-6deg); animation-timing-function: cubic-bezier(0.33, 1, 0.68, 1); }
    30% { opacity: 1; }
    58% { transform: scale(1.04) rotate(1.2deg); animation-timing-function: cubic-bezier(0.45, 0, 0.55, 1); }
    80% { transform: scale(0.99) rotate(-0.4deg); animation-timing-function: cubic-bezier(0.45, 0, 0.55, 1); }
    100% { opacity: 1; transform: none; }
  }

  @keyframes hnYearsFloat {
    0%, 100% { transform: translateY(0) rotate(0); }
    50% { transform: translateY(calc(-18 * var(--u))) rotate(-1deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hn-hero .hn-hero__ribbon,
    .hn-hero .hn-hero__years,
    .hn-hero .hn-hero__years-img,
    .hn-hero .hn-hero__product,
    .hn-hero.visible .hn-hero__ribbon,
    .hn-hero.visible .hn-hero__years,
    .hn-hero.visible .hn-hero__years-img,
    .hn-hero.visible .hn-hero__product {
      animation: none;
      opacity: 1;
      transform: none;
      clip-path: none;
    }
  }

  /* ---------- ¡Celebramos 10 años…! ---------- */
  .hn-intro {
    padding: 1.5rem 1.5rem 0;
  }

  .hn-intro__title {
    color: var(--hn-red);
    font-size: 1.75rem;
    line-height: 1.11;
  }

  .hn-intro__body {
    color: var(--hn-blue);
    font-size: 1.375rem;
    line-height: 1.5;
    margin-top: 0.4em;
  }

  .hn-intro__body p + p {
    margin-top: 1em;
  }

  /*
   * Caja de los dos gif (750x750 con margen transparente). En el diseño:
   * niño a 635.3px en (1025.7, 11.2) y niña a 642.7px en (1333.6, 3.2) desde el inicio de la sección.
   */
  .hn-kids {
    position: relative;
    width: min(100%, 26rem);
    aspect-ratio: 950.6 / 643.3;
    margin: 1.5rem auto 0;
  }

  .hn-kids img {
    position: absolute;
    max-width: none;
    height: auto;
  }

  .hn-kids__boy { left: 0; top: 1.24%; width: 66.83%; z-index: 1; }
  .hn-kids__girl { left: 32.39%; top: 0; width: 67.61%; z-index: 1; }

  /* Sombra en el piso bajo cada personaje (el gif no la trae): niño x 1195–1494, niña x 1500–1802 */
  .hn-kids::before,
  .hn-kids::after,
  .hn-sumate__kid::before {
    content: '';
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(0, 0, 0, 0.32), rgba(0, 0, 0, 0.12) 55%, transparent);
    pointer-events: none;
  }

  .hn-kids::before { left: 17.81%; top: 92.93%; width: 31.45%; height: 4.04%; }
  .hn-kids::after { left: 49.9%; top: 92.93%; width: 31.77%; height: 4.04%; }

  @media (min-width: 768px) {
    .hn-intro {
      position: relative;
      height: calc(651 * var(--u));
      padding: calc(86.5 * var(--u)) 0 0 calc(126 * var(--u));
    }

    .hn-intro__text {
      position: relative;
      z-index: 1;
    }

    .hn-intro__title {
      font-size: calc(54 * var(--u));
      line-height: calc(67.2 * var(--u));
    }

    .hn-intro__body {
      font-size: calc(53.9 * var(--u));
      line-height: calc(67.1 * var(--u));
      margin-top: 0;
    }

    .hn-intro__body p + p {
      margin-top: calc(67.1 * var(--u));
    }

    .hn-kids {
      position: absolute;
      left: calc(1025.7 * var(--u));
      top: calc(3.2 * var(--u));
      width: calc(950.6 * var(--u));
      margin: 0;
    }
  }

  /* ---------- Contador ---------- */
  .hn-counter {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    padding: 2rem 1rem;
    text-align: center;
  }

  .hn-counter__lead {
    color: var(--hn-blue);
    font-size: 1.875rem;
    line-height: 0.92;
  }

  .hn-counter__generated {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-size: 2.5rem;
    line-height: 0.91;
  }

  .hn-counter__sonrisas { color: var(--hn-red); }
  .hn-counter__generadas { color: var(--hn-blue); }

  /* En el diseño la sonrisa mide 2.9 veces el tamaño de la letra */
  .hn-counter__smile {
    width: 2.9em;
    margin-top: 0.07em;
  }

  /*
   * Caja del contador: cara #f6f4f2 de 678x270 con radio 38 (diseño), borde fino y sombra suave.
   * Medidas en em (font-size = tamaño de las cifras): las cifras miden ~0.59em de alto.
   */
  .counter-display {
    display: inline-flex;
    justify-content: center;
    font-size: clamp(4.5rem, 20vw, 7rem);
    padding: 0.225em 0.275em;
    border-radius: 0.146em;
    background: #f6f4f2;
    box-shadow:
      0 0 0 1px #dcdad8,
      0 0.012em 0.035em rgba(0, 0, 0, 0.18);
  }

  /* line-height = altura de las cifras; el top compensa las métricas de la fuente para centrarlas */
  .counter-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 0.59em;
    position: relative;
    top: 0.085em;
  }

  .counter-digit,
  .counter-separator {
    font-family: 'TroisMille Bold 15', var(--font-title);
    font-weight: 700;
    color: var(--hn-blue);
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 768px) {
    .hn-counter {
      flex-direction: row;
      justify-content: flex-start;
      gap: 0;
      padding: calc(62 * var(--u)) 0 calc(150 * var(--u)) calc(132 * var(--u));
    }

    .hn-counter__lead {
      width: calc(393 * var(--u));
      white-space: nowrap;
      font-size: calc(69.74 * var(--u));
      line-height: calc(63.7 * var(--u));
    }

    .counter-display {
      font-size: calc(260.3 * var(--u));
      width: calc(678 * var(--u));
      height: calc(270 * var(--u));
      padding: 0;
      align-items: center;
      margin-left: calc(97 * var(--u));
    }

    .hn-counter__generated {
      width: calc(401 * var(--u));
      margin-left: calc(92 * var(--u));
      margin-top: calc(28 * var(--u));
      font-size: calc(87.52 * var(--u));
      line-height: calc(79.5 * var(--u));
    }

    .hn-counter__smile {
      width: calc(254.5 * var(--u));
      margin-top: calc(6 * var(--u));
      position: relative;
      top: calc(-15 * var(--u));
    }
  }

  /* ---------- Conoce más sobre la causa ---------- */
  .hn-conoce {
    position: relative;
    overflow: hidden;
    background: var(--hn-blue);
    color: #fff;
    border-radius: 1.5rem 1.5rem 0 0;

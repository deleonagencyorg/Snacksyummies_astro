<script is:inline>
  function isYouTube(url) {
    if (!url) return false;
    return /youtu\.be|youtube\.com/.test(url);
  }

  function getYouTubeId(url) {
    if (!url) return '';
    const regExp = /^.*(youtu\.be\/|v\/|u\/\w\/|embed\/|watch\?v=|shorts\/|\&v=)([^#\&\?]*).*/;
    const match = url.match(regExp);
    return (match && match[2].length === 11) ? match[2] : '';
  }

  function isYouTubeShort(url) {
    if (!url) return false;
    return /youtube\.com\/shorts\//.test(url);
  }

  function isMobileViewport() {
    return window.matchMedia('(max-width: 767px)').matches;
  }

  function buildEmbedUrl(videoId) {
    const params = new URLSearchParams({
      autoplay: '1',
      controls: '1',
      playsinline: '1',
      rel: '0',
      modestbranding: '1'
    });

    return 'https://www.youtube.com/embed/' + videoId + '?' + params.toString();
  }

  function setDisplayMode(container, modal, mode) {
    if (modal) modal.dataset.mode = mode;
    if (container) container.dataset.mode = mode;
    if (container) container.style.removeProperty('aspect-ratio');
  }

  window.openVideoModal = function(url) {
    if (!url) return;
    const modal = document.getElementById('video-modal-overlay');
    const container = document.getElementById('video-modal-container');
    const iframe = document.getElementById('video-modal-iframe');
    const videoPlayer = document.getElementById('video-modal-player');
    if (!modal || !container) return;

    const isMobile = isMobileViewport();

    if (isYouTube(url)) {
      const videoId = getYouTubeId(url);
      if (!videoId) return;

      if (videoPlayer) {
        videoPlayer.pause();
        videoPlayer.removeAttribute('src');
        videoPlayer.load();
        videoPlayer.classList.add('hidden');
      }

      if (iframe) {
        const isShort = isYouTubeShort(url);
        const displayMode = isShort ? (isMobile ? 'shorts-mobile' : 'shorts-desktop') : 'default';
        setDisplayMode(container, modal, displayMode);
        iframe.src = buildEmbedUrl(videoId);
        iframe.classList.remove('hidden');
      }
    } else {
      if (iframe) {
        iframe.src = '';
        iframe.classList.add('hidden');
      }

      const defaultMode = isMobile ? 'direct-portrait-mobile' : 'direct-portrait';
      setDisplayMode(container, modal, defaultMode);

      if (videoPlayer) {
        videoPlayer.src = url;
        videoPlayer.classList.remove('hidden');

        videoPlayer.onloadedmetadata = function() {
          const vw = videoPlayer.videoWidth;
          const vh = videoPlayer.videoHeight;
          if (vw && vh) {
            const isPortrait = vh > vw;
            if (isPortrait) {
              const mode = isMobile ? 'direct-portrait-mobile' : 'direct-portrait';
              setDisplayMode(container, modal, mode);
            } else {
              const mode = isMobile ? 'direct-landscape-mobile' : 'direct-landscape';
              setDisplayMode(container, modal, mode);
            }
          }
        };

        videoPlayer.load();
        var playPromise = videoPlayer.play();
        if (playPromise !== undefined) {
          playPromise.catch(function(err) {
            console.warn('Autoplay unmuted blocked, falling back to muted autoplay:', err);
            videoPlayer.muted = true;
            videoPlayer.play();
          });
        }
      }
    }

    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  };

  window.closeVideoModal = function() {
    const modal = document.getElementById('video-modal-overlay');
    const container = document.getElementById('video-modal-container');
    const iframe = document.getElementById('video-modal-iframe');
    const videoPlayer = document.getElementById('video-modal-player');
    if (!modal || !container) return;

    if (iframe) {
      iframe.src = '';
      iframe.classList.add('hidden');
    }

    if (videoPlayer) {
      videoPlayer.pause();
      videoPlayer.removeAttribute('src');
      videoPlayer.load();
      videoPlayer.classList.add('hidden');
    }

    modal.dataset.mode = 'default';
    container.dataset.mode = 'default';
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
  };

  document.addEventListener('click', function(e) {
    const modal = document.getElementById('video-modal-overlay');
    if (e.target === modal) {
      window.closeVideoModal();
    }
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      window.closeVideoModal();
    }
  });
</script>

<div id="video-modal-overlay" data-mode="default" class="video-modal-overlay hidden fixed inset-0 z-[100] items-center justify-center bg-black/80 backdrop-blur-sm">
  <div id="video-modal-container" data-mode="default" class="video-modal-container relative w-full max-w-4xl mx-4 aspect-video bg-black rounded-xl overflow-hidden shadow-2xl flex items-center justify-center">
    <button onclick="window.closeVideoModal()" class="video-modal-close absolute top-3 right-3 z-10 text-white bg-black/50 hover:bg-black/70 rounded-full p-2 transition-colors" aria-label="Close video">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <iframe
      id="video-modal-iframe"
      class="video-modal-iframe hidden w-full h-full"
      frameborder="0"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen"
      allowfullscreen
    ></iframe>
    <video
      id="video-modal-player"
      class="video-modal-player hidden w-full h-full object-cover"
      controls
      playsinline
      preload="auto"
    ></video>
  </div>
</div>

<style>
  .video-modal-iframe {
    border: none;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .video-modal-player {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #video-modal-container[data-mode='direct-portrait'],
  #video-modal-container[data-mode='direct-portrait-mobile'],
  #video-modal-container[data-mode='shorts-desktop'],
  #video-modal-container[data-mode='shorts-mobile'] {
    width: auto;
    height: 85dvh;
    max-height: 85dvh;
    aspect-ratio: 9 / 16;
    max-width: min(90vw, calc(85dvh * 9 / 16));
    border-radius: 1rem;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
  }

  /* Direct Landscape Videos */
  #video-modal-container[data-mode='direct-landscape'],
  #video-modal-container[data-mode='direct-landscape-mobile'] {
    width: min(90vw, calc(85dvh * 16 / 9));
    height: auto;
    max-height: 85dvh;
    aspect-ratio: 16 / 9;
    border-radius: 1rem;
  }

  @media (max-width: 767px) {
    .video-modal-close {
      top: calc(0.5rem + env(safe-area-inset-top, 0px));
      right: calc(0.5rem + env(safe-area-inset-right, 0px));
    }
  }
</style>

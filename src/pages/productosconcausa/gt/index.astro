  .animate-slide-up:nth-of-type(2) { animation-delay: 0.2s; }
  .animate-slide-up:nth-of-type(3) { animation-delay: 0.3s; }
  .animate-slide-up:nth-of-type(4) { animation-delay: 0.4s; }

  /* Scroll suave para toda la página */
  html {
    scroll-behavior: smooth;
  }

  /* Intersection Observer para animaciones al hacer scroll */
  .animate-on-scroll {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }

  .animate-on-scroll.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Animaciones para items individuales */
  .animate-item {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }

  .animate-item.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Delays escalonados para items */
  .animate-item:nth-child(1) { transition-delay: 0.1s; }
  .animate-item:nth-child(2) { transition-delay: 0.2s; }
  .animate-item:nth-child(3) { transition-delay: 0.3s; }
  .animate-item:nth-child(4) { transition-delay: 0.4s; }
  .animate-item:nth-child(5) { transition-delay: 0.5s; }
  .animate-item:nth-child(6) { transition-delay: 0.6s; }

  /* Animaciones de entrada para textos e imágenes (reveal) */
  .reveal {
    opacity: 0;
    transition: opacity 0.8s ease-out, transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform;
  }

  .reveal-left { transform: translateX(-40px); }
  .reveal-up { transform: translateY(30px); }
  .reveal-right { transform: translateX(40px) scale(0.95); }

  .reveal.visible {
    opacity: 1;
    transform: none;
  }

  .reveal-delay-1 { transition-delay: 0.2s; }
  .reveal-delay-2 { transition-delay: 0.4s; }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* Evita que la regla global de span (fonts.css) cambie la tipografía de las cifras */
  .count-up {
    font-family: inherit;
  }
</style>

<script>
  import { initTitleLetters } from '../../../scripts/titleLetters';

  // Intersection Observer para animar elementos al hacer scroll
  document.addEventListener('astro:page-load', () => {
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    // Observar todas las secciones con animación
    const animatedSections = document.querySelectorAll('.animate-slide-up');
    animatedSections.forEach(section => {
      section.classList.add('animate-on-scroll');
      observer.observe(section);
    });

    // Observar items individuales
    const animatedItems = document.querySelectorAll('.animate-item, .reveal, .pcc-hero');
    animatedItems.forEach(item => {
      observer.observe(item);
    });

    const testimonialOverlays = document.querySelectorAll('.testimonial-video-overlay');
    testimonialOverlays.forEach((overlay) => {
      overlay.addEventListener('click', () => {
        const container = overlay.closest('.relative');
        if (!container) return;
        const video = container.querySelector('video');
        if (!video) return;
        video.play();
        video.setAttribute('controls', 'controls');
        overlay.classList.add('hidden');
      });
    });

    // Títulos letra por letra (.title-letters)
    initTitleLetters();

    // Contador animado para las cifras de Indicadores y Donativos
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const counters = document.querySelectorAll<HTMLElement>('.count-up');

    const digitalCounters = document.querySelectorAll<HTMLElement>('.digital-counter');

    const runCount = (target: number, duration: number, render: (value: number) => void) => {
      const start = performance.now();

      const tick = (now: number) => {
        const progress = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3); // easeOutCubic
        render(target * eased);
        if (progress < 1) requestAnimationFrame(tick);
      };

      requestAnimationFrame(tick);
    };

    const animateCounter = (el: HTMLElement) => {
      const target = parseFloat(el.dataset.target || '0');
      const decimals = parseInt(el.dataset.decimals || '0', 10);
      const format = new Intl.NumberFormat('en-US', {
        minimumFractionDigits: decimals,
        maximumFractionDigits: decimals
      });

      runCount(target, 2000, (value) => {
        el.textContent = format.format(value);
      });
    };

    // Contador de la campaña: actualiza cada dígito; los ceros a la izquierda quedan en gris
    const renderDigits = (cells: HTMLElement[], value: number) => {
      const current = String(Math.floor(value));
      const padded = current.padStart(cells.length, '0');
      const firstUsed = cells.length - current.length;
      cells.forEach((cell, i) => {
        cell.textContent = padded[i];
        cell.classList.toggle('is-off', i < firstUsed);
      });
    };

    const animateDigitalCounter = (el: HTMLElement) => {
      const target = parseInt(el.dataset.target || '0', 10);
      const cells = Array.from(el.querySelectorAll<HTMLElement>('.counter-digit'));
      runCount(target, 2500, (value) => renderDigits(cells, value));
    };

    if (!prefersReducedMotion) {
      // Arrancan en 0 para que no se vea la cifra final antes de animar
      counters.forEach(counter => {
        const decimals = parseInt(counter.dataset.decimals || '0', 10);
        counter.textContent = (0).toFixed(decimals);
      });
      digitalCounters.forEach(counter => {
        renderDigits(Array.from(counter.querySelectorAll<HTMLElement>('.counter-digit')), 0);
      });

      const counterObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const target = entry.target as HTMLElement;
            if (target.classList.contains('digital-counter')) {
              animateDigitalCounter(target);
            } else {
              animateCounter(target);
            }
            counterObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.5 });

      counters.forEach(counter => counterObserver.observe(counter));
      digitalCounters.forEach(counter => counterObserver.observe(counter));
    }
  });
</script>

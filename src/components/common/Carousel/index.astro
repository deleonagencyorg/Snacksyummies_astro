---
import CarouselSlide from '../CarouselSlide.astro';
import Skeleton from './Skeleton.astro';
import './styles.css';

export interface Props {
  slides: Array<{
    desktop: string;
    mobile: string;
    alt: string;
    title: string;
    subtitle: string;
    link?: string;
    countries?: string[];
  }>;
  loading?: boolean;
}

const { slides = [], loading = false } = Astro.props;
const slideCount = Array.isArray(slides) ? slides.length : 0;
const showControls = slideCount > 1;
const safeSlides = slideCount > 0
  ? slides
  : [
      {
        desktop: 'https://snack.yummiespromociones.com/SnacksyummiesAssets/placeholder.webp',
        mobile: 'https://snack.yummiespromociones.com/SnacksyummiesAssets/placeholder.webp',
        alt: 'Snacks Yummies',
        title: '',
        subtitle: '',
        link: ''
      }
    ];

// Log de depuración


// Slides restringidos por país
const isGeoSlide = (slide: any) => Array.isArray(slide?.countries) && slide.countries.length > 0;

const firstSlide: any = safeSlides.find((s) => !isGeoSlide(s)) || {};
const firstGlobalIndex = safeSlides.indexOf(firstSlide);

// Log del primer slide


// Opcional: Precargar la primera imagen para mejorar el LCP
const preloadFirstImage = true && firstSlide.mobile && firstSlide.desktop;

---

<!-- Importar Swiper desde CDN para garantizar disponibilidad -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.css" />
<script is:inline src="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.js"></script>

<!-- Cargar scripts del carrusel solo en el cliente -->
<script is:inline define:vars={{ carouselSelector: '.swiper-container.main-carousel' }}>
  // Variable global para almacenar la instancia de Swiper
  window.mainCarouselInstance = window.mainCarouselInstance || null;

  const GEO_SESSION_KEY = 'yummies_carousel_geo_confirmed';

  const geoGetCookie = (name) => {
    const match = document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]*)'));
    return match ? decodeURIComponent(match[1]) : null;
  };

  const geoTemplateCountries = (container) => {
    const set = new Set();
    container.querySelectorAll('template.geo-slide-template').forEach((tpl) => {
      (tpl.getAttribute('data-countries') || '').split(',').forEach((c) => {
        if (c.trim()) set.add(c.trim().toUpperCase());
      });
    });
    return set;
  };

  const geoSyncDecision = (container) => {
    try {
      const forced = new URLSearchParams(window.location.search).get('country');
      if (forced) return { country: forced.toUpperCase() };
    } catch (_) {}

    try {
      const confirmed = sessionStorage.getItem(GEO_SESSION_KEY);
      if (confirmed) return { country: confirmed.toUpperCase() };
    } catch (_) {}

    const cookie = geoGetCookie('yummies_geo_v2') || geoGetCookie('yummies_country_code');
    if (cookie && !geoTemplateCountries(container).has(cookie.toUpperCase())) {
      return { country: cookie.toUpperCase() };
    }
    return { pending: true };
  };

  const geoConfirmCountry = async () => {
    if (!window.__yummiesCarouselGeoPromise) {
      window.__yummiesCarouselGeoPromise = (async () => {
        try {
          const r = await fetch('https://ipapi.co/json/');
          if (r.ok) {
            const d = await r.json();
            if (d && d.country_code) return String(d.country_code).toUpperCase();
          }
        } catch (_) {}
        try {
          const r = await fetch('https://api.country.is/');
          if (r.ok) {
            const d = await r.json();
            if (d && d.country) return String(d.country).toUpperCase();
          }
        } catch (_) {}
        return null;
      })().then((code) => {
        if (code) {
          try { sessionStorage.setItem(GEO_SESSION_KEY, code); } catch (_) {}
        }
        return code;
      });
    }
    return window.__yummiesCarouselGeoPromise;
  };

  // Inserta los slides del país coincide
  const geoInsertSlides = (container, country) => {
    if (!country) return false;
    let inserted = false;
    container.querySelectorAll('template.geo-slide-template').forEach((tpl) => {
      const allowed = (tpl.getAttribute('data-countries') || '')
        .split(',').map((c) => c.trim().toUpperCase()).filter(Boolean);
      if (allowed.includes(country)) {
        tpl.replaceWith(tpl.content.cloneNode(true));
        inserted = true;
      }
    });
    return inserted;
  };
  
  function initMainCarousel() {
    // Destruir instancia previa si existe
    if (window.mainCarouselInstance && typeof window.mainCarouselInstance.destroy === 'function') {
      try {
        window.mainCarouselInstance.destroy(true, true);
        window.mainCarouselInstance = null;
      } catch (e) {
        console.warn('Error al destruir Swiper previo:', e);
      }
    }
    
    // Esperar a que el DOM esté listo y Swiper esté disponible
    const attemptInit = () => {
      if (typeof Swiper === 'undefined') {
        // Swiper aún no está cargado, reintentar
        setTimeout(attemptInit, 100);
        return;
      }
      
      const container = document.querySelector(carouselSelector);
      if (!container) {
        console.warn('Contenedor del carrusel no encontrado');
        return;
      }

      // Slides por país
      let geoPending = false;
      if (container.querySelector('template.geo-slide-template')) {
        const decision = geoSyncDecision(container);
        if (decision.pending) {
          geoPending = true;
        } else {
          geoInsertSlides(container, decision.country);
        }
      }

      const slideCount = container.querySelectorAll('.swiper-wrapper > .swiper-slide').length;
      const showControls = slideCount > 1;
      
      try {
        // Ocultar controles si no son necesarios
        if (!showControls) {
          const nextBtn = container.querySelector('.swiper-button-next');
          const prevBtn = container.querySelector('.swiper-button-prev');
          const pagination = container.querySelector('.swiper-pagination');
          if (nextBtn) nextBtn.style.display = 'none';
          if (prevBtn) prevBtn.style.display = 'none';
          if (pagination) pagination.style.display = 'none';
        } else {
          container.querySelectorAll('.swiper-button-next, .swiper-button-prev, .swiper-pagination')
            .forEach((el) => { el.style.display = ''; });
        }
        
        // Configuración de Swiper
        const swiperConfig = {
          loop: showControls,
          autoplay: showControls ? {
            delay: 5000,
            disableOnInteraction: false,
            pauseOnMouseEnter: false,
          } : false,
          navigation: showControls ? {
            nextEl: `${carouselSelector} .swiper-button-next`,
            prevEl: `${carouselSelector} .swiper-button-prev`,
          } : false,
          pagination: showControls ? {
            el: `${carouselSelector} .swiper-pagination`,
            clickable: true,
          } : false,
          touchRatio: 1.5,
          touchAngle: 45,
          touchMoveStopPropagation: true,
          touchStartPreventDefault: false,
          touchStartForcePreventDefault: false,
          threshold: 5,
          speed: 600,
          preventClicks: false,
          preventClicksPropagation: false,
          observer: true,
          observeParents: true,
          on: {}
        };
        
        // Inicializar Swiper
        window.mainCarouselInstance = new Swiper(carouselSelector, swiperConfig);

        // Confirmar país solo si coincide se inserta el slide y se reinicia el carrusel
        if (geoPending) {
          geoConfirmCountry().then((country) => {
            if (!country || !container.isConnected) return;
            if (!geoTemplateCountries(container).has(country)) return;
            if (window.mainCarouselInstance && typeof window.mainCarouselInstance.destroy === 'function') {
              try { window.mainCarouselInstance.destroy(true, true); } catch (_) {}
              window.mainCarouselInstance = null;
            }
            geoInsertSlides(container, country);
            initMainCarousel();
          });
        }
        
        // Actualizar al cambiar orientación
        const handleOrientationChange = () => {
          setTimeout(() => {
            if (window.mainCarouselInstance && typeof window.mainCarouselInstance.update === 'function') {
              window.mainCarouselInstance.update();
            }
          }, 200);
        };
        
        window.removeEventListener('orientationchange', handleOrientationChange);
        window.addEventListener('orientationchange', handleOrientationChange);
        
      } catch (error) {
        console.error('❌ Error al inicializar Swiper:', error);
      }
    };
    
    // Iniciar con un pequeño delay para asegurar que el DOM esté completamente listo
    setTimeout(attemptInit, 300);
  }
  
  // Inicializar en carga inicial
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMainCarousel);
  } else {
    initMainCarousel();
  }
  
  // Reinicializar en navegaciones de Astro (cambio de idioma)
  document.addEventListener('astro:page-load', initMainCarousel);
  document.addEventListener('astro:after-swap', initMainCarousel);
</script>

{loading ? (
  <Skeleton items={3} />
) : (
  <div class="relative overflow-hidden w-full" transition:animate="fade">
    {preloadFirstImage && (
      <>
        <!-- Precargar la primera imagen para dispositivos móviles -->
        <link rel="preload" href={firstSlide.mobile} as="image" media="(max-width: 767px)">
        <!-- Precargar la primera imagen para escritorio -->
        <link rel="preload" href={firstSlide.desktop} as="image" media="(min-width: 768px)">
      </>
    )}
    
    <!-- Swiper container -->
    <div class="swiper-container main-carousel">
      <div class="swiper-wrapper">
        {safeSlides.map((slide, index) => {
          const slideEl = (
            <CarouselSlide 
              slide={{
                desktop: slide.desktop,
                mobile: slide.mobile,
                alt: slide.alt || 'Snacks Yummies',
                title: slide.title || '',
                subtitle: slide.subtitle || '',
                link: slide.link || ''
              }}
              priority={index === firstGlobalIndex}
            />
          );
          return isGeoSlide(slide) ? (
            <template class="geo-slide-template" data-countries={(slide.countries || []).join(',')}>
              {slideEl}
            </template>
          ) : slideEl;
        })}
      </div>
      
      <!-- Controles de navegación -->
      {showControls && <div class="swiper-button-next"></div>}
      {showControls && <div class="swiper-button-prev"></div>}
      {showControls && <div class="swiper-pagination"></div>}
    </div>
  </div>
)}

---
import './styles.css';
import { logos, generalAssets } from '../../../config/assets';
import SocialMediaIcons from '../../common/SocialMediaIcons/index.astro';

const currentYear = new Date().getFullYear();
const basePath = Astro.url.pathname.startsWith('/gt/productosconcausa') ? '/gt/productosconcausa' : '/productosconcausa';
const currentLang = 'es'; // Productos con causa siempre en español
const isGT = basePath === '/gt/productosconcausa';

// GT: íconos del diseño (cuadros blancos con el logo calado), exportados del vector original.
// El diseño también trae YouTube; se agrega cuando haya URL.

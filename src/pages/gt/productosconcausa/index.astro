        <!-- Título -->
        <!-- Desktop: título a la izquierda y caja de texto a la derecha que sale hasta el borde de la pantalla -->
        <div class="text-left mb-8 md:mb-12 p-8 md:p-0 md:flex md:items-center md:justify-between md:gap-8 md:mr-[calc(50%-50vw)]">
          <div class="md:flex-shrink-0">
            <h2 class="title-letters text-primary font-title font-bold text-4xl md:text-5xl lg:text-6xl mb-2">
              Productos<br/>participantes
            </h2><LazyImage src="https://snack.yummiespromociones.com/SnacksyummiesAssets/sonrisa.webp" alt="Operación Sonrisas Honduras" class="p-4 max-w-32 lg:max-w-64 md:p-0" />
          </div>
          <!-- Colores y tamaños del primer bloque (sobre-la-causa) -->
          <div class="reveal reveal-right hidden md:block md:w-[55%] bg-white border-[3px] border-r-0 border-[#e6e6e6] rounded-l-[clamp(2.5rem,5vw,5.5rem)] py-[clamp(2rem,4vw,4.5rem)] pl-[clamp(2rem,4.5vw,5rem)] pr-8">
            <p class="font-gt-title text-[#e3032e] text-[clamp(1.75rem,2.8vw,3.375rem)] leading-[1.11]">
              ¡Estos son los Yummi Pops<br/>que transforman vidas!
            </p>
            <p class="font-gt-text text-[#004e9d] text-[clamp(1.125rem,1.85vw,2.5rem)] leading-[1.25] mt-[0.4em]">
              <b>Con cada compra apoyas a Operación Sonrisa Guatemala,</b><br/>brindando atención integral a pacientes con labio fisurado y paladar hendido.
            </p>
          </div>
        </div>

        <!-- Grid de Productos: cada bolsa sobre tarjeta gris #f2f2f2 (diseño: 385x427 a 1920px, radio ~45px, bolsa al 66% del ancho) -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8 lg:gap-10">
          <!-- Producto 1: Yummi Pops Nacho Jalapeño Cream -->

        <div class="flex flex-col md:flex-row items-center justify-center gap-6 md:gap-12 lg:gap-16">
          <!-- Texto Izquierdo -->
          <div class="reveal reveal-left text-center md:text-center">
            <p class="text-[#1652a7] font-title font-bold text-lg md:text-2xl lg:text-5xl">
              Llevamos <br/>en esta campaña
            </p>
          </div>

          <!-- Contador Digital -->
          <div class="reveal reveal-up reveal-delay-1 counter-display py-8">
            <div class="counter-wrapper digital-counter" data-target="12334" aria-label="12.334">
              <span class="counter-ghost">88.888</span>
              <span class="counter-digit">1</span>
              <span class="counter-digit">2</span>
              <span class="counter-separator">.</span>
              <span class="counter-digit">3</span>
              <span class="counter-digit">3</span>
              <span class="counter-digit">4</span>
            </div>
          </div>

          <!-- Texto Derecho -->
          <div class="reveal reveal-right reveal-delay-2 text-center md:text-left">
            <LazyImage src="https://snack.yummiespromociones.com/SnacksyummiesAssets/sonrisasgeneradas.webp" alt="Operación Sonrisas Honduras" class="md:w-[80%] w-[90%] p-8 md:p-0" />
          </div>
        </div>
      </section>

        <section class="bg-[#1652a7] container py-8 my-8 sm:flex sm:flex-col rounded-t-2xl md:rounded-t-[5%] overflow-x-clip">

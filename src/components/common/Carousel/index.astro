---
import CarouselSlide from '../CarouselSlide.astro';
import Skeleton from './Skeleton.astro';
import './styles.css';

export interface Props {
  slides: Array<{
    desktop: string;
    mobile: string;
    alt: string;
    title: string;
    subtitle: string;
    link?: string;
    countries?: string[];
  }>;
  loading?: boolean;
}

const { slides = [], loading = false } = Astro.props;
const slideCount = Array.isArray(slides) ? slides.length : 0;
const showControls = slideCount > 1;
const safeSlides = slideCount > 0
  ? slides
  : [
      {
        desktop: 'https://snack.yummiespromociones.com/SnacksyummiesAssets/placeholder.webp',
        mobile: 'https://snack.yummiespromociones.com/SnacksyummiesAssets/placeholder.webp',
        alt: 'Snacks Yummies',
        title: '',
        subtitle: '',
        link: ''
      }
    ];

// Log de depuración


const firstSlide = safeSlides[0] || {};
const firstPublicSlide = safeSlides.find((slide) => !slide.countries?.length);
const preloadFirstImage = Boolean(firstPublicSlide?.mobile && firstPublicSlide?.desktop);
const geoPreloadSlide = firstSlide.countries?.length ? firstSlide : null;

---

<!-- Importar Swiper desde CDN para garantizar disponibilidad -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.css" />
<script is:inline src="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.js"></script>

<!-- Cargar scripts del carrusel solo en el cliente -->
<script is:inline define:vars={{ carouselSelector: '.swiper-container.main-carousel' }}>
  // Variable global para almacenar la instancia de Swiper
  window.mainCarouselInstance = window.mainCarouselInstance || null;
  const geoParkedSlides = new WeakMap();
  const GEO_COOKIE_NAME = 'yummies_geo_v2';
  const GEO_COOKIE_DAYS = 7;

  function getCookie(name) {
    const match = document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]*)'));
    return match ? decodeURIComponent(match[1]) : null;
  }

  function getGeoCookieValue() {
    return getCookie('yummies_geo_v2') || getCookie('yummies_country_code') || null;
  }

  function setCookie(name, value, days) {
    const expires = new Date(Date.now() + days * 864e5).toUTCString();
    document.cookie = name + '=' + encodeURIComponent(value) + '; expires=' + expires + '; path=/; SameSite=Lax';
  }

  function slideIsAllowed(slide, country) {
    const raw = slide.getAttribute('data-countries');
    if (!raw) return true;
    if (!country) return false;
    const allowed = raw.split(',').map((code) => code.trim().toUpperCase()).filter(Boolean);
    return allowed.includes(String(country).toUpperCase());
  }

  // Misma cadena que el resto del sitio: cookie, /api/geo-headers, ipapi.co, api.country.is y respaldo HN.
  async function resolveCountryCode() {
    const cached = getGeoCookieValue();
    if (cached) return cached;

    try {
      const response = await fetch('/api/geo-headers');
      if (response.ok) {
        const data = await response.json();
        if (data.country) {
          setCookie(GEO_COOKIE_NAME, data.country, GEO_COOKIE_DAYS);
          return data.country;
        }
      }
    } catch (_) {}

    try {
      const response = await fetch('https://ipapi.co/json/');
      if (response.ok) {
        const data = await response.json();
        if (data.country_code) {
          setCookie(GEO_COOKIE_NAME, data.country_code, GEO_COOKIE_DAYS);
          return data.country_code;
        }
      }
    } catch (_) {}

    try {
      const response = await fetch('https://api.country.is/');
      if (response.ok) {
        const data = await response.json();
        if (data.country) {
          setCookie(GEO_COOKIE_NAME, data.country, GEO_COOKIE_DAYS);
          return data.country;
        }
      }
    } catch (_) {}

    setCookie(GEO_COOKIE_NAME, 'HN', GEO_COOKIE_DAYS);
    return 'HN';
  }

  function syncSlidesToCountry(country) {
    const wrapper = document.querySelector(`${carouselSelector} .swiper-wrapper`);
    if (!wrapper) return 0;

    wrapper.querySelectorAll(':scope > .swiper-slide-duplicate').forEach((node) => node.remove());

    const parked = geoParkedSlides.get(wrapper) || [];
    parked.sort((a, b) => a.index - b.index);
    parked.forEach(({ el, index }) => {
      if (el.isConnected) return;
      const ref = wrapper.children[index] || null;
      wrapper.insertBefore(el, ref);
    });

    const nextParked = [];
    Array.from(wrapper.children).forEach((node, index) => {
      if (!(node instanceof HTMLElement)) return;
      if (!node.classList.contains('swiper-slide') || node.classList.contains('swiper-slide-duplicate')) return;
      if (slideIsAllowed(node, country)) {
        node.classList.remove('geo-pending');
        return;
      }
      nextParked.push({ el: node, index });
    });
    nextParked.forEach(({ el }) => el.remove());
    geoParkedSlides.set(wrapper, nextParked);

    return wrapper.querySelectorAll(':scope > .swiper-slide:not(.swiper-slide-duplicate)').length;
  }
  
  function initMainCarousel() {
    // Destruir instancia previa si existe
    if (window.mainCarouselInstance && typeof window.mainCarouselInstance.destroy === 'function') {
      try {
        window.mainCarouselInstance.destroy(true, true);
        window.mainCarouselInstance = null;
      } catch (e) {
        console.warn('Error al destruir Swiper previo:', e);
      }
    }
    
    // Esperar a que el DOM esté listo y Swiper esté disponible
    const attemptInit = () => {
      if (typeof Swiper === 'undefined') {
        // Swiper aún no está cargado, reintentar
        setTimeout(attemptInit, 100);
        return;
      }
      
      const container = document.querySelector(carouselSelector);
      if (!container) {
        console.warn('Contenedor del carrusel no encontrado');
        return;
      }

      const country = getGeoCookieValue();
      const visibleCount = syncSlidesToCountry(country);
      const controlsEnabled = visibleCount > 1;

      if (!country && !window.__geoCarouselLookupStarted) {
        window.__geoCarouselLookupStarted = true;
        resolveCountryCode().then(() => initMainCarousel());
      }
      
      try {
        const nextBtn = container.querySelector('.swiper-button-next');
        const prevBtn = container.querySelector('.swiper-button-prev');
        const pagination = container.querySelector('.swiper-pagination');
        [nextBtn, prevBtn, pagination].forEach((control) => {
          if (control) control.style.display = controlsEnabled ? '' : 'none';
        });
        
        // Configuración de Swiper
        const swiperConfig = {
          loop: controlsEnabled,
          autoplay: controlsEnabled ? {
            delay: 5000,
            disableOnInteraction: false,
            pauseOnMouseEnter: false,
          } : false,
          navigation: controlsEnabled ? {
            nextEl: `${carouselSelector} .swiper-button-next`,
            prevEl: `${carouselSelector} .swiper-button-prev`,
          } : false,
          pagination: controlsEnabled ? {
            el: `${carouselSelector} .swiper-pagination`,
            clickable: true,
          } : false,
          touchRatio: 1.5,
          touchAngle: 45,
          touchMoveStopPropagation: true,
          touchStartPreventDefault: false,
          touchStartForcePreventDefault: false,
          threshold: 5,
          speed: 600,
          preventClicks: false,
          preventClicksPropagation: false,
          observer: true,
          observeParents: true,
          on: {}
        };
        
        // Inicializar Swiper
        window.mainCarouselInstance = new Swiper(carouselSelector, swiperConfig);
        
        // Actualizar al cambiar orientación
        const handleOrientationChange = () => {
          setTimeout(() => {
            if (window.mainCarouselInstance && typeof window.mainCarouselInstance.update === 'function') {
              window.mainCarouselInstance.update();
            }
          }, 200);
        };
        
        window.removeEventListener('orientationchange', handleOrientationChange);
        window.addEventListener('orientationchange', handleOrientationChange);
        
      } catch (error) {
        console.error('❌ Error al inicializar Swiper:', error);
      }
    };
    
    // Iniciar con un pequeño delay para asegurar que el DOM esté completamente listo
    setTimeout(attemptInit, 300);
  }
  
  // Inicializar en carga inicial
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMainCarousel);
  } else {
    initMainCarousel();
  }
  
  // Reinicializar en navegaciones de Astro (cambio de idioma)
  document.addEventListener('astro:page-load', initMainCarousel);
  document.addEventListener('astro:after-swap', initMainCarousel);
</script>

{loading ? (
  <Skeleton items={3} />
) : (
  <div class="relative overflow-hidden w-full" transition:animate="fade">
    {preloadFirstImage && firstPublicSlide && (
      <>
        <link rel="preload" href={firstPublicSlide.mobile} as="image" media="(max-width: 767px)">
        <link rel="preload" href={firstPublicSlide.desktop} as="image" media="(min-width: 768px)">
      </>
    )}
    {geoPreloadSlide && (
      <script is:inline define:vars={{ mobile: geoPreloadSlide.mobile, desktop: geoPreloadSlide.desktop, countries: geoPreloadSlide.countries ?? [] }}>
        (function () {
          var match = document.cookie.match(/(?:^|; )yummies_geo_v2=([^;]*)/) || document.cookie.match(/(?:^|; )yummies_country_code=([^;]*)/);
          var country = match ? decodeURIComponent(match[1]).toUpperCase() : '';
          var allowed = (countries || []).map(function (code) { return String(code).toUpperCase(); });
          if (!country || allowed.indexOf(country) === -1) return;
          [{ href: mobile, media: '(max-width: 767px)' }, { href: desktop, media: '(min-width: 768px)' }].forEach(function (item) {
            var link = document.createElement('link');
            link.rel = 'preload';
            link.as = 'image';
            link.href = item.href;
            link.media = item.media;
            document.head.appendChild(link);
          });
        })();
      </script>
    )}
    
    <!-- Swiper container -->
    <div class="swiper-container main-carousel">
      <div class="swiper-wrapper">
        {safeSlides.map((slide, index) => (
          <CarouselSlide 
            slide={{
              desktop: slide.desktop,
              mobile: slide.mobile,
              alt: slide.alt || 'Snacks Yummies',
              title: slide.title || '',
              subtitle: slide.subtitle || '',
              link: slide.link || '',
              countries: slide.countries || []
            }}
            priority={index === 0}
          />
        ))}
      </div>
      
      <!-- Controles de navegación -->
      {showControls && <div class="swiper-button-next"></div>}
      {showControls && <div class="swiper-button-prev"></div>}
      {showControls && <div class="swiper-pagination"></div>}
    </div>
  </div>
)}

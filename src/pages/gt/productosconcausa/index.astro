      <!-- Sección Súmate a esta causa (Azul) -->
      <section class="bg-sky-400 py-12 md:py-16 lg:py-20">
        <div class="container mx-auto px-4">
          <div class="bg-white rounded-3xl md:rounded-[3rem] p-8 md:p-12 lg:p-16 shadow-2xl">
            <div class="flex flex-col md:flex-row items-center justify-between gap-8 md:gap-12">
              <!-- Personaje Izquierdo -->
              <!-- Mismo tamaño que ninomini (192x285); el png GT trae margen, se escala para que el niño ocupe el alto -->
              <div class="flex-shrink-0 relative h-[285px] w-[192px] overflow-hidden">
                <LazyImage 
